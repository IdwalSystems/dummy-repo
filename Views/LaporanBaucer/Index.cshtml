@{
    ViewData["Title"] = "Laporan Daftar Bil";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int year = DateTime.Now.Year;
    DateTime firstDay = new DateTime(year, 1, 1);
    DateTime lastDay = new DateTime(year, 12, 31);
}

<div class="container">
    <form asp-action="PRINT">
        <div class="card box-shadow border-info mb-3">
            <div class="card-header bg-info text-white">
                <h5>Baucer - @ViewData["Title"]</h5>
            </div>

            <div class="card-body">
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="form-group col-sm">

                            <div class="custom-control custom-radio">

                                <input class="custom-control-input" type="radio" name="kodLaporan" id="LPV00101" value="LPV00101" checked>
                                <label class="custom-control-label" for="LPV00101">
                                    Laporan Daftar Bil Tanpa Nota Minta
                                </label>
                            </div>
                            <div class="custom-control custom-radio">

                                <input class="custom-control-input" type="radio" name="kodLaporan" id="LPV00102" value="LPV00102">
                                <label class="custom-control-label" for="LPV00102">
                                    Laporan Daftar Bil Dengan Nota Minta
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <div class="form-group form-row">
                            <label for="Tarikh" class="col-sm-2 col-form-label">Tarikh</label>
                            <div class="col-sm-5">
                                <input type="date" class="form-control form-control-sm" id="tarikhDari" name="tarikhDari" value="@firstDay.ToString("yyyy-MM-dd")">
                            </div>
                            <div class="col-sm-5">
                                <input type="date" class="form-control form-control-sm" id="tarikhHingga" name="tarikhHingga" value="@lastDay.ToString("yyy-MM-dd")">
                            </div>
                        </div>
                        <div class="form-group form-row">
                            <label for="Status" class="col-sm-2 col-form-label">Status</label>
                            <div class="col-sm-5">
                                <select class="form-control form-control-sm input-group-sm" name="status" required>
                                    <option value="0">SEMUA</option>
                                    <option value="1">BELUM POSTING</option>
                                    <option value="2">SUDAH POSTING</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group form-row">
                            <label for="Susunan" class="col-sm-2 col-form-label">Susunan</label>
                            <div class="col-sm-5">
                                <select class="form-control form-control-sm input-group-sm" name="susunan" required>
                                    <option value="0">TARIKH</option>
                                    <option value="1" selected>NO BAUCER</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="form-group text-right">
                    <input type="submit" value="Cetak" formtarget="_blank" class="btn btn-primary" />
                </div>
            </div>
        </div>

    </form>

</div>
