@model MSNK.Models.Modules.PrintModel.Reporting.LPV001PrintModel

@{
    ViewData["Title"] = "Cetakan LPV00101";
    Layout = "~/Views/Shared/_PrintLayout.cshtml";
    CompanyDetails company = new CompanyDetails();

    var bil = 0;
}
<style>

    .topic tr {
        line-height: 0.5rem;
    }

    .center {
        padding: 70px 0;
        border: 3px solid green;
        text-align: center;
    }

    .notbold {
        font-weight: normal
    }

    .breakhere {
        page-break-after: always
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-row-group
    }

    tr {
        page-break-inside: avoid
    }
</style>

<table class="table table-bordered table-sm topic">
    <thead>
        <tr class="bg-light">
            <th class="text-center font-weight-bold" colspan="11">Bil  </th>
        </tr>
        <tr class="bg-light">
            <th class="text-center font-weight-bold" colspan="11">Bil  </th>
        </tr>
        <tr class="bg-light">
            <th class="text-center font-weight-bold" colspan="11">Bil  </th>
        </tr>
        <tr class="bg-secondary">
            <th class="text-center font-weight-bold text-white">BIL  </th>
            <th class="text-center font-weight-bold text-white">TARIKH TERIMA</th>
            <th class="text-center font-weight-bold text-white">TARIKH SAH</th>
            <th class="text-center font-weight-bold text-white">TARIKH KEW</th>
            <th class="text-center font-weight-bold text-white">NAMA PEMBEKAL </th>
            <th class="text-center font-weight-bold text-white">NO NOTA MINTA</th>
            <th class="text-center font-weight-bold text-white">NO INVOIS</th>
            <th class="text-center font-weight-bold text-white">AMAUN RM</th>

            <th class="text-center font-weight-bold text-white">NO PO</th>
            <th class="text-center font-weight-bold text-white">TARIKH BAUCER</th>
            <th class="text-center font-weight-bold text-white">NO BAUCER</th>
            <th class="text-center font-weight-bold text-white">TARIKH SAH BAUCER</th>
            <th class="text-center font-weight-bold text-white">TARIKH CEK</th>
            <th class="text-center font-weight-bold text-white">NO CEK</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.AkPV)
        {
            @foreach (var item1 in item.AkPV2)
            {

                // if data is Batal, change row color to red
                var tabletype = "";
                if (item.FlHapus == 1)
                {
                    tabletype = "table-danger";
                }
                // end

                bil++;
        <tr class="@tabletype" style="line-height:0.8rem; page-break-before:avoid;">

            <td class="text-right" style="border-bottom:none;">@bil</td>
            <td class="text-center" style="border-bottom:none;">@Convert.ToDateTime(item1.AkBelian.AkPO.AkNotaMinta.Tarikh).ToString("dd/MM/yyyy")</td>
            <td class="text-center" style="border-bottom:none;">@Convert.ToDateTime(item1.AkBelian.AkPO.AkNotaMinta.Tarikh).ToString("dd/MM/yyyy")</td>
            <td class="text-center" style="border-bottom:none;">@Convert.ToDateTime(item1.AkBelian.AkPO.AkNotaMinta.TarikhSeksyenKewangan).ToString("dd/MM/yyyy")</td>
            <td class="text-left text-uppercase" style="border-bottom:none;">@item.Nama</td>
            <td class="text-center" style="border-bottom:none;">@item1.AkBelian.AkPO.AkNotaMinta.NoSiri</td>
            <td class="text-center" style="border-bottom:none;">@item1.AkBelian.NoInbois.Substring(3)</td>
            <td class="text-right ">@Convert.ToDecimal(item.Jumlah).ToString("#,##0.00")</td>
            <td class="text-center" style="border-bottom:none;">@item1.AkBelian.AkPO.NoPO.Substring(3)</td>
            <td class="text-center" style="border-bottom:none;">@Convert.ToDateTime(item.Tarikh).ToString("dd/MM/yyyy")</td>
            <td class="text-center" style="border-bottom:none;">@item.NoPV.Substring(3)</td>
            @if (item.TarikhPosting != null)
            {
                <td class="text-center text-uppercase">@Convert.ToDateTime(item.TarikhPosting).ToString("dd/MM/yyyy")</td>
            }
            else
            {
                <td class="text-center">-</td>
            }
            @if (item.TarCekAtauEFT != null)
            {
                <td class="text-center text-uppercase">@Convert.ToDateTime(item.TarCekAtauEFT).ToString("dd/MM/yyyy")</td>
            }
            else
            {
                <td class="text-center">-</td>
            }
            <td class="text-center text-uppercase">@item.JCaraBayar.Perihal</td>
            @if (item.NoCekAtauEFT != null)
            {
                <td class="text-center text-uppercase">@item.NoCekAtauEFT</td>
            }
            else
            {
                <td class="text-center">-</td>
            }



            <td class="text-right ">@Convert.ToDecimal(item1.Amaun).ToString("#,##0.00")</td>
        </tr>
            }

        }
        <tr class="font-weight-bold">
            <td colspan="9" class="table-borderless text-right">JUMLAH RM</td>
            <td class="text-right">@Convert.ToDecimal(Model.JumlahDebit).ToString("#,##0.00")</td>
        </tr>
    </tbody>
</table>

