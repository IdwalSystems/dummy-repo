@model IEnumerable<MSNK.Models.Modules.AbBukuVot>

@{
    ViewData["Title"] = "Buku Vot - Papar";
}
<partial name="_JSDetails" />

<div class="card box-shadow">
    <div class="card-body">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase text-dark mb-0">Buku Vot - Papar</h5>
                <p class="text-info mb-0"> @ViewData["Vot"]</p>
                <span class="ac-ref"><a asp-action="Index" class="text-secondary">Indeks</a> / Papar</span>
            </div>
            <div class="col-4 text-right">
                <a asp-action="Index" class="text-secondary"><i class="fas fa-times fa-2x"></i></a>
            </div>

        </div>
        <hr class="mt-2" />

        <div class="card mb-2">
            <div class="card-body pl-3 pb-2 ">
                <div class="form-actions no-color mb-2">
                    <form asp-action="Details" method="get" class="needs-validation" novalidate>
                        <div class="form-actions no-color ">
                            <input type="hidden" name="id" value="@ViewData["VotId"]" id="votId" />
                            <input type="hidden" name="tahun" value="@ViewData["tahun"]" id="tahun" />
                            <input type="hidden" name="jKWId" value="@ViewData["JKWId"]" id="jKWId" />
                            <input type="hidden" name="jBahagianId" value="@ViewData["JBahagianId"]" id="jBahagianId" />
                            <div class="form-row">
                                <div class="col-md-2">
                                    <div class="input-group input-group-sm ">
                                        <label class="form-control-label">Tarikh:</label>
                                    </div>
                                </div>
                                <div class="col-md-4">

                                    <div class="input-group mb-2 input-group-sm ">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">Dari</span>
                                        </div>
                                        <input class="form-control form-control-sm" type="date" name="searchFrom" value="@ViewData["searchFrom"]" required id="searchFrom" />
                                        <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                    </div>
                                </div>
                                <div class="col-md-4">

                                    <div class="input-group mb-2 input-group-sm ">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">Hingga</span>
                                        </div>
                                        <input class="form-control form-control-sm" type="date" name="searchTo" value="@ViewData["searchTo"]" required id="searchTo" />
                                        <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                                        <button type="submit" class="btn text-info btn-sm" data-toggle="tooltip" data-placement="top" title="Cari"><i class="fas fa-search"></i></button>
                                        <a class="btn text-success btn-sm" onclick="printPDF()" href="" id="printButton" target="_blank"><i class="fas fa-print"></i></a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </form>
                </div>

            </div>
        </div>

        <div class="table-responsive table-sm">
            <table class="table table-bordered table-hover display compact nowrap" width="100%">
                <thead>
                    <tr>
                        <th>
                            Bil
                        </th>
                        <th>
                            Tarikh
                        </th>
                        <th>
                            Kod
                        </th>
                        <th>
                            Penerima
                        </th>
                        <th>
                            No Rujukan
                        </th>
                        <th>
                            Debit RM
                        </th>
                        <th>
                            Kredit RM
                        </th>
                        <th>
                            Tanggungan RM
                        </th>
                        <th>
                            Liabiliti RM
                        </th>
                        <th>
                            Baki RM
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        decimal baki = 0;
                        decimal jumDebit = 0;
                        decimal jumKredit = 0;
                        decimal jumTanggungan = 0;
                        decimal jumLiabiliti = 0;

                    }
                    @foreach (var item in Model)
                    {
                        jumDebit += item.Debit;
                        jumKredit += item.Kredit;
                        jumTanggungan += item.Tanggungan;
                        jumLiabiliti += item.Liabiliti;
                        <tr>
                            <td>
                            </td>
                            <td>
                                @item.Tarikh.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @item.Kod
                            </td>
                            <td class="text-uppercase">
                                @item.Penerima
                            </td>
                            <td class="text-uppercase">
                                @item.Rujukan
                            </td>
                            <td class="text-right">
                                @Convert.ToDecimal(item.Debit).ToString("#,##0.00")
                            </td>
                            <td class="text-right">
                                @Convert.ToDecimal(item.Kredit).ToString("#,##0.00")
                            </td>
                            <td class="text-right">
                                @Convert.ToDecimal(item.Tanggungan).ToString("#,##0.00")
                            </td>
                            <td class="text-right">
                                @Convert.ToDecimal(item.Liabiliti).ToString("#,##0.00")
                            </td>
                            <td class="text-right">
                                @{
                                    baki += item.Kredit - item.Debit - item.Tanggungan; // - item.Liabiliti;
                                }
                                @Convert.ToDecimal(baki).ToString("#,##0.00")
                            </td>
                        </tr>
                    }
                    
                </tbody>
                <tfoot>
                    <tr class="font-weight-bold table-warning">
                        <td colspan="5" class="text-right font-weight-bold">JUMLAH RM</td>
                        <td class="text-right">@Convert.ToDecimal(jumDebit).ToString("#,##0.00")</td>
                        <td class="text-right">@Convert.ToDecimal(jumKredit).ToString("#,##0.00")</td>
                        <td class="text-right">@Convert.ToDecimal(jumTanggungan).ToString("#,##0.00")</td>
                        <td class="text-right">@Convert.ToDecimal(jumLiabiliti).ToString("#,##0.00")</td>
                        <td class="text-right">@Convert.ToDecimal(baki).ToString("#,##0.00")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <hr />
        <div class="form-group">
            <a asp-action="Index">Kembali Ke Indeks</a>
        </div>

    </div>
</div>
