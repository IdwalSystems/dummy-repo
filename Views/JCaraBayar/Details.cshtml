@model MSNK.Models.Modules.JCaraBayar

@{
    ViewData["Title"] = "Papar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h4>Cara Bayar - Papar</h4>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Kod)
        </dt>
        <dd class = "col-sm-10">
            @Model.Kod.ToUpper()
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Perihal)
        </dt>
        <dd class = "col-sm-10">
            @Model.Perihal.ToUpper()
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Ubah</a> |
    <a asp-action="Index">Kembali ke Indeks</a>
</div>
