@model IEnumerable<MSNK.Models.Modules.AkTunaiPanjar>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.KaunterPanjar)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Catatan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JKW)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AkBank)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TarMasuk)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserIdKemaskini)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TarKemaskini)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.KaunterPanjar)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Catatan)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.JKW.Kod)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AkBank.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TarMasuk)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserIdKemaskini)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TarKemaskini)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
