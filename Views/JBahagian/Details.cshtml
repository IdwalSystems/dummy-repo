@model MSNK.Models.Modules.JBahagian

@{
    ViewData["Title"] = "Papar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div>
    <h4>Bahagian - Papar</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Kod)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Kod)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Perihal)
        </dt>
        <dd class = "col-sm-10 text-uppercase">
            @Html.DisplayFor(model => model.Perihal)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.JKWId)
        </dt>
        <dd class = "col-sm-10 text-uppercase">
            @Model.JKW.Kod - @Model.JKW.Perihal
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Ubah</a> |
    <a asp-action="Index">Kembali ke Indeks</a>
</div>
