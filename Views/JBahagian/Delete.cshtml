@model MSNK.Models.Modules.JBahagian

@{
    ViewData["Title"] = "Hapus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h3>Hapus</h3>

<h5 class="text-danger">Anda pasti untuk menghapuskan maklumat berikut?</h5>
<div>
    <h4>Bahagian</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Kod)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Kod)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Perihal)
        </dt>
        <dd class="col-sm-10 text-uppercase">
            @Html.DisplayFor(model => model.Perihal)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.JKWId)
        </dt>
        <dd class="col-sm-10 text-uppercase">
            @Model.JKW.Kod - @Model.JKW.Perihal
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Hapus" class="btn btn-danger btn-sm" /> |
        <a asp-action="Index">Kembali ke Indeks</a>
    </form>
</div>
