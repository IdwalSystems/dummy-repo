@model MSNK.Models.Modules.JProfilKategori

@{
    ViewData["Title"] = "Hapus";
}

<div class="card box-shadow">
    <div class="card-body">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase text-danger mb-0">Profil Kategori - Hapus</h5>
                <span class="ac-ref"><a asp-action="Index" class="text-secondary">Indeks</a> / Hapus</span>
            </div>
            <div class="col-4 text-right">
                <a asp-action="Index" class="text-secondary"><i class="fas fa-times fa-2x"></i></a>
            </div>
    
        </div>
        <hr class="mt-2"/>
        <dl class="row">
             <dt class = "col-sm-2">
                KOD
            </dt>
            <dd class = "col-sm-10 text-uppercase">
                @Model.Kod
            </dd>
            <dt class = "col-sm-2">
                PERIHAL
            </dt>
            <dd class = "col-sm-10 text-uppercase">
                @Model.Perihal
            </dd>
            <dt class = "col-sm-2">
                KADAR GERAN RM
            </dt>
            <dd class = "col-sm-10 text-uppercase">
                 @Convert.ToDecimal(Model.KadarGeran).ToString("#,##0.00")
            </dd>
        </dl>
        
        <hr />
        <div class="form-group">
             <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Hapus" class="btn ac-danger btn-sm" /> 
                <a asp-action="Index" class="btn ac-secondary btn-sm" style="width:auto">Batal</a>
            </form>
            
        </div>
    </div>
</div>