@model MSNK.Models.Modules.JProfilKategori

@{
    ViewData["Title"] = "Papar";
}

<div>
    <h4>Profil Kategori - Papar</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            KOD
        </dt>
        <dd class = "col-sm-10 text-uppercase">
            @Model.Kod
        </dd>
        <dt class = "col-sm-2">
            PERIHAL
        </dt>
        <dd class = "col-sm-10 text-uppercase">
            @Model.Perihal
        </dd>
        <dt class = "col-sm-2">
            KADAR GERAN RM
        </dt>
        <dd class = "col-sm-10 text-uppercase">
             @Convert.ToDecimal(Model.KadarGeran).ToString("#,##0.00")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Ubah</a> |
    <a asp-action="Index">Kembali ke Indeks</a>
</div>
