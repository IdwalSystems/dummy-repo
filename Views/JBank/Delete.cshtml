@model MSNK.Models.Modules.JBank

@{
    ViewData["Title"] = "Hapus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>Hapus</h3>

<h5 class="text-danger">Anda pasti untuk menghapuskan maklumat berikut?</h5>
<div>
    <h5>Nama Bank</h5>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Kod)
        </dt>
        <dd class="col-sm-10 text-uppercase">
            @Html.DisplayFor(model => model.Kod)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nama)
        </dt>
        <dd class="col-sm-10 text-uppercase">
            @Html.DisplayFor(model => model.Nama)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.KodEFT)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.KodEFT)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Hapus" class="btn btn-danger btn-sm" /> |
        <a asp-action="Index">Kembali ke Indeks</a>
    </form>
</div>
