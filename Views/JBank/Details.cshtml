@model MSNK.Models.Modules.JBank

@{
    ViewData["Title"] = "Papar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div>
    <h4>Nama Bank - Papar</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Kod)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Kod)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nama)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nama)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.KodEFT)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.KodEFT)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Ubah</a> |
    <a asp-action="Index">Kembali ke Indeks</a>
