@model IEnumerable<MSNK.Models.Modules.AkTerima>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row mb-2">
    <div class="col-8">
        <h3 class="text-left">Resit Rasmi</h3>
    </div>
    <div class="col-4 text-right">
        <a class="text-right btn btn-success text-white" asp-action="Create">Tambah Baru</a>
    </div>
</div>
        <div class="card mb-2">
            <div class="card-body p-2 ">
                <label class="form-control-plaintext" for="searchselect">Carian : </label>
                <div class="form-actions no-color mb-2">
                    <div class="row">
                        <div class="col-sm-3 mb-2">
                            <select class="custom-select form-control-sm" id="columnSearch">
                                <option value=".kw">KW</option>
                                <option value=".kod">Kod</option>
                                <option selected value=".perihal">Perihal</option>
                            </select>
                        </div>
                        <div class="col-sm-8 mb-2">
                            <input class="form-control form-control-sm" type="text" id="myInput" />
                        </div>
                        <div class="col-sm-1 mb-2">
                            <button class="btn btn-warning btn-sm" id="batalCari"><i class="fa fa-backspace"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>





<div class="table-responsive">
    <table class="table table-bordered table-hover text-nowrap table-sm nowrap " width="100%">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Tahun)
                </th>
                <th>
                    No Rujukan
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Tarikh)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Jumlah)
                </th>

                <th>
                    No KP
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Nama)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Alamat1)
                </th>
                <th>
                    Cetak
                </th>
                <th>
                    Posting
                </th>
                <th>
                    Batal
                </th>
                <th class="action-button"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Tahun)
                    </td>
                    <td>
                        @item.NoRujukan.Substring(3)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Tarikh, "{0:dd/MM/yyyy}")
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Jumlah)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NoKp)
                    </td>
                    <td>
                        @item.Nama.ToUpper()
                    </td>
                    <td>
                        @item.Alamat1.ToUpper()
                    </td>
                    <td>
                        @if (item.FlCetak == 0)
                        {
                            <label class="mb-0">BELUM</label>
                        }
                        else
                        {
                            <label class="mb-0">SUDAH</label>
                        }
                    </td>
                    <td>
                        @if (item.FlPosting == 0)
                        {
                            <label class="mb-0">BELUM</label>
                        }
                        else
                        {
                            <label class="mb-0">SUDAH</label>
                        }
                    </td>
                    <td>
                        @if (item.FlBatal == 0)
                        {
                            <label class="mb-0">TIDAK</label>
                        }
                        else
                        {
                            <label class="mb-0">YA</label>
                        }
                    </td>
                    <td class="action-button">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Ubah/Papar"><i class="fas fa-edit"></i></a>
                        <a asp-action="PrintPdf" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Cetak"><i class="fas fa-print"></i></a>
                        @if (item.FlPosting == 0)
                        {
                            <a asp-action="Posting" asp-route-id="@item.Id" class="btn btn-success btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Kemaskini Lejar">
                                <i class="fas fa-sync"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-action="UnPosting" asp-route-id="@item.Id" class="btn btn-warning btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Batal Kemaskini Lejar">
                                <i class="fas fa-sync"></i>
                            </a>
                        }

                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Hapus"><i class="fas fa-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

