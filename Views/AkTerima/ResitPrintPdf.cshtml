@model MSNK.Models.Modules.PrintModel.ResitPrintModel

@{
    ViewData["Title"] = "Cetakan Resit";
    Layout = "~/Views/Shared/_PrintLayout.cshtml";
}
<style>
    .flexrow {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex !important;
    }

        .flexrow > div {
            -webkit-box-flex: 1;
            -webkit-flex: 1;
            flex: 1;
        }

    .image-container {
        width: 80px;
        height: 80px;
        text-align: center;
    }

        .image-container img {
            height: 100%;
        }

    h1 {
        font-size: 1.5rem;
    }

    h2 {
        font-size: 1.3rem;
    }

    h3 {
        font-size: 1.2rem;
    }

    h4 {
        font-size: 1.1rem;
    }

    h5 {
        font-size: 1rem;
    }

    h6 {
        font-size: 0.8rem;
    }
    p {
        font-size: 0.6rem;
    }

    .topic tr {
        line-height: 0.5rem;
    }
    .center {
        padding: 70px 0;
        border: 3px solid green;
        text-align: center;
    }
    .notbold {
        font-weight: normal
    }

    .max-lines {
        display: block; /* or inline-block */
        text-overflow: ellipsis;
        word-wrap: break-word;
        overflow: hidden;
        max-height: 5.8em;
    }

</style>
@*Asal*@
<div class="row flexrow mb-1 ml-1">
    <div class="col-2 image-container">
        <img src="~/img/MainLogo_Syarikat.png" alt="Logo syarikat" />
    </div>
    <div class="col-8 text-uppercase">
        <h5 class="mb-1"><strong>@Model.CompanyDetail.NamaSyarikat</strong></h5>
        <p class="mb-0"> @Model.CompanyDetail.AlamatSyarikat1</p>
        <p class="mb-0"> @Model.CompanyDetail.AlamatSyarikat2</p>
        <p class="mb-0"> @Model.CompanyDetail.AlamatSyarikat3</p>
    </div>

    <div class="col-2 text-right">


        <h6 class="mb-0"><strong>RESIT RASMI</strong></h6>
        <h6 class="mb-0">NO RESIT:</h6>
        <h6 class="mb-0 ">@Model.AkTerima.NoRujukan.Substring(3)</h6>
        TARIKH: @Html.DisplayFor(x => x.AkTerima.Tarikh, "{0:dd/MM/yyyy}")
        <h6 class="mb-0 text-white">-</h6>
        <h6 class="mb-0"><strong>ASAL</strong></h6>
    </div>
</div>
<hr class="bg-dark"/>
<div class="table-responsive-sm">
    <table class="table table-dark table-sm topic">
        <thead>
            <tr>
                <th class="text-center">MAKLUMAT PEMBAYAR</th>
                <th class="text-center">MAKLUMAT BAYARAN</th>
            </tr>
        </thead>
    </table>
</div>
<div class="row flexrow mb-1">
    <div class="col-6 text-left text-uppercase">
        <h6 class="mb-0">@Model.AkTerima.Nama</h6>
        <h6 class="mb-0">@Model.AkTerima.Alamat1</h6>
        <h6 class="mb-0">@Model.AkTerima.Alamat2</h6>
        <h6 class="mb-0">@Model.AkTerima.Alamat3</h6>
        <h6 class="mb-0">@Model.AkTerima.Poskod, @Model.AkTerima.Bandar, @Model.AkTerima.JNegeri.Perihal</h6>
    </div>

    <div class="col-6">
        <div class="table-responsive-sm">
            <table class="table table-striped table-sm topic">
                <thead>
                    <tr>
                        <th>TUJUAN BAYARAN</th>
                        <th>AMAUN (RM)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.AkTerima.AkTerima1)
                    {
                        <tr>
                            <td>@item.AkCarta.Perihal</td>
                            <td align="right">@Convert.ToDecimal(item.Amaun).ToString("#,##0.00")</td>
                        </tr>
                    }
                    <tr class="bg-light">
                        <td class="text-right">JUMLAH BAYARAN (RM)</td>
                        <td class="text-right">@Convert.ToDecimal(@Model.AkTerima.Jumlah).ToString("#,##0.00")</td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>
</div>

<div class="table-responsive-sm mb-0">
    <table class="table table-bordered table-sm topic pb-2">
        <thead>
            <tr>
                <th class="text-left" style="line-height:0.8rem;">JUMLAH DALAM PERKATAAN</th>
                <th class="text-left" style="line-height:0.8rem;">@Model.JumlahDalamPerkataan</th>
            </tr>
        </thead>
    </table>
</div>
<div class="table-responsive-sm">
    <table class="table table-light table-sm topic">
        <thead>
            <tr>
                <th class="text-center">KAEDAH BAYARAN</th>
                <th class="text-center">KETERANGAN BAYARAN</th>
            </tr>
        </thead>
    </table>
</div>
<div class="row flexrow mb-1">
    <div class="col-6 text-left">
        <div class="table-responsive-sm">
            <table class="table table-striped table-sm topic">
                <tbody>
                    @foreach (var item in Model.AkTerima.AkTerima2)
                    {
                        <tr>
                            <td>@item.JCaraBayar.Perihal : @item.NoCek</td>
                            <td align="right">@Convert.ToDecimal(item.Amaun).ToString("#,##0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

    <div class="col-6 text-left">
        <h6 class="mb-0 text-uppercase max-lines">@Html.DisplayFor(x => x.AkTerima.Sebab)</h6>
    </div>
</div>
<hr class="bg-dark mb-0" />
<p class="mb-1 text-center">Resit ini adalah cetakan komputer, tandatangan tidak diperlukan</p>

<p class="mb-0 text-right">@Model.username : @DateTime.Now</p>
@*Asal End*@
<hr />
