                        TarSlip: txtTarSlip.val()
                    }
                    $.ajax({
                        type: "POST",
                        url: "/AkTerima/InsertUpdateAkTerima2",
                        data: AkTerima2,
                        dataType: "json",
                        success: function (r) {
                            //Clear the TextBoxes.
                            txtCaraBayar.val("").trigger('change');
                            amaun.val("0.00");
                            txtNoCek.val("");
                            txtJenisCek.val("");
                            txtKodBankCek.val("");
                            txtTempatCek.val("");
                            txtNoSlip.val("");
                            txtTarSlip.val("");
                        }
                    });
                    $("#txtCaraBayar option[value=" + txtCaraBayar.val() + "]").prop('disabled', true);
