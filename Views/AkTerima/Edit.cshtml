@model MSNK.Models.Modules.AkTerima

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_JSEdit" />
<h1>Edit</h1>

<h4>AkTerima</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Tahun" class="control-label"></label>
                <input asp-for="Tahun" class="form-control" />
                <span asp-validation-for="Tahun" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JKWId" class="control-label"></label>
                <select class="form-control" asp-for="JKWId">
                    <option value="" hidden>-- Pilih Kumpulan Wang --</option>
                    @foreach (var s in ViewBag.JKW)
                    {
                        <option value="@s.Id">@s.Perihal </option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="NoRujukan" class="control-label"></label>
                <input id="noRujukan" asp-for="NoRujukan" class="form-control" readonly />
                <span asp-validation-for="NoRujukan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tarikh" class="control-label"></label>
                <input asp-for="Tarikh" class="form-control" />
                <span asp-validation-for="Tarikh" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Jumlah" class="control-label"></label>
                <input asp-for="Jumlah" class="form-control" id="jumlahObjek" readonly />
                <span asp-validation-for="Jumlah" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AkBankId" class="control-label"></label>
                <select class="form-control" asp-for="AkBankId">
                    <option value="" hidden>-- Pilih Bank --</option>
                    @foreach (var s in ViewBag.AkBank)
                    {
                        <option value="@s.Id">@s.Kod - @s.JBank.Nama</option>
                    }
                </select>
            </div>
            <div class="form-group" hidden>
                <label asp-for="FlCetak" class="control-label"></label>
                <input asp-for="FlCetak" class="form-control" disabled />
                <span asp-validation-for="FlCetak" class="text-danger"></span>
            </div>
            <div class="form-group" hidden>
                <label asp-for="FlPosting" class="control-label"></label>
                <input asp-for="FlPosting" class="form-control" disabled />
                <span asp-validation-for="FlPosting" class="text-danger"></span>
            </div>
            <div class="form-group" hidden>
                <label asp-for="FlBatal" class="control-label"></label>
                <input asp-for="FlBatal" class="form-control" disabled />
                <span asp-validation-for="FlBatal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="KodPembayar" class="control-label"></label>
                <input asp-for="KodPembayar" class="form-control" />
                <span asp-validation-for="KodPembayar" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NoKp" class="control-label"></label>
                <input asp-for="NoKp" class="form-control" />
                <span asp-validation-for="NoKp" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Nama" class="control-label"></label>
                <input asp-for="Nama" class="form-control" />
                <span asp-validation-for="Nama" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Alamat1" class="control-label"></label>
                <input asp-for="Alamat1" class="form-control" />
                <span asp-validation-for="Alamat1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Alamat2" class="control-label"></label>
                <input asp-for="Alamat2" class="form-control" />
                <span asp-validation-for="Alamat2" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Alamat3" class="control-label"></label>
                <input asp-for="Alamat3" class="form-control" />
                <span asp-validation-for="Alamat3" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Poskod" class="control-label"></label>
                <input asp-for="Poskod" class="form-control" />
                <span asp-validation-for="Poskod" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Bandar" class="control-label"></label>
                <input asp-for="Bandar" class="form-control" />
                <span asp-validation-for="Bandar" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JNegeriId" class="control-label"></label>
                <select class="form-control" asp-for="JNegeriId">
                    <option value="" hidden>-- Pilih Negeri --</option>
                    @foreach (var s in ViewBag.JNegeri)
                    {
                        <option value="@s.Id">@s.Perihal </option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Tel" class="control-label"></label>
                <input asp-for="Tel" class="form-control" />
                <span asp-validation-for="Tel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Emel" class="control-label"></label>
                <input asp-for="Emel" class="form-control" />
                <span asp-validation-for="Emel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Sebab" class="control-label"></label>
                <input asp-for="Sebab" class="form-control" />
                <span asp-validation-for="Sebab" class="text-danger"></span>
            </div>
            <div class="form-group" hidden>
                <label asp-for="UserId" class="control-label"></label>
                <input asp-for="UserId" class="form-control" disabled />
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TarMasuk" class="control-label"></label>
                <input asp-for="TarMasuk" class="form-control" disabled />
                <span asp-validation-for="TarMasuk" class="text-danger"></span>
            </div>
            <div class="form-group" hidden>
                <label asp-for="UserIdKemaskini" class="control-label"></label>
                <input asp-for="UserIdKemaskini" class="form-control" hidden />
                <span asp-validation-for="UserIdKemaskini" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TarKemaskini" class="control-label"></label>
                <input asp-for="TarKemaskini" class="form-control" value="@DateTime.UtcNow.ToString("s")" disabled />
                <span asp-validation-for="TarKemaskini" class="text-danger"></span>
            </div>
            @*table Objek*@
            <h3>Objek</h3>
            <table id="tblObjek" class="table" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th style="width:40%">Kod</th>
                        <th style="width:50%">Amaun</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tbodyObjek">
                    @foreach (var item in ViewBag.AkTerima1)
                    {
                        <tr id="@item.Id">
                            @*<td id="akTerima1Id" hidden>@item.Id</td>*@
                            <td id="akCartaId" hidden>@item.AkCartaId</td>
                            <td>@item.AkCarta.Kod</td>
                            <td class="editable-txt" id="td1Amaun">@item.Amaun</td>
                            <td>
                                <button class="btn btn-primary btn-table-mini" type="button" id="btnUpdate1" data-toggle="modal" data-target="#modalObjek" onclick="Update1(this)">
                                    <i class="fa fa-edit"></i>
                                </button>
                            </td>
                            <td>
                                <button class="btn btn-danger btn-table-mini" type="button" id="btnRemove1" onclick="Remove1(this)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>

                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td id="akCartaId" hidden></td>
                        <td hidden><input id="txtAkTerima1" value="@Model.Id" /></td>
                        <td style="width:40%">
                            <select class="form-control" id="txtKodAkaun">
                                <option value="" hidden>-- Pilih Kod Akaun --</option>
                                @foreach (var s in ViewBag.AkCarta)
                                {
                                    <option value="@s.Id">@s.Kod - @s.Nama </option>
                                }
                            </select>
                        </td>
                        <td style="width:50%"><input class="form-control" type="number" id="txtAmaunObjek" step="0.01"></td>
                        <td><button class="btn btn-success btn-table-mini" type="button" id="btnAdd1"><i class="fas fa-plus"></i></button></td>
                    </tr>
                </tfoot>
            </table>
            @*table Objek end*@
            <br />
            @*table urusniaga*@
            <h3>Urusniaga</h3>
            <table id="tblUrusniaga" class="table" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th>CaraBayar</th>
                        <th>Amaun</th>
                        <th>No Cek</th>
                        <th>Jenis Cek</th>
                        <th>Kod Bank Cek</th>
                        <th>Tempat Cek</th>
                        <th>No Slip</th>
                        <th>Tarikh Slip</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="tbodyUrusniaga">
                    @foreach (var item in ViewBag.AkTerima2)
                    {
                    <tr>
                        @*<td id="@item.Id"hidden>@item.AkTerimaId</td>*@
                        <td id="jCaraBayarId" hidden>@item.JCaraBayarId</td>
                        <td hidden><input id="txtAkTerima2" value="@Model.Id" /></td>
                        <td>@item.JCaraBayar.Kod</td>
                        <td class="editable-txt">@item.Amaun</td>
                        <td class="editable-txt">@item.NoCek</td>
                        <td class="editable-txt">@item.JenisCek</td>
                        <td class="editable-txt">@item.KodBankCek</td>
                        <td class="editable-txt">@item.TempatCek</td>
                        <td class="editable-txt">@item.NoSlip</td>
                        <td>@item.TarSlip.ToString("dd/MM/yyyy")</td>
                        <td>
                            <button class="btn btn-primary btn-table-mini" type="button" id="btnUpdate2" data-toggle="modal" data-target="#modalUrusniaga" onclick="Update2(this)">
                                <i class="fa fa-edit"></i>
                            </button>
                        </td>
                        <td>
                            <button class="btn btn-danger btn-table-mini" type="button" id="btnRemove2" onclick="Remove2(this)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>

                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td hidden><input id="txtAkTerima2" value="@Model.Id" /></td>
                        <td id="jCaraBayarId" hidden></td>
                        <td>
                            <select class="form-control" id="txtCaraBayar">
                                <option value="" hidden>-- Pilih Cara Bayar --</option>
                                @foreach (var s in ViewBag.JCaraBayar)
                                {
                                    <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                }
                            </select>
                        </td>
                        <td><input class="form-control" type="number" id="txtAmaunUrusniaga" step="0.01"></td>
                        <td><input class="form-control" type="text" id="txtNoCek" maxlength="10"></td>
                        <td><input class="form-control" type="text" id="txtJenisCek" maxlength="1"></td>
                        <td><input class="form-control" type="text" id="txtKodBankCek" maxlength="4"></td>
                        <td><input class="form-control" type="text" id="txtTempatCek"></td>
                        <td><input class="form-control" type="text" id="txtNoSlip" maxlength="30"></td>
                        <td><input class="form-control" type="datetime-local" id="txtTarSlip"></td>
                        <td><button class="btn btn-success btn-table-mini" type="button" id="btnAdd2"><i class="fas fa-plus"></i></button></td>
                    </tr>
                </tfoot>
            </table>
            @*table urusniaga end*@
            <br />
            <div class="form-group">
                <input type="submit" value="Simpan" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>


<!-- Modal Objek -->
<div class="modal fade bd-example-modal-lg" id="modalObjek" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Objek</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input id="moId1" hidden />
                    <div class="form-group">
                        <label class="col-form-label">Kod Akaun</label>
                        <select class="form-control" id="moKodAkaun" disabled>
                            <option value="" hidden>-- Pilih Kod Akaun --</option>
                            @foreach (var s in ViewBag.AkCarta)
                            {
                                <option value="@s.Id">@s.Kod - @s.Nama </option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Amaun</label>
                        <input type="number" class="form-control" id="moAmaun1">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-dismiss="modal" onclick="modalUpdate1()">OK</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal Objek End -->

<!-- Modal Urusniaga -->
<div class="modal fade bd-example-modal-lg" id="modalUrusniaga" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Urusniaga</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input id="moId2" hidden />
                    <div class="form-group">
                        <label class="col-form-label">Cara Bayar</label>
                        <select class="form-control" id="moCaraBayar" disabled>
                            <option value="" hidden>-- Pilih Cara Bayar --</option>
                            @foreach (var s in ViewBag.JCaraBayar)
                            {
                                <option value="@s.Id">@s.Kod - @s.Perihal </option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Amaun</label>
                        <input type="number" class="form-control" id="moAmaun2">
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">No Cek</label>
                        <input type="text" class="form-control" id="moNoCek">
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Jenis Cek</label>
                        <input type="text" class="form-control" id="moJenisCek">
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Kod Bank Cek</label>
                        <input type="text" class="form-control" id="moKodBankCek">
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Tempat Cek</label>
                        <input type="text" class="form-control" id="moTempatCek">
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">No Slip</label>
                        <input type="text" class="form-control" id="moNoSlip">
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Tarikh Slip</label>
                        <input type="datetime-local" class="form-control" id="moTarSlip">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-dismiss="modal" onclick="modalUpdate2()">OK</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal Urusniaga End -->

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
