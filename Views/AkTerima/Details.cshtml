@model MSNK.Models.Modules.AkTerima

@{
    ViewData["Title"] = "Papar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="card box-shadow border-dark mb-3">
            <div class="card-header bg-dark text-white">
                <div class="form-row">
                    <div class="col-md-6">
                        <h5 class="text-left">Resit Rasmi - @ViewData["Title"]</h5>
                    </div>
                    <div class="col-md-6">
                        <p class="text-right">No Resit: @Model.NoRujukan.Substring(3)</p>
                    </div>
                </div>
                
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="col-lg-10">
                        <div class="form-row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="Tarikh" class="control-label"></label>
                                    <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.Tarikh)" readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label">Tahun</label>
                                    <input class="form-control form-control-sm" value="@Model.Tahun" readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label">Jenis Kumpulan Wang</label>
                                    <input class="form-control form-control-sm text-uppercase" value="@Model.JKW.Kod - @Model.JKW.Perihal " readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label">Kod Bank</label>
                                    <input class="form-control form-control-sm text-uppercase" value="@Model.AkBank.Kod - @Model.AkBank.JBank.Nama " readonly />
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="control-label">No Kad Pengenalan</label>
                                    <input class="form-control form-control-sm" value="@Model.NoKp" readonly />
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-group">
                                    <label class="control-label">Nama</label>
                                    <input class="form-control form-control-sm text-uppercase" value="@Model.Nama " readonly />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label">Alamat</label>
                            <input class="form-control form-control-sm text-uppercase" value="@Model.Alamat1 " readonly />
                        </div>
                        <div class="form-group">
                            <input class="form-control form-control-sm text-uppercase" value="@Model.Alamat2 " readonly />
                        </div>
                        <div class="form-group">
                            <input class="form-control form-control-sm text-uppercase" value="@Model.Alamat3 " readonly />
                        </div>
                        <div class="form-row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="control-label">Poskod</label>
                                    <input class="form-control form-control-sm" value="@Model.Poskod " readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="control-label">Bandar</label>
                                    <input class="form-control form-control-sm text-uppercase" value="@Model.Bandar " readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="control-label">Negeri</label>
                                    <input class="form-control form-control-sm" value="@Model.JNegeri.Kod - @Model.JNegeri.Perihal" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="control-label">Tel</label>
                                    <input class="form-control form-control-sm" value="@Model.Tel " readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="control-label">Emel</label>
                                    <input class="form-control form-control-sm" value="@Model.Emel " readonly />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label">Sebab</label>
                            <textarea class="form-control form-control-sm text-uppercase" readonly rows="2">@Model.Sebab</textarea>
                        </div>
                    </div>
                    <div class="col-lg-2">

                        <div class="card mb-2">
                            <div class="card-body p-1">
                                <div class="form-group col-sm">
                                    <label asp-for="FlCetak" class="control-label"></label>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlCetak" type="radio" id="FlCetak1" name="FlCetak" class="custom-control-input" value="0" checked>
                                        <label class="custom-control-label" for="FlCetak1">Belum</label>
                                    </div>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlCetak" type="radio" id="FlCetak2" name="FlCetak" class="custom-control-input" value="1">
                                        <label class="custom-control-label" for="FlCetak">Sudah</label>
                                    </div>
                                </div>
                            </div>       
                        </div>
                        <div class="card mb-2">
                            <div class="card-body p-1">
                                <div class="form-group col-sm">
                                    <label asp-for="FlPosting" class="control-label"></label>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlPosting" type="radio" id="FlPosting1" name="FlPosting" class="custom-control-input" value="0" checked>
                                        <label class="custom-control-label" for="FlPosting">Belum</label>
                                    </div>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlPosting" type="radio" id="FlPosting2" name="FlPosting" class="custom-control-input" value="1">
                                        <label class="custom-control-label" for="FlPosting">Sudah</label>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="card mb-2">
                            <div class="card-body p-1">
                                <div class="form-group col-sm">
                                    <label asp-for="FlBatal" class="control-label"></label>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlBatal" type="radio" id="FlBatal1" name="FlBatal1" class="custom-control-input" value="0" checked>
                                        <label class="custom-control-label" for="FlBatal">Belum</label>
                                    </div>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlBatal" type="radio" id="FlBatal1" name="FlBatal" class="custom-control-input" value="1">
                                        <label class="custom-control-label" for="FlBatal">Sudah</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
                
                @*table Objek*@
                <div class="card box-shadow mb-3">
                    <div class="card-header">
                        <h6>Objek</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">

                            <table id="tblObjek" class="table table-sm" cellpadding="0" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th style="width:40%">Kod</th>
                                        <th style="width:50%" class="text-right">Amaun</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyObjek">
                                    @foreach (var item in ViewBag.akTerima1)
                                    {
                                        <tr id="@item.Id">
                                            <td id="akCartaId" hidden>@item.AkCartaId</td>
                                            <td>@item.AkCarta.Kod - @item.AkCarta.Perihal</td>
                                            <td class="text-right" id="td1Amaun">@item.Amaun</td>
                                        </tr>

                                    }
                                </tbody>
                                <tfoot>

                                </tfoot>
                            </table>

                        </div>
                    </div>

                </div>
                @*table Objek end*@

                @*table urusniaga*@
                <div class="card box-shadow mb-3">
                    <div class="card-header">
                        <h6>Urusniaga</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="tblUrusniaga" class="table table-sm" cellpadding="0" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th>Cara Bayar</th>
                                        <th>Amaun</th>
                                        <th>No Cek</th>
                                        <th>Jenis Cek</th>
                                        <th>Kod Bank Cek</th>
                                        <th>Tempat Cek</th>
                                        <th>No Slip</th>
                                        <th>Tarikh Slip</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyUrusniaga">
                                    @foreach (var item in ViewBag.akTerima2)
                                    {
                                    <tr>
                                        <td id="jCaraBayarId" hidden>@item.JCaraBayarId</td>
                                        <td hidden><input id="txtAkTerima2" value="@Model.Id" /></td>
                                        <td>@item.JCaraBayar.Perihal</td>
                                        <td>@item.Amaun</td>
                                        <td>@item.NoCek</td>
                                        @switch (@item.JenisCek)
                                        {
                                            case "1":
                                                <td>Cek Cawangan Ini</td>
                                                break;
                                            case "2":
                                                <td>Cek Tempatan</td>
                                                break;
                                            case "3":
                                                <td>Cek Luar</td>
                                                break;
                                            case "4":
                                                <td>Cek Antarabangsa</td>
                                                break;
                                            default:
                                                <td></td>
                                                break;
                                        }

                                        <td>@item.KodBankCek</td>
                                        <td>@item.TempatCek</td>
                                        <td>@item.NoSlip</td>
                                        @if (@item.TarSlip.ToString("dd/MM/yyyy") == "01/01/0001")
                                        {
                                            <td></td>
                                        }
                                        else
                                        {
                                            <td>@item.TarSlip.ToString("dd/MM/yyyy")</td>
                                        }


                                    </tr>

                                    }
                                </tbody>
                                <tfoot>

                                </tfoot>
                            </table>
                        </div>


                    </div>
                </div>
                @*table urusniaga end*@
            </div>

        </div>
    </div>

</div>

<div>
    @if (Model.FlPosting == 1)
    {
    }
    else
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Ubah</a> 
    }
    <a asp-action="Index">Kembali ke Indeks</a>
</div>
