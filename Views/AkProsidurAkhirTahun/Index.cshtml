@{
    ViewData["Title"] = "Prosidur Akhir Tahun";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="card box-shadow">
        <div class="card-body">
            <div class="row">
                <div class="col-8">
                    <h5 class="text-uppercase text-info mb-0">@ViewData["Title"]</h5>
                    <span class="ac-ref">Indeks</span>
                </div>
                <div class="col-4 text-right">
                </div>

            </div>
            <hr class="mt-2" />
            <ul class="nav nav-tabs">
                <li class="nav-item active"><a class="nav-link active" data-toggle="tab" href="#posting">Jana Prosidur</a></li>
                <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#unposting">Batal Prosidur</a></li>
            </ul>
            <div class="tab-content">
                <div id="posting" class="tab-pane active">
                    <form asp-action="GenerateProcedure" method="post">
                        <div class="card">
                            <div class="card-body">
                                <div class="form-group form-row">
                                    <label for="Tarikh" class="col-sm-2 col-form-label">Tahun</label>
                                    <div class="col-sm-5">
                                        <input type="text" class="form-control form-control-sm" name="tahun" value="@ViewBag.Tahun">
                                    </div>
                                </div>
                                <div class="form-group form-row">
                                    <label for="Status" class="col-sm-2 col-form-label">Kump. Wang</label>
                                    <div class="col-sm-5">
                                        <select class="form-control form-control-sm input-group-sm select2" name="JKWId" required>
                                            @foreach (var item in ViewBag.JKW)
                                            {
                                                <option value="@item.Id">@item.Kod - @item.Perihal</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group form-row">
                                    <label for="Status" class="col-sm-2 col-form-label">Kod Untung/ Rugi Semasa</label>
                                    <div class="col-sm-5">
                                        <select class="form-control form-control-sm input-group-sm select2" name="AkCartaEkuitiId" required>
                                            @foreach (var item in ViewBag.AkCarta)
                                            {
                                                <option value="@item.Id">@item.Kod - @item.Perihal</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="form-group text-right">
                            <input type="submit" value="Jana" class="btn ac-primary" />
                        </div>

                    </form>
                </div>
                <div id="unposting" class="tab-pane fade">
                    <form asp-action="DeleteProcedure" method="post">
                        <div class="card">
                            <div class="card-body">
                                <div class="form-group form-row">
                                    <label for="Tarikh" class="col-sm-2 col-form-label">Tahun</label>
                                    <div class="col-sm-5">
                                        <input type="text" class="form-control form-control-sm" name="tahun" value="@ViewBag.Tahun">
                                    </div>
                                </div>
                                <div class="form-group form-row">
                                    <label for="Status" class="col-sm-2 col-form-label">Kump. Wang</label>
                                    <div class="col-sm-5">
                                        <select class="form-control form-control-sm input-group-sm select2" name="JKWId" required>
                                            @foreach (var item in ViewBag.JKW)
                                            {
                                                <option value="@item.Id">@item.Kod - @item.Perihal</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="form-group text-right">
                            <input type="submit" value="Batal Janaan" class="btn ac-warning" />
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>


</div>