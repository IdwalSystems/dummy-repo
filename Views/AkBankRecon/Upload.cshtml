@model MSNK.Models.Modules.AkBankRecon

@{
    ViewData["Title"] = "Penyesuaian Bank - Muat Naik";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_JSUpload" />
<div class="card box-shadow">
    <div class="card-body">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase text-primary mb-0">@ViewData["Title"]</h5>
                <span class="ac-ref"><a asp-action="Index" class="text-secondary">Indeks</a> / Muat Naik</span>
            </div>
            <div class="col-4 text-right">
                <a asp-action="Index" class="text-secondary"><i class="fas fa-times fa-2x"></i></a>
            </div>

        </div>
        <hr class="mt-2" />
        <form asp-action="Edit" class="needs-validation">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="Id" hidden/>
            <div class="form-row mb-2">
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="Tahun" class="control-label"></label>
                        <input asp-for="Tahun" class="form-control form-control-sm" readonly />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="Bulan" class="control-label"></label>
                        <input asp-for="Bulan" class="form-control form-control-sm" readonly />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">No Akaun</label>
                        <input id="NoAkaun" class="form-control form-control-sm" value="@Model.AkBank.NoAkaun" readonly />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="TarKunci" class="control-label"></label>
                        <input asp-for="TarKunci" class="form-control form-control-sm" readonly />
                    </div>
                </div>
            </div>
            <div class="form-row mb-2">
                <div class="col-md-12">
                    <div class="input-group">
                        <input type="file" class="form-control" id="files" readonly style="
    padding: 10px 10px 40px 10px;" />
                        <div class="input-group-append">
                            <a id="upload" class="btn ac-primary text-white" onclick="Upload()"><span style="position: relative; top: calc(50% - 10px);"><i class="fa fa-upload"></i></span></a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Baki Pembukaan RM</label>
                        <input class="form-control form-control-sm" readonly id="openBalance" value="0.00" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Baki Penutupan RM</label>
                        <input class="form-control form-control-sm" readonly id="closeBalance" value="0.00" />
                    </div>
                </div>
            </div>
            @*table Senarai*@
            <div class="card box-shadow mb-3 mt-2">
                <div class="card-header">
                    <h6>Senarai</h6>
                </div>
                <div class="card-body">
                    <table id="tblSenarai" class="table table-sm nowrap table-hover" cellpadding="0" cellspacing="0">
                        <thead>
                            <tr>
                                <th style="width:10%">Indek</th>
                                <th style="width:10%">No Akaun</th>
                                <th style="width:5%">Tarikh</th>
                                <th style="width:5%">Kod Trans.</th>
                                <th style="width:50%">Perihal</th>
                                <th style="width:20%">Dokumen Asal</th>
                                <th style="width:10%">Debit RM</th>
                                <th style="width:10%">Kredit RM</th>
                                <th style="width:10%">Baki RM</th>
                            </tr>
                        </thead>
                        <tbody id="tbodySenarai">
                        </tbody>
                    </table>
                </div>
            </div>
            @*table Objek end*@


            <hr />
            <div class="form-group">
                <input type="submit" value="Simpan" class="btn ac-primary btn-sm" />
                <a asp-action="Index" class="btn ac-secondary btn-sm" style="width:auto">Batal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
