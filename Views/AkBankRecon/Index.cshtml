@model IEnumerable<MSNK.Models.Modules.AkBankRecon>

@{
    ViewData["Title"] = "Penyata Penyesuaian Bank";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string Year = DateTime.Now.ToString("yyyy");
    string dateNow = DateTime.Now.ToString("yyyy-MM-dd");
    int bil = 0;
}

<partial name="_JSIndex" />
<div class="card box-shadow">
    <div class="card-body">
        <partial name="_TitleIndexPartial" />

        <form asp-action="Index" method="post">

            <div class="card">
                <div class="card-body" >
                    <div class="form-group form-row">
                        <label class="col-sm-2 col-form-label">Bank</label>
                        <div class="col-sm-5">
                            <select class="form-control form-control-sm text-uppercase" name="AkBankId" id="ddlAkBank" value="@ViewBag.AkBankId">
                                @foreach (var s in ViewBag.AkBank)
                                {
                                    <option value="@s.Id">@s.NoAkaun - @s.JBank.Nama </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group form-row " >
                        <label class="col-sm-2 col-form-label">Tahun</label>
                        <div class="col-sm-5">
                            <input type="text" class="form-control form-control-sm" id="tahun" name="Tahun" value="@ViewData["Tahun"]">
                        </div>
                    </div>
                    <div class="form-group form-row">
                        <label class="col-sm-2 col-form-label">Bulan</label>
                        <div class="col-sm-5">
                            <input type="text" class="form-control form-control-sm" id="bulan" name="Bulan" value="@ViewData["Bulan"]">
                        </div>
                    </div>

                </div>
            </div>

            <hr />
            <div>
                <div class="text-center hidden-mobile">
                    <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                        <button class="btn ac-primary" disabled="disabled"><i class="fa fa-eye"></i></button>
                        <button class="btn ac-primary" type="submit"> Papar </button>
                    </div>
                </div>
                <div class="text-center show-mobile">
                    <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                        <button class="btn text-primary" type="submit" data-toggle="tooltip" data-placement="top" title="Papar"><i class="fa fa-eye fa-2x"></i></button>
                    </div>
                </div>
            </div>

        </form>
    </div>
</div>
@if (Model != null)
{
    @if (Model.Count() > 0)
    {
        <div class="card box-shadow">
            <div class="card-body">
                <div class="table-responsive table-sm">
                    <table class="table tableSub table-bordered table-hover display compact nowrap" width="100%">
                        <thead>
                            <tr>
                                <th width="2%">Bil</th>
                                <th width="5%">Tahun</th>
                                <th width="5%">Bulan</th>
                                <th width="5%">No Akaun</th>
                                <th width="5%">Bank</th>
                                <th width="30%">Nama Bank</th>
                                <th width="10%">Baki Penyata RM</th>
                                <th width="5%">Tarikh Kunci</th>
                                <th width="5%"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                bil++;
                                <tr class="text-uppercase ">
                                    <td>@bil</td>
                                    <td>
                                        @item.Tahun
                                    </td>
                                    <td>
                                        @item.Bulan
                                    </td>
                                    <td>
                                        @item.AkBank.NoAkaun
                                    </td>
                                    <td>
                                        @item.AkBank.JBank.Kod
                                    </td>
                                    <td>
                                        @item.AkBank.JBank.Nama
                                    </td>
                                    <td class="text-right">
                                        @Convert.ToDecimal(item.BakiPenyata).ToString("#,##0.00")
                                    </td>
                                    <td>
                                        @item.TarKunci?.ToString("dd/MM/yyyy")
                                    </td>
                                    <td width="5%" class="action-button text-center">
                                        <div class="btn-group" role="group" aria-label="action">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn text-primary btn-sm bg-white" type="button"
                                               data-toggle="tooltip" data-placement="top"
                                               title="Ubah/Papar"><i class="fas fa-edit"></i></a>

                                            @if (item.FlHapus == 0)
                                            {
                                                if (item.AkBankReconPenyataBank.Count() == 0)
                                                {
                                                    <a asp-action="Upload" asp-route-id="@item.Id"
                                                       class="btn text-purple btn-sm bg-white" type="button"
                                                       data-toggle="tooltip" data-placement="top"
                                                       title="Muat Naik Fail"><i class="fas fa-upload"></i></a>
                                                }
                                                else
                                                {
                                                    <a asp-action="PrintPdf" asp-route-id="@item.Id"
                                                       class="btn text-secondary btn-sm bg-white" type="button"
                                                       data-toggle="tooltip" data-placement="top"
                                                       title="Cetak" target="_blank"><i class="fas fa-print"></i></a>
                                                    <a asp-action="BankStatement" asp-route-id="@item.Id"
                                                       class="btn text-secondary btn-sm bg-white" type="button"
                                                       data-toggle="tooltip" data-placement="top"
                                                       title="Penyata Penyesuaian Bank"><i class="fa-solid fa-clipboard-check"></i></a>
                                                }
                                                <a asp-action="Delete" asp-route-id="@item.Id"
                                                   class="btn text-danger btn-sm bg-white" type="button"
                                                   data-toggle="tooltip" data-placement="top"
                                                   title="Hapus"><i class="fas fa-trash"></i></a>
                                            }
                                            else
                                            {
                                                if (User.IsInRole("Supervisor") || User.IsInRole("SuperAdmin"))
                                                {
                                                    <a asp-action="Rollback" asp-route-id="@item.Id" class="btn text-info btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Rollback">
                                                        <i class="fas fa-trash-restore"></i>
                                                    </a>

                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    }
}