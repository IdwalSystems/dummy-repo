@model MSNK.Models.Modules.AkBankRecon

@{
    ViewData["Title"] = "Penyesuaian Bank - Penyata";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_JSBankStatement" />
<style>
    input[name='send-quality'] {
        display: none;
    }
</style>
<div class="card box-shadow">
    <div class="card-body">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase text-primary mb-0">@ViewData["Title"]</h5>
                <span class="ac-ref"><a asp-action="Index" class="text-secondary">Indeks</a> / Muat Naik</span>
            </div>
            <div class="col-4 text-right">
                <a asp-action="Index" class="text-secondary"><i class="fas fa-times fa-2x"></i></a>
            </div>

        </div>
        <hr class="mt-2" />
        <form asp-action="Edit" class="needs-validation">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="Id" hidden />
            <div class="form-row mb-2">
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="Tahun" class="control-label"></label>
                        <input asp-for="Tahun" class="form-control form-control-sm" readonly />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="Bulan" class="control-label"></label>
                        <input asp-for="Bulan" class="form-control form-control-sm" readonly />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">No Akaun</label>
                        <input id="NoAkaun" class="form-control form-control-sm" value="@Model.AkBank.NoAkaun" readonly />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="TarKunci" class="control-label"></label>
                        <input asp-for="TarKunci" class="form-control form-control-sm" readonly />
                    </div>
                </div>
            </div>

            <div class="form-row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Baki Penyata Bank RM</label>
                        <input asp-for="BakiPenyata" class="form-control form-control-sm" readonly id="openBalance" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Baki Penyata Sistem RM</label>
                        <input class="form-control form-control-sm" readonly id="closeBalance" value="0.00" />
                    </div>
                </div>
            </div>

            <!-- Nav tabs -->
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link active" data-toggle="tab" href="#matchBankStatement" id="tabMatch">
                        Padanan Penyata
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#unmatchBankStatement" id="tabUnmatch">
                        Batal Padanan Penyata
                    </a>
                </li>
            </ul>
            @*Tab panes*@
            <div class="tab-content">
                <div id="matchBankStatement" class="tab-pane active">
                    <br>
                    <partial name="_MatchBankStatement" />
                </div>
                <div id="unmatchBankStatement" class="tab-pane fade">
                    <br>
                    <partial name="_UnmatchBankStatement" />
                </div>
            </div>


            <hr />
            <div class="form-group">
                <input type="submit" value="Simpan" class="btn ac-primary btn-sm" />
                <a asp-action="Index" class="btn ac-secondary btn-sm" style="width:auto">Batal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
