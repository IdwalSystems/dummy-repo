@model MSNK.Models.Modules.AkBankRecon

@{
    ViewData["Title"] = "Penyesuaian Bank - Penyata";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_JSBankStatement" />
<style>
    input[name='send-quality'] {
        display: none;
    }
</style>
<div class="card box-shadow mb-2" >
    <div class="card-body">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase text-primary mb-0">@ViewData["Title"]</h5>
                <span class="ac-ref"><a asp-action="Index" class="text-secondary">Indeks</a> / Muat Naik</span>
            </div>
            <div class="col-4 text-right">
                <a asp-action="Index" class="text-secondary"><i class="fas fa-times fa-2x"></i></a>
            </div>

        </div>
        <hr class="mt-2" />
        <form asp-action="Edit" class="needs-validation">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="Id" hidden />
            <div class="form-row mb-2">
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="Tahun" class="control-label"></label>
                        <input asp-for="Tahun" class="form-control form-control-sm" readonly />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="Bulan" class="control-label"></label>
                        <input asp-for="Bulan" class="form-control form-control-sm" readonly />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">No Akaun</label>
                        <input id="NoAkaun" class="form-control form-control-sm" value="@Model.AkBank.NoAkaun" readonly />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="TarKunci" class="control-label"></label>
                        <input asp-for="TarKunci" class="form-control form-control-sm" readonly />
                    </div>
                </div>
            </div>

            @*<div class="form-row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Baki Buku Tunai RM</label>
                        <input class="form-control form-control-sm" readonly id="bakiBukuTunai" value="@ViewBag.BakiBukuTunai" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Baki Penyata Bank RM</label>
                        <input asp-for="BakiPenyata" class="form-control form-control-sm" readonly id="bakiPenyata" />
                    </div>
                </div>

            </div>*@

            <!-- Nav tabs -->
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link active" data-toggle="tab" href="#matchBankStatement" id="tabMatch">
                        Padanan Penyata
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#unmatchBankStatement" id="tabUnmatch">
                        Batal Padanan Penyata
                    </a>
                </li>
            </ul>
            @*Tab panes*@
            <div class="tab-content">
                <div id="matchBankStatement" class="tab-pane active">
                    <br>
                    <partial name="_MatchBankStatement" />
                </div>
                <div id="unmatchBankStatement" class="tab-pane fade">
                    <br>
                    <partial name="_UnmatchBankStatement" />
                </div>
            </div>


            <hr />
            <div class="form-group">
                @*<input type="submit" value="Simpan" class="btn ac-primary btn-sm" />*@
                <a asp-action="Index" class="btn ac-secondary btn-sm" style="width:auto">Batal</a>
            </div>
        </form>
    </div>
</div>

<div class="accordion" id="accordionRingkasan">
    <div class="card">
        <div class="card-header" id="headingRingkasan">
            <h2 class="mb-0">
                <a class="btn btn-block text-left" style="font-size:17px;" data-toggle="collapse" data-target="#collapseRingkasan" aria-expanded="true" aria-controls="collapseRingkasan">
                    <strong>Ringkasan Penyata</strong>
                </a>
            </h2>
        </div>

        <div id="collapseRingkasan" class="collapse show" aria-labelledby="headingRingkasan" data-parent="#accordionRingkasan">
            <div class="card-body">
                <div class="container">
                    <form>
                        <div class="form-row p-2">
                            <div class="col-sm-1">
                            </div>
                            <div class="col-sm-5">
                                <label class="control-label">Baki Di Buku Tunai</label>
                            </div>
                            <div class="col-sm-5">
                                <input class="form-control form-control-sm text-right" readonly id="bakiBukuTunai" value="@ViewBag.BakiBukuTunai" />
                            </div>
                            <div class="col-sm-1">
                            </div>
                        </div>
                        <div class="form-row p-2">
                            <div class="col-sm-1">
                            </div>
                            <div class="col-sm-5">
                                <label class="control-label">(+) Bayaran Belum Jelas Di Penyata Bank</label>
                            </div>
                            <div class="col-sm-5">
                                <input class="form-control form-control-sm text-right" readonly id="bayaranBelumJelasPenyataBank" value="@ViewBag.BayaranBelumJelasPenyataBank" />
                            </div>
                            <div class="col-sm-1">
                            </div>
                        </div>
                        <div class="form-row p-2">
                            <div class="col-sm-1">
                            </div>
                            <div class="col-sm-5">
                                <label class="control-label">(-) Bayaran Di Penyata Bank Belum Diakui Di Buku Tunai</label>
                            </div>
                            <div class="col-sm-5">
                                <input class="form-control form-control-sm text-right" readonly id="bakiPenyata" value="@ViewBag.BayaranBelumAkuiBukuTunai" />
                            </div>
                            <div class="col-sm-1">
                            </div>
                        </div>
                        <div class="form-row p-2">
                            <div class="col-sm-1">
                            </div>
                            <div class="col-sm-5">
                                <label class="control-label">(-) Terimaan Belum Jelas Di Penyata Bank</label>
                            </div>
                            <div class="col-sm-5">
                                <input class="form-control form-control-sm text-right" readonly id="terimaanBelumJelasPenyataBank" value="@ViewBag.TerimaanBelumJelasPenyataBank" />
                            </div>
                            <div class="col-sm-1">
                            </div>
                        </div>
                        <div class="form-row p-2">
                            <div class="col-sm-1">
                            </div>
                            <div class="col-sm-5">
                                <label class="control-label">(-) Terimaan Di Penyata Bank Belum Diakui Di Buku Tunai</label>
                            </div>
                            <div class="col-sm-5">
                                <input class="form-control form-control-sm text-right" readonly id="terimaanBelumAkuiBukuTunai" value="@ViewBag.TerimaanBelumAkuiBukuTunai" />
                            </div>
                            <div class="col-sm-1">
                            </div>
                        </div>
                        <div class="form-row p-2">
                            <div class="col-sm-1">
                            </div>
                            <div class="col-sm-10">
                                <hr />
                            </div>
                            <div class="col-sm-1">
                            </div>
                        </div>
                        <div class="form-row p-2">
                            <div class="col-sm-1">
                            </div>
                            <div class="col-sm-5">
                                <label class="control-label"><strong>Baki SEPATUTNYA Di Penyata Bank</strong></label>
                            </div>
                            <div class="col-sm-5">
                                <input class="form-control form-control-sm text-right" readonly id="bakiSepatutnyaPenyata" value="@ViewBag.BakiSepatutnyaPenyataBank" />
                            </div>
                            <div class="col-sm-1">
                            </div>
                        </div>
                        <div class="form-row p-2">
                            <div class="col-sm-1">
                            </div>
                            <div class="col-sm-5">
                                <label class="control-label"><strong>Baki SEBENAR Di Penyata Bank</strong></label>
                            </div>
                            <div class="col-sm-5">
                                <input class="form-control form-control-sm text-right" id="bakiPenyataBank" readonly value="@ViewBag.BakiPenyataBank" />
                            </div>
                            <div class="col-sm-1">
                            </div>
                        </div>
                        <div class="form-row p-2">
                            <div class="col-sm-1">
                            </div>
                            <div class="col-sm-10">
                                <hr />
                            </div>
                            <div class="col-sm-1">
                            </div>
                        </div>
                        <div class="form-row p-2">
                            <div class="col-sm-1">
                            </div>
                            <div class="col-sm-5">
                                <label class="control-label"><strong>Beza</strong></label>
                            </div>
                            <div class="col-sm-5">
                                <input class="form-control form-control-sm text-right" readonly id="beza" value="@ViewBag.Beza" />
                            </div>
                            <div class="col-sm-1">
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
