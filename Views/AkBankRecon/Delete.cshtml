@model MSNK.Models.Modules.AkBankRecon

@{
    ViewData["Title"] = "Penyesuaian Bank - Hapus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card box-shadow">
    <div class="card-body">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase text-danger mb-0">@ViewData["Title"]</h5>
                <span class="ac-ref"><a asp-action="Index" class="text-secondary">Indeks</a> / Hapus</span>
            </div>
            <div class="col-4 text-right">
                <a asp-action="Index" class="text-secondary"><i class="fas fa-times fa-2x"></i></a>
            </div>

        </div>
        <hr class="mt-2" />
        <p class="text-danger">Anda pasti untuk menghapuskan maklumat berikut?</p>

        <div class="form-row">
            <div class="col-md-1">
                <div class="form-group">
                    <label asp-for="Tahun" class="control-label"></label>
                    <input type="text" asp-for="Tahun" class="form-control form-control-sm" id="txtTahun" readonly />
                </div>
            </div>
            <div class="col-md-1">
                <div class="form-group">
                    <label asp-for="Bulan" class="control-label"></label>
                    <input asp-for="Bulan" class="form-control form-control-sm" id="txtBulan" readonly />
                </div>
            </div>

            <div class="col-md-5">
                <div class="form-group">
                    <label asp-for="AkBankId" class="control-label"></label><span class="text-danger control-label">*</span>
                    <input value="@Model.AkBank.NoAkaun - @Model.AkBank.JBank.Nama" class="form-control form-control-sm" id="txtAkBankId" readonly />
                </div>
            </div>

            <div class="col-md-2">
                <div class="form-group">
                    <label asp-for="TarKunci" class="control-label"></label>
                    <input asp-for="TarKunci" class="form-control form-control-sm form-control-sm-custom" />
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label asp-for="BakiPenyata" class="control-label"></label><span class="text-danger control-label">*</span>
                    <input asp-for="BakiPenyata" class="form-control form-control-sm form-control-sm-custom" type="number" id="txtBakiPenyata" readonly />
                </div>
            </div>
        </div>

        <hr />
        <div class="form-group">
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                @if (!string.IsNullOrEmpty(Model.TarKunci?.ToString("yyyy/MM/dd")) || (Model.AkBankReconPenyataBank.Count > 0))
                {
                }
                else
                {
                    <input type="submit" value="Hapus" class="btn ac-danger btn-sm" />
                }

                <a asp-action="Index" class="btn ac-secondary btn-sm" style="width:auto">Batal</a>
            </form>

        </div>
    </div>
</div>
