@model IEnumerable<MSNK.Models.Modules.AkPembekal>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.KodSykt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NamaSykt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NoPendaftaran)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Alamat1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Alamat2)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Alamat3)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Poskod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bandar)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefon1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Emel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AkaunBank)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JNegeri)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JBank)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.KodSykt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NamaSykt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NoPendaftaran)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Alamat1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Alamat2)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Alamat3)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Poskod)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Bandar)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefon1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Emel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AkaunBank)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.JNegeri.Perihal)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.JBank.Nama)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
