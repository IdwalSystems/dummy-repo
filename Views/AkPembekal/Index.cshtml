@model IEnumerable<MSNK.Models.Modules.AkPembekal>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_JSIndex" />
<style>
    th:last-child, td:last-child {
        position: sticky;
        right: 0px;
        background-color: white;
        border-inline-style: inherit;
    }
</style>
<div class="row mb-2">
    <div class="col-8">
        <h3 class="text-left">Pembekal</h3>
    </div>
    <div class="col-4 text-right">
        <a class="text-right btn btn-success text-white" asp-action="Create">Tambah Baru</a>
    </div>
</div>
<div class="card mb-2">
    <div class="card-body pl-3 pb-2">
        <label class="form-control-plaintext" for="columnSearch">Carian : </label>
        <div class="form-actions no-color mb-2">
            <div class="form-row">
                <div class="col-sm-2 mb-2">
                    <select class="custom-select form-control-sm" id="columnSearch">
                        <option value="" selected>Semua</option>
                        <option value=".namaSykt">Nama Syarikat</option>
                        <option value=".noDaftar">No Pendaftaran</option>
                        <option value=".bandar">Bandar</option>
                        <option value=".negeri">Negeri</option>  
                    </select>
                </div>
                <div class="col-sm-8 mb-2">
                    <input class="form-control form-control-sm" type="text" id="myInput" style="text-transform:uppercase" />
                </div>
                @*<div class="col-sm mb-2">
                    <button class="btn btn-warning btn-sm" id="batalCari" value="Batal Carian"><i class="fas fa-backspace"></i></button>
                </div>*@
            </div>
        </div>
    </div>
</div>
<div class="table-responsive table-sm">
    <table class="table table-bordered table-hover display compact nowrap" width="100%">
        <thead>
            <tr>
                <th align="center" width="5%">Bil</th>
                <th>
                    @Html.DisplayNameFor(model => model.KodSykt)
                </th>
                <th class="namaSykt">
                    @Html.DisplayNameFor(model => model.NamaSykt)
                </th>
                <th class="noDaftar">
                    @Html.DisplayNameFor(model => model.NoPendaftaran)
                </th>
                <th>
                    Alamat
                </th>
                <th class="bandar">
                    @Html.DisplayNameFor(model => model.Bandar)
                </th>
                <th class="negeri">
                    @Html.DisplayNameFor(model => model.JNegeri)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Telefon1)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Emel)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.AkaunBank)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JBank)
                </th>
                <th width="5%"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var tabletype = item.FlHapus == 1 ? "table-danger" : null;
                <tr class="@tabletype">
                    <td align="center"></td>
                    <td>
                        @Html.DisplayFor(modelItem => item.KodSykt)
                    </td>
                    <td class="text-uppercase">
                        @item.NamaSykt
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NoPendaftaran)
                    </td>
                    <td class="text-uppercase">
                        @item.Alamat1
                    </td>
                    <td class="text-uppercase">
                        @item.Bandar
                    </td>
                    <td class="text-uppercase">
                        @Html.DisplayFor(modelItem => item.JNegeri.Perihal)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Telefon1)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Emel)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AkaunBank)
                    </td>
                    <td class="text-uppercase">
                        @Html.DisplayFor(modelItem => item.JBank.Nama)
                    </td>
                    <td width="5%">
                        <a asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-primary btn-sm" type="button"
                           data-toggle="tooltip" data-placement="top"
                           title="Ubah/Papar"><i class="fas fa-edit"></i></a>
                        @if (item.FlHapus == 0)
                        {

                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm" type="button"
                               data-toggle="tooltip" data-placement="top"
                               title="Hapus"><i class="fas fa-trash"></i></a>
                        }
                        else
                        {
                            if (User.IsInRole("Supervisor") || User.IsInRole("SuperAdmin"))
                            {
                                <a asp-action="Rollback" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Rollback">
                                    <i class="fas fa-trash-restore"></i>
                                </a>

                            }
                        }

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

