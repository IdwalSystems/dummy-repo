@*@model PaginatedList<ContosoUniversity.Models.Student>*@
@model PaginatedList<MSNK.Models.Modules.AkPembekal>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

@*datatables setup*@
<script src="//cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
<link href="//cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css" rel="stylesheet" />
<script type="text/javascript">
    //$(document).ready(function () {
    //    $('.table').DataTable({
    //        "scrollX": true
    //    });
    //});
</script>

<p>
    <a asp-action="Create">Create New</a>
</p>
@*@Html.Label((string)ViewBag.kodsykt)*@

<form asp-action="Index" method="get">
    <div class="form-actions no-color">
        <p>
            Carian : <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" />
            <input type="submit" value="Cari" /> |
            <a asp-action="Index">Batal Carian</a>
        </p>
    </div>
</form>

<div class="table-responsive">
    <table class="table hover nowrap text-nowrap" width="100%">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["KodSyktSortParm"]">Kod Sykt</a>
                    @*Kod Sykt*@
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["NamaSyktSortParm"]">Nama Syarikat</a>
                    @*Nama Syarikat*@
                </th>
                <th>
                    No Pendaftaran
                </th>
                <th>
                    Alamat 1
                </th>
                <th>
                    Alamat 2
                </th>
                <th>
                    Alamat 3
                </th>
                <th>
                    Poskod
                </th>
                <th>
                    Bandar
                </th>
                <th>
                    Telefon
                </th>
                <th>
                    Emel
                </th>
                <th>
                    Akaun Bank
                </th>
                <th>
                    Negeri
                </th>
                <th>
                    Bank
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.KodSykt)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NamaSykt)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NoPendaftaran)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Alamat1)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Alamat2)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Alamat3)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Poskod)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Bandar)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Telefon1)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Emel)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AkaunBank)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JNegeri.Perihal)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JBank.Nama)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<a asp-action="Index"
   asp-route-sortOrder="@ViewData["CurrentSort"]"
   asp-route-pageNumber="@(Model.PageIndex - 1)"
   asp-route-currentFilter="@ViewData["CurrentFilter"]"
   class="btn btn-default @prevDisabled">
    Previous
</a>
<a asp-action="Index"
   asp-route-sortOrder="@ViewData["CurrentSort"]"
   asp-route-pageNumber="@(Model.PageIndex + 1)"
   asp-route-currentFilter="@ViewData["CurrentFilter"]"
   class="btn btn-default @nextDisabled">
    Next
</a>
