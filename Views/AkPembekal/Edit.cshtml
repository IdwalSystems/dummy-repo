@model MSNK.Models.Modules.AkPembekal

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>AkPembekal</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="KodSykt" class="control-label"></label>
                <input asp-for="KodSykt" class="form-control" />
                <span asp-validation-for="KodSykt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NamaSykt" class="control-label"></label>
                <input asp-for="NamaSykt" class="form-control" />
                <span asp-validation-for="NamaSykt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NoPendaftaran" class="control-label"></label>
                <input asp-for="NoPendaftaran" class="form-control" />
                <span asp-validation-for="NoPendaftaran" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Alamat1" class="control-label"></label>
                <input asp-for="Alamat1" class="form-control" />
                <span asp-validation-for="Alamat1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Alamat2" class="control-label"></label>
                <input asp-for="Alamat2" class="form-control" />
                <span asp-validation-for="Alamat2" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Alamat3" class="control-label"></label>
                <input asp-for="Alamat3" class="form-control" />
                <span asp-validation-for="Alamat3" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Poskod" class="control-label"></label>
                <input asp-for="Poskod" class="form-control" />
                <span asp-validation-for="Poskod" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Bandar" class="control-label"></label>
                <input asp-for="Bandar" class="form-control" />
                <span asp-validation-for="Bandar" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JNegeriId" class="control-label"></label>
                <select class="form-control" asp-for="JNegeriId">
                    <option value="" hidden>-- Pilih Negeri --</option>
                    @foreach (var s in ViewBag.JNegeri)
                    {
                        <option value="@s.Id">@s.Perihal </option>
                    }
                </select>
                <span asp-validation-for="JNegeriId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Telefon1" class="control-label"></label>
                <input asp-for="Telefon1" class="form-control" />
                <span asp-validation-for="Telefon1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Emel" class="control-label"></label>
                <input asp-for="Emel" class="form-control" />
                <span asp-validation-for="Emel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AkaunBank" class="control-label"></label>
                <input asp-for="AkaunBank" class="form-control" />
                <span asp-validation-for="AkaunBank" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JBankId" class="control-label"></label>
                <select class="form-control" asp-for="JBankId">
                    <option value="" hidden>-- Pilih Bank --</option>
                    @foreach (var s in ViewBag.jbank)
                    {
                        <option value="@s.Id">@s.Kod - @s.Nama </option>
                    }
                </select>
                <span asp-validation-for="JBankId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
