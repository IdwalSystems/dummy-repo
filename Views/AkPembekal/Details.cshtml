@model MSNK.Models.Modules.AkPembekal

@{
    ViewData["Title"] = "Papar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="card box-shadow border-dark mb-3">
            <div class="card-header bg-dark text-white">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="text-left">Pembekal - @ViewData["Title"]</h5>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="form-group col-sm-2">
                        <label asp-for="NoPendaftaran" class="control-label"></label>
                        <input class="form-control form-control-sm" value=" @Model.KodSykt" readonly />
                    </div>
                    <div class="form-group col-sm-2">
                        <label asp-for="NoPendaftaran" class="control-label"></label>
                        <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.NoPendaftaran)" readonly />
                    </div>
                    <div class="form-group col-sm-8">
                        <label asp-for="NamaSykt" class="control-label"></label>
                        <input class="form-control form-control-sm text-uppercase" value="@Html.DisplayFor(model => model.NamaSykt)" readonly />
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Alamat1" class="control-label">Alamat</label>
                    <input class="form-control form-control-sm text-uppercase" value="@Html.DisplayFor(model => model.Alamat1)" readonly />
                </div>
                <div class="form-group">
                    <input class="form-control form-control-sm text-uppercase" value="@Html.DisplayFor(model => model.Alamat2)" readonly />
                </div>
                <div class="form-group">
                    <input class="form-control form-control-sm text-uppercase" value="@Html.DisplayFor(model => model.Alamat3)" readonly />
                </div>

                <div class="form-row">
                    <div class="form-group col-sm">
                        <label asp-for="Poskod" class="control-label"></label>
                        <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.Poskod)" readonly />
                    </div>
                    <div class="form-group col-sm">
                        <label asp-for="Bandar" class="control-label"></label>
                        <input class="form-control form-control-sm text-uppercase" value="@Html.DisplayFor(model => model.Bandar)" readonly />
                    </div>
                    <div class="form-group col-sm">
                        <label asp-for="JNegeri" class="control-label"></label>
                        <input class="form-control form-control-sm"
                               value="@Html.DisplayFor(model => model.JNegeri.Perihal)" readonly />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-sm-4">
                        <label asp-for="Telefon1" class="control-label"></label>
                        <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.Telefon1)" readonly />
                    </div>
                    <div class="form-group col-sm-4">
                        <label asp-for="Emel" class="control-label"></label>
                        <label class="form-control form-control-sm form-control-plaintext">@Html.DisplayFor(model => model.Emel)</label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-sm-4">
                        <label asp-for="AkaunBank" class="control-label"></label>
                        <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.AkaunBank)" readonly />
                    </div>
                    <div class="form-group col-sm-4">
                        <label asp-for="JBank" class="control-label"></label>
                        <input class="form-control form-control-sm"
                               value="@Html.DisplayFor(model => model.JBank.Kod) - @Html.DisplayFor(model => model.JBank.Nama)" readonly />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Ubah</a>
    <a asp-action="Index" class="btn btn-link">Kembali ke Indeks</a>
</div>
