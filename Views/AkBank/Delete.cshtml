@model MSNK.Models.Modules.AkBank

@{
    ViewData["Title"] = "Hapus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>Hapus</h3>

<h5 class="text-danger">Anda pasti untuk menghapuskan maklumat berikut?</h5>
<div>
    <h5>Akaun Bank</h5>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Kod)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Kod)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.NoAkaun)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.NoAkaun)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.JKW)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.JKW.Kod)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.AkCarta)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.AkCarta.Kod)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.JBank)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.JBank.Nama)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Hapus" class="btn btn-danger" /> |
        <a asp-action="Index">Kembali ke Indeks</a>
    </form>
</div>