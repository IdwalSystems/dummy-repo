@model MSNK.Models.Modules.AkBank

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>AkBank</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Kod" class="control-label"></label>
                <input asp-for="Kod" class="form-control" />
                <span asp-validation-for="Kod" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NoAkaun" class="control-label"></label>
                <input asp-for="NoAkaun" class="form-control" />
                <span asp-validation-for="NoAkaun" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Bank" class="control-label"></label>
                <select class="form-control" asp-for="BankId">
                    @foreach (var s in ViewBag.Bank)
                    {
                        <option value="@s.Id">@s.Nama </option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="KW" class="control-label">Kumpulan Wang</label>
                <select class="form-control" asp-for="KWId">
                    @foreach (var s in ViewBag.KW)
                    {
                        <option value="@s.Id">@s.Perihal </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
