@model MSNK.Models.Modules.AkBank

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>AkBank</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Kod" class="control-label"></label>
                <input asp-for="Kod" class="form-control" />
                <span asp-validation-for="Kod" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NoAkaun" class="control-label">No Akaun</label>
                <input asp-for="NoAkaun" class="form-control" />
                <span asp-validation-for="NoAkaun" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JBank" class="control-label"></label>
                <select class="form-control" asp-for="JBankId">
                    @foreach (var s in ViewBag.JBank)
                    {
                        <option value="@s.Id">@s.Nama </option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="JKW" class="control-label">Kumpulan Wang</label>
                <select class="form-control" asp-for="JKWId">
                    @foreach (var s in ViewBag.JKW)
                    {
                        <option value="@s.Id">@s.Perihal </option>
                    }
                </select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
