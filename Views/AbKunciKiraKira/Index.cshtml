@model dynamic;

@{
    ViewData["Title"] = "Kunci Kira-Kira";
    Layout = "~/Views/Shared/_Layout.cshtml";

    decimal asetTetap = 0;
    decimal asetSemasa = 0;
    decimal JumAset = 0;
    decimal liabiliti = 0;
    decimal asetBersih = 0;
    decimal ekuiti = 0;
    string dateTo = "";
    string key = "";

    dateTo = ViewData["DateTo"].ToString();
    string date = dateTo.Substring(8, 2) + "/" + dateTo.Substring(5, 2) + "/" + dateTo.Substring(0, 4);
}

<div class="card box-shadow">
    <div class="card-body border">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase mb-0">@ViewData["Title"]</h5>
                <span class="ac-ref">Indeks</span>
            </div>

        </div>
        <hr class="mt-2" />
        <div class="card mb-2">
            <div class="card-body pl-3 pb-2 ">
                <label class="form-control-plaintext" for="searchselect">Carian : </label>
                <div class="form-actions no-color mb-2">
                    <form asp-action="Index" method="get" class="needs-validation" novalidate>
                        <div class="form-actions no-color mb-3">
                            <div class="form-row">
                                <div class="col-md-2">
                                    <label class="form-control-label">Kump. Wang</label>
                                </div>
                                <div class="col-md-8">
                                    <div class="input-group mb-2 input-group-sm ">
                                        <select class="form-control form-control-sm select2" name="JKWId" asp-items="@ViewBag.jKW" id="ddlJKW" required></select>
                                        <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="col-md-2">
                                    <label class="form-control-label">Bahagian</label>
                                </div>
                                <div class="col-md-8">
                                    <div class="input-group mb-2 input-group-sm ">
                                        <select class="form-control form-control-sm select2" name="JBahagianId" asp-items="@ViewBag.bahagian" id="ddlBahagian" required></select>
                                        <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="col-md-2">
                                    <div class="input-group mb-2 input-group-sm ">
                                        <label class="form-control-label">Tarikh</label>
                                    </div>
                                </div>
                                <div class="col-md-4">

                                    <div class="input-group mb-2 input-group-sm ">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" id="basic-addon1">Hingga</span>
                                        </div>
                                        <input class="form-control form-control-sm" type="datetime-local" name="TarHingga1" value="@ViewData["DateTo"]" id="tarikh2" required />
                                        <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="mb-3">
                            <div class="text-center hidden-mobile">
                                <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                                    <button class="btn ac-primary" disabled="disabled"><i class="fas fa-eye"></i></button>
                                    <button class="btn ac-primary" style="color: white;" type="submit">Papar</button>
                                </div>
                                <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                                    <button class="btn ac-warning" disabled="disabled"><i class="fa-solid fa-xmark"></i></button>
                                    <a class="btn ac-warning" asp-action="Index"> Batal Papar </a>
                                </div>
                                <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                                    <button class="btn ac-info" disabled="disabled"><i class="fas fa-print"></i></button>
                                    <button class="btn ac-info" data-toggle="modal" data-target="#modalCetak" style="color: white;" type="button" data-placement="top" title="Cetak">Cetak</button>
                                </div>

                                @*<a class="text-right btn btn-info text-white" asp-action="PrintCarta">Cetak Carta</a>*@
                            </div>
                            <div class="text-center show-mobile">
                                <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                                    <button class="btn text-primary" type="submit" data-toggle="tooltip" data-placement="top" title="Papar"><i class="fa fa-eye fa-2x"></i></button>
                                    <a class="btn text-warning" asp-action="Index"><i class="fa-solid fa-xmark fa-2x"></i></a>
                                    <button class="btn text-info" data-toggle="modal" data-target="#modalCetak" data-placement="top" type="button" title="Cetak"><i class="fas fa-print fa-2x"></i></button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
        @if (Model.KunciKirakira.Count > 0)
        {
            <div class="form-row">
                <div class="col-lg-12">

                    <div class="table-responsive table-sm overflow-auto" style="max-height:70vh;">
                        <table class="table table-bordered table-hover display compact nowrap" width="100%" id="tblKunciKirakira">
                            <thead>
                                <tr>
                                    <th colspan="3" class="text-center table-dark text-uppercase">
                                        KUNCI KIRA-KIRA PADA TARIKH : @date
                                    </th>
                                </tr>
                                <tr>
                                    <th>
                                        No Akaun
                                    </th>
                                    <th>
                                        Nama Akaun
                                    </th>
                                    <th align="right">
                                        Baki RM
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="tbodyKunciKirakira">

                                @foreach (var group in Model.KunciKirakiraGrouped)
                                {
                                    switch (group.Key)
                                    {
                                        case 1:
                                            key = "ASET SEMASA";
                                            break;
                                        case 2:
                                            key = "ASET TETAP";
                                            break;
                                        case 3:
                                            key = "LIABILITI SEMASA";
                                            break;
                                        case 4:
                                            key = "EKUITI";
                                            break;
                                        case 5:
                                            key = "UNTUNG/RUGI";
                                            break;
                                    }
                                    <tr>
                                        <td colspan="3" class="text-uppercase ac-secondary font-weight-bold text-white">@key</td>
                                    </tr>
                                    @foreach (var item in group)
                                    {

                                        switch (item.Jenis)
                                        {
                                            case "ASET TETAP":
                                                asetTetap += item.Amaun;
                                                JumAset += item.Amaun;
                                                asetBersih += item.Amaun;
                                                break;
                                            case "ASET SEMASA":
                                                asetSemasa += item.Amaun;
                                                JumAset += item.Amaun;
                                                asetBersih += item.Amaun;
                                                break;
                                            case "LIABILITI SEMASA":
                                                liabiliti += item.Amaun;
                                                asetBersih -= item.Amaun;
                                                break;
                                            case "EKUITI":
                                                ekuiti += item.Amaun;
                                                break;
                                        }
                                        <tr>
                                            <td>
                                                @item.NoAkaun
                                            </td>
                                            <td>
                                                @item.NamaAkaun
                                            </td>
                                            <td>
                                                @Convert.ToDecimal(item.Amaun).ToString("#,##0.00")
                                            </td>
                                        </tr>

                                    }

                                    @switch (group.Key)
                                    {
                                        case 1:
                                            <tr class=" font-weight-bold">
                                                <td colspan="2" class="text-right text-uppercase table-warning">Jumlah Aset Semasa RM</td>
                                                <td>@Convert.ToDecimal(asetSemasa).ToString("#,##0.00")</td>
                                            </tr>

                                            break;
                                        case 2:
                                            <tr class=" font-weight-bold">
                                                <td colspan="2" class="text-right text-uppercase table-warning">Jumlah Aset Tetap RM</td>
                                                <td>@Convert.ToDecimal(asetTetap).ToString("#,##0.00")</td>
                                            </tr>
                                            <tr class=" font-weight-bold">
                                                <td colspan="2" class="text-right text-uppercase table-warning">Jumlah Aset RM</td>
                                                <td>@Convert.ToDecimal(JumAset).ToString("#,##0.00")</td>
                                            </tr>
                                            break;
                                        case 3:
                                            <tr class=" font-weight-bold">
                                                <td colspan="2" class="text-right text-uppercase table-warning">Jumlah Liabiliti Semasa RM</td>
                                                <td>@Convert.ToDecimal(liabiliti).ToString("#,##0.00")</td>
                                            </tr>
                                            <tr class=" font-weight-bold">
                                                <td colspan="2" class="text-right text-uppercase table-warning">Jumlah Aset Bersih RM</td>
                                                <td>@Convert.ToDecimal(asetBersih).ToString("#,##0.00")</td>
                                            </tr>
                                            break;
                                        case 4:
                                            <tr class=" font-weight-bold">
                                                <td colspan="2" class="text-right text-uppercase table-warning">Jumlah Ekuiti RM</td>
                                                <td>@Convert.ToDecimal(ekuiti).ToString("#,##0.00")</td>
                                            </tr>
                                            break;
                                    }


                                }


                            </tbody>

                        </table>
                    </div>
                </div>
            </div>
            <hr />


        }
    </div>
</div>
<!-- Modal Cetak -->
<div class="modal fade bd-example-modal-lg" id="modalCetak" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-success">
                <h5 class="modal-title">Cetak Timbang Duga</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"><i class="fas fa-times fa-2x"></i></span>
                </button>
            </div>
            <form asp-action="PrintPDF" class="needs-validation">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="modal-body">
                    <div class="form-row">
                        <div class="col-sm-2">
                            <label class="form-control-label">JKW</label>
                        </div>
                        <div class="col-sm-10">
                            <div class="mb-2 input-group-sm ">
                                <select class="form-control form-control-sm select2" name="JKWId" asp-items="@ViewBag.jKW" id="ddlJKWPrint"></select>
                                <label class="invalid-feedback">Sila isi ruangan ini.</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-sm-2">
                            <label class="form-control-label">Bahagian</label>
                        </div>
                        <div class="col-sm-10">
                            <div class="mb-2 input-group-sm ">
                                <select class="form-control form-control-sm select2" name="JBahagianId" asp-items="@ViewBag.bahagian" id="ddlBahagianPrint"></select>
                                <label class="invalid-feedback">Sila isi ruangan ini.</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="col-md-2">
                            <div class="input-group mb-2 input-group-sm ">
                                <label class="form-control-label">Tarikh</label>
                            </div>
                        </div>
                        <div class="col-md-10">

                            <div class="input-group mb-2 input-group-sm ">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="basic-addon1">Hingga</span>
                                </div>
                                <input class="form-control form-control-sm" type="datetime-local" name="TarHingga1" value="@ViewData["DateTo"]" id="tarikh2" required />
                                <label class="invalid-feedback">Sila isi ruangan ini.</label>
                            </div>
                        </div>
                    </div>


                </div>
                <div class="modal-footer">
                    <button type="button" class="btn ac-danger btn-sm" data-dismiss="modal">Tutup</button>
                    <button type="submit" class="btn ac-success btn-sm" formtarget="_blank">Cetak</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Modal Cetak End -->