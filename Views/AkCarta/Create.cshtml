@model MSNK.Models.Modules.AkCarta

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>AkCarta</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="JKWId" class="control-label"></label>
                <select class="form-control" asp-for="JKWId">
                    <option value="" hidden>-- Pilih Kumpulan Wang --</option>
                    @foreach (var s in ViewBag.KW)
                    {
                        <option value="@s.Id">@s.Perihal </option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="JJenisId" class="control-label"></label>
                <select class="form-control" asp-for="JJenisId">
                    <option value="" hidden >-- Pilih Jenis --</option>
                    @foreach (var s in ViewBag.Jenis)
                    {
                        <option value="@s.Id">@s.Kod </option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="JParasId" class="control-label"></label>
                <select class="form-control" asp-for="JParasId">
                    <option value="" hidden >-- Pilih Paras --</option>
                    @foreach (var s in ViewBag.Paras)
                    {
                        <option value="@s.Id">@s.Kod </option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Kod" class="control-label"></label>
                <input asp-for="Kod" class="form-control" />
                <span asp-validation-for="Kod" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Nama" class="control-label"></label>
                <input asp-for="Nama" class="form-control" />
                <span asp-validation-for="Nama" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DebitKredit" class="control-label"></label>
                <input asp-for="DebitKredit" class="form-control" />
                <span asp-validation-for="DebitKredit" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UmumDetail" class="control-label"></label>
                <input asp-for="UmumDetail" class="form-control" />
                <span asp-validation-for="UmumDetail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Catatan1" class="control-label"></label>
                <input asp-for="Catatan1" class="form-control" />
                <span asp-validation-for="Catatan1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Catatan2" class="control-label"></label>
                <input asp-for="Catatan2" class="form-control" />
                <span asp-validation-for="Catatan2" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
