@model IEnumerable<MSNK.Models.Modules.AkCarta>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<partial name="_TableStickyLastColumn" />  
<partial name="_JSIndex" />
      
<p>
    <a asp-action="Create">Create New</a>
</p>

<label class="form-control-plaintext" for="searchselect">Carian : </label>

<div class="form-actions no-color mb-3">
    <div class="form-row">
        <div class="col-sm mb-3">
            <select class="custom-select" id="columnSearch">
                <option value=".kw">KW</option>
                <option value=".kod">Kod</option>
                <option selected value=".perihal">Perihal</option>
            </select>
        </div>
        <div class="col-sm mb-3">
            <input class="form-control" type="text" id="myInput" />
        </div>
        <div class="col-sm mb-3">
            <button class="btn btn-warning" id="batalCari">Batal Carian</button>
        </div>
    </div>
</div>


<div class="table-responsive">
    <table class="table table-hover table-bordered nowrap" width="100%">
        <thead>
            <tr>
                <th></th>
                <th class="kw">
                    @Html.DisplayNameFor(model => model.JKW)
                </th>
                <th class="kod">
                    @Html.DisplayNameFor(model => model.Kod)
                </th>
                <th class="perihal">
                    @Html.DisplayNameFor(model => model.Perihal)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JJenis)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JParas)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DebitKredit)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UmumDetail)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Baki)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Catatan1)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Catatan2)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr>
                <td></td>
                <td>
                    @Html.DisplayFor(modelItem => item.JKW.Kod)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Kod)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Perihal)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.JJenis.Nama)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.JParas.Kod)
                </td>
                <td>
                    @*@Html.DisplayFor(modelItem => item.DebitKredit)*@
                    @if (item.DebitKredit.ToString() == "D")
                    {
                        <label class="mb-0">DEBIT</label>
                    }
                    else if (item.DebitKredit.ToString() == "K")
                    {
                        <label class="mb-0">KREDIT</label>
                    }
                </td>
                <td>
                    @*@Html.DisplayFor(modelItem => item.UmumDetail)*@
                    @if (item.UmumDetail.ToString() == "U")
                    {
                        <label class="mb-0">UMUM</label>
                    }
                    else if (item.UmumDetail.ToString() == "D")
                    {
                        <label class="mb-0">DETAIL</label>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Baki)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Catatan1)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Catatan2)
                </td>
                <td>
                    @*<a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |*@
                    @*<a asp-action="Details" asp-route-id="@item.Id">Details</a> |*@
                    @*<a asp-action="Delete" asp-route-id="@item.Id">Delete</a>*@
                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-primary btn-sm" type="button"
                       data-toggle="tooltip" data-placement="top"
                       title="Ubah/Papar">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm" type="button"
                       data-toggle="tooltip" data-placement="top"
                       title="Hapus">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
