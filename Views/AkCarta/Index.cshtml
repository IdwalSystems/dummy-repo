@model IEnumerable<MSNK.Models.Modules.AkCarta>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_TableStickyLastColumn" />
<partial name="_JSIndex" />
<style>
    .borderstyle {
        border: 5px solid lightgray;
    }
</style>

<div class="row mb-2">
    <div class="col-8">
        <h3 class="text-left">Carta Akaun</h3>
    </div>
    <div class="col-4 text-right">
        <a class="text-right btn btn-success text-white" asp-action="Create">Tambah Baru</a>
    </div>
</div>
<div class="card mb-2">
    <div class="card-body pl-3 pb-2">
        <label class="form-control-plaintext" for="columnSearch">Carian : </label>
        <div class="form-actions no-color mb-2">
            <div class="form-row">
                <div class="col-sm mb-2">
                    <select class="custom-select form-control-sm" id="columnSearch">
                        <option value="" selected>Semua</option>
                        <option value=".kw">KW</option>
                        <option value=".kod">Kod</option>
                        <option value=".perihal">Perihal</option>
                    </select>
                </div>
                <div class="col-sm mb-2">
                    <input class="form-control form-control-sm" type="text" id="myInput" />
                </div>
                <div class="col-sm mb-2">
                    <button class="btn btn-warning btn-sm" id="batalCari" value="Batal Carian"><i class="fas fa-backspace"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-bordered table-hover text-nowrap table-sm nowrap compact" width="100%">
        <thead>
            <tr>
                <th align="center">Bil</th>
                <th class="kw">
                    @Html.DisplayNameFor(model => model.JKW)
                </th>
                <th class="kod">
                    @Html.DisplayNameFor(model => model.Kod)
                </th>
                <th class="perihal">
                    @Html.DisplayNameFor(model => model.Perihal)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JJenis)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JParas)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DebitKredit)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UmumDetail)
                </th>
                <th align="right">
                    @Html.DisplayNameFor(model => model.Baki)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Catatan1)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Catatan2)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var tabletype = item.JParas.Kod == "1" ? "table-danger" : 
                item.JParas.Kod == "2" ? "table-warning" :
                item.JParas.Kod == "3" ? "table-info" : null;
            <tr class="@tabletype">
                <td align="center"></td>
                <td>
                    @Html.DisplayFor(modelItem => item.JKW.Kod)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Kod)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Perihal)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.JJenis.Nama)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.JParas.Kod)
                </td>
                <td>
                    @if (item.DebitKredit.ToString() == "D")
                    {
                        <label class="mb-0">DEBIT</label>
                    }
                    else if (item.DebitKredit.ToString() == "K")
                    {
                        <label class="mb-0">KREDIT</label>
                    }
                </td>
                <td>
                    @if (item.UmumDetail.ToString() == "U")
                    {
                        <label class="mb-0">UMUM</label>
                    }
                    else if (item.UmumDetail.ToString() == "D")
                    {
                        <label class="mb-0">DETAIL</label>
                    }
                </td>
                <td align="right">
                    @Html.DisplayFor(modelItem => item.Baki)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Catatan1)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Catatan2)
                </td>
                <td align="center">
                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-primary btn-sm" type="button"
                       data-toggle="tooltip" data-placement="top"
                       title="Ubah/Papar">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm" type="button"
                       data-toggle="tooltip" data-placement="top"
                       title="Hapus">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
