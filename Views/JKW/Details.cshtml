@model MSNK.Models.Modules.JKW

@{
    ViewData["Title"] = "Papar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h4>Kumpulan Wang - Papar</h4>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Kod)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Kod)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Perihal)
        </dt>
        <dd class = "col-sm-10">
            @Model.Perihal.ToUpper()
        </dd>
    </dl>
</div>
<div>
    <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@Model.Id">Ubah</a> |
    <a asp-action="Index">Kembali ke Indeks</a>
</div>
