@model MSNK.Models.Modules.JPelulus

@{
    ViewData["Title"] = "Tambah";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_JSCreate" />

<div class="row">
    <div class="col-md-12">
        <form asp-action="Create" class="needs-validation">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="card box-shadow border-success mb-3">
                <div class="card-header bg-success text-white">
                    <h5>Pelulus - @ViewData["Title"]</h5>
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="SuPekerjaId" class="control-label"></label><span class="text-danger">*</span>
                                <select asp-for="SuPekerjaId" class="form-control form-control-sm select2" required>
                                    <option value="0" hidden>-- Pilih Anggota --</option>
                                    @foreach (var s in ViewBag.SuPekerja)
                                    {
                                        <option value="@s.Id" >@s.NoGaji - @s.Nama</option>
                                    }
                                </select>
                                <span asp-validation-for="SuPekerjaId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="form-row mb-3">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="MinAmaun" class="control-label"></label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <input asp-for="MinAmaun" class="form-control form-control-sm" type="number" placeholder="0.00" />
                            <span asp-validation-for="MinAmaun" class="text-danger"></span>

                        </div>
                        <div class="col-md-1">
                            <p class="text-center mb-0"><i class="fas fa-angle-right"></i></p>
                        </div>
                        <div class="col-md-3">
                            <input asp-for="MaksAmaun" class="form-control form-control-sm" type="number" placeholder="0.00" />
                            <span asp-validation-for="MaksAmaun" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-header">
                            <h6>Modul yang diluluskan</h6>
                        </div>
                        <div class="card-body">
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="IsNotaMinta" /> @Html.DisplayNameFor(model => model.IsNotaMinta)
                                </label>
                            </div>
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="IsPO" /> @Html.DisplayNameFor(model => model.IsPO)
                                </label>
                            </div>
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="IsBelian" /> @Html.DisplayNameFor(model => model.IsBelian)
                                </label>
                            </div>
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="IsPV" /> @Html.DisplayNameFor(model => model.IsPV)
                                </label>
                            </div>
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="IsPendahuluan" /> @Html.DisplayNameFor(model => model.IsPendahuluan)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Simpan" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
    <a asp-action="Index">Kembali ke Indeks</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
