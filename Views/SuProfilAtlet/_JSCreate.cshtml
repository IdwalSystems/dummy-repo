<script type="text/javascript">
    // onchange no Rujukan
    $("body").on('change', "#txtTahun, #txtBulan, #JBahagianId", function () {
        var year = $("#txtTahun").val();
        var month = $("#txtBulan").val();
        var bahagianId = $("#JBahagianId").val();
        if (year != null && month != null && bahagianId != null) {
            JsonKod(year, month, bahagianId);
        }

    });

    function JsonKod(year, month, bahagianId) {
        $.ajax({
            type: "POST",
            //url: "/AkPV/JsonGetKod",
            url: '@Url.Action("JsonGetKod", "SuProfilAtlet")',
            data: {year: year, month: month, bahagianId:bahagianId },
            dataType: "json",
            success: function (msg) {
                $("#txtNoRujukan").val(msg.record);
                $("#JKWId").val(msg.kw);
            },
            error: function (req, status, error) {
                alert(error);
            }
        });
    }
    // onchange no Rujukan end

    //update tbl objek
    function Update1(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var suAtletId = $("TD", row).eq(0).html();

        var SuProfil1 = {
            SuAtletId: suAtletId
        }
        $.ajax({
            type: "POST",
            //url: "/AbWaran/GetAnItemCartAbWaran1",
            url: '@Url.Action("GetAnItemCartSuProfil1", "SuProfilAtlet")',
            data: SuProfil1,
            dataType: "json",
            success: function (r) {
                //insert data in modal objek
                $("#moId1").val(r.record.id);
                $("#moSuAtletId").val(r.record.suAtletId);
                $("#moNama").val(r.suAtlet.nama);
                $("#moAmaun1").val(r.record.amaun.toFixed(2));
                $("#moAmaunSebelum").val(r.record.amaunSebelum.toFixed(2));
                $("#moTunggakan").val(r.record.tunggakan.toFixed(2));
                $("#moJumlah1").val(r.record.jumlah);

                //show modal objek
                $("#modalObjek").modal({ backdrop: 'static', keyboard: false });

            }
        });
    };

    function modalUpdate1() {
        var amaun = $("#moAmaun1").val();
        var amaunSebelum = $("#moAmaunSebelum").val();
        var tunggakan = $("#moTunggakan").val();
        var suAtletId = $("#moSuAtletId").val();
        var jumlah1 = $("#moJumlah1").val();
        var jumlah = $("#jumlahObjek");

        var SuProfil1 = {
            suAtletId: suAtletId,
            Amaun: amaun,
            AmaunSebelum: amaunSebelum,
            Tunggakan: tunggakan,
            Jumlah: jumlah1
        }

        $.ajax({
            type: "POST",
            //url: "/AbWaran/SaveCartAbWaran1",
            url: '@Url.Action("SaveCartSuProfil1", "SuProfilAtlet")',
            data: SuProfil1,
            dataType: "json",
            success: function (b) {
                //insert notification here

                if (b.result == "OK") {
                    $.ajax({
                        type: "POST",
                        //url: "/AbWaran/GetAllItemCartAbWaran1",
                        url: '@Url.Action("GetAllItemCartSuProfil1", "SuProfilAtlet")',
                        dataType: "json",
                        success: function (r) {

                            //refresh updated table objek
                            $("table tbody#tbodyObjek").empty();
                            var sum = 0;
                            if (r.record.length > 0) {
                                for (var i = 0; i < r.record.length; i++) {
                                    var item1 = r.record[i];
                                    var str = "<tr><td id='suAtletId' hidden>" + item1.suAtletId +
                                        "</td><td>" + item1.suAtlet.nama +
                                        "</td><td class='text-right'>" + (item1.amaun).toFixed(2) +
                                        "</td><td class='text-right'>" + (item1.amaunSebelum).toFixed(2) +
                                        "</td><td class='text-right'>" + (item1.tunggakan).toFixed(2) +
                                        "</td><td class='text-right'>" + (item1.jumlah).toFixed(2) +
                                        "</td><td>" +
                                        "<button class='btn btn-primary btn-sm' type='button' id='btnUpdate1' data-toggle='modal' data-target='#modalObjek' onclick='Update1(this)'><i class='fa fa-edit' ></i></button>" +
                                        "</td><tr>";
                                    $("table tbody#tbodyObjek").append(str);
                                    sum += item1.jumlah;
                                }
                            }
                            jumlah.val(sum.toFixed(2));
                        }
                    });
                } else {
                    toastr.error("Sistem ralat ketika ubah Cart Atlet.", "Ralat");
                    toastr.options.timeOut = 2000; // 2s
                }
            }
        });
    };
    //update tbl objek end

    //validation form
    (function () {
        'use strict';
        window.addEventListener('load', function () {
            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.getElementsByClassName('needs-validation');
            // Loop over them and prevent submission
            Array.prototype.filter.call(forms, function (form) {
                form.addEventListener('submit', function (event) {
                    if (form.checkValidity() === false) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        }, false);
    })();

    $(document).ready(function () {
        $.validator.setDefaults({
            errorElement: "span",
            errorClass: "help-block",
            //	validClass: 'stay',
            highlight: function (element, errorClass) {
                $(element).addClass(errorClass); //.removeClass(errorClass);
                $(element).closest('.form-group').removeClass('has-success').addClass('has-error');
            },
            unhighlight: function (element, errorClass) {
                $(element).removeClass(errorClass); //.addClass(validClass);
                $(element).closest('.form-group').removeClass('has-error').addClass('has-success');
            },

            errorPlacement: function (error, element) {
                if (element.parent('.input-group').length) {
                    error.insertAfter(element.parent());
                } else {
                    error.insertAfter(element);
                }

            },

        });
    });
    //validation form end
</script>
