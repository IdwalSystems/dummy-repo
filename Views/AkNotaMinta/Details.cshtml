@model MSNK.Models.Modules.ViewModel.AkNotaMintaViewModel

@{
    ViewData["Title"] = "Nota Minta - Papar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_JSDetails" />
<div class="card box-shadow">
    <div class="card-body">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase text-dark mb-0">Nota Minta - Papar</h5>
                <span class="ac-ref"><a asp-action="Index" class="text-secondary">Indeks</a> / Papar</span>
            </div>
            <div class="col-4 text-right">
                <a asp-action="Index" class="text-secondary"><i class="fas fa-times fa-2x"></i></a>
            </div>
    
        </div>
        <hr class="mt-2"/>
                <div class="form-row">
                    <div class="col-lg-10">
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="form-group">
                                    <label class="control-label">Kategori</label>
                                </div>
                                <div class="form-row col-sm ml-2">
                                    <div class="custom-control custom-radio col-md-4 ">
                                        <input class="custom-control-input" type="radio" id="FlJenis0" asp-for="FlJenis" value="0" checked>
                                        <label class="custom-control-label" for="FlJenis0">
                                            Pesanan Tempatan
                                        </label>
                                    </div>
                                    <div class="custom-control custom-radio col-md-4">
                                        <input class="custom-control-input" type="radio" asp-for="FlJenis" id="FlJenis1" value="1" >
                                        <label class="custom-control-label" for="FlJenis1">
                                            Inden Kerja
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="Tarikh" class="control-label"></label>
                                    <input asp-for="Tarikh" class="form-control form-control-sm" type="date" required readonly />
                                </div>
                            </div>
                            <div class="col-md-1">
                                <div class="form-group">
                                    <label asp-for="Tahun" class="control-label"></label>
                                    <input asp-for="Tahun" class="form-control form-control-sm" required id="txtTahun" readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="JKWId" class="control-label"></label>
                                    <select class="form-control form-control-sm text-uppercase" asp-for="JKWId" required id="ddlKW" disabled>
                                        @foreach (var s in ViewBag.JKW)
                                        {
                                            <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="JBahagianId" class="control-label"></label>
                                    <input  class="form-control form-control-sm text-uppercase" value="@Model.JBahagian.Kod - @Model.JBahagian.Perihal " readonly />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label asp-for="NoRujukan" class="control-label"></label>
                                    <input asp-for="NoRujukan" class="form-control form-control-sm text-uppercase" required id="txtNoRujukan" disabled />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="AkPembekalId" class="control-label"></label>
                            <select class="form-control form-control-sm select2" asp-for="AkPembekalId" id="ddlKodPembekal" required disabled>
                                <option value="0" disabled selected>-- Pilih Kod Pembekal --</option>
                                @foreach (var s in ViewBag.AkPembekal)
                                {
                                    <option value="@s.Id">@s.KodSykt - @s.NamaSykt</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label asp-for="Tajuk" class="control-label"></label>
                            <textarea asp-for="Tajuk" class="form-control form-control-sm text-uppercase" rows="2" id="txtTajuk" readonly></textarea>
                        </div>
                        <div class="form-row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="NoSiri" class="control-label"></label>
                                    <input asp-for="NoSiri" class="form-control form-control-sm text-uppercase" required disabled />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="NoCAS" class="control-label"></label>
                                    <input asp-for="NoCAS" class="form-control form-control-sm text-uppercase" required disabled />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="TarikhSeksyenKewangan" class="control-label"></label>
                                    <input asp-for="TarikhSeksyenKewangan" class="form-control form-control-sm" type="date" required readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <div class="card mb-2">
                            <div class="card-body p-1">
                                <div class="form-group col-sm">
                                    <label asp-for="FlPosting" class="control-label"></label>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlPosting" type="radio" id="FlPosting1" name="FlPosting" class="custom-control-input" value="0" checked>
                                        <label class="custom-control-label" for="FlPosting">Belum</label>
                                    </div>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlPosting" type="radio" id="FlPosting2" name="FlPosting" class="custom-control-input" value="1">
                                        <label class="custom-control-label" for="FlPosting">Sudah</label>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="card mb-2">
                            <div class="card-body p-1">
                                <div class="form-group col-sm">
                                    <label asp-for="FlHapus" class="control-label"></label>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlHapus" type="radio" id="FlHapus1" name="FlHapus" class="custom-control-input" value="0" checked>
                                        <label class="custom-control-label" for="FlBatal">Tidak</label>
                                    </div>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlHapus" type="radio" id="FlHapus1" name="FlHapus" class="custom-control-input" value="1">
                                        <label class="custom-control-label" for="FlHapus">Ya</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @*table Objek*@
                <div class="card box-shadow mb-3 mt-2">
                    <div class="card-header">
                        <h6>Objek</h6>
                    </div>
                    <div class="card-body">
                        <table id="tblObjek" class="table table-sm nowrap" cellpadding="0" cellspacing="0">
                            <thead>
                                <tr>
                                    <th style="width:40%">Kod</th>
                                    <th style="width:50%">Amaun</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="tbodyObjek">
                                @foreach (var item in ViewBag.akNotaMinta1)
                                {
                                    <tr id="@item.Id">
                                        <td id="akCartaId" hidden>@item.AkCartaId</td>
                                        <td class="text-left">@item.AkCarta.Kod - @item.AkCarta.Perihal</td>
                                        <td class="text-right" id="td1Amaun">@item.Amaun</td>
                                    </tr>

                                }
                            </tbody>
                            <tfoot>
                            </tfoot>
                        </table>
                    </div>
                    <div class="card-footer">
                        <div class="form-group pb-2">
                            <label asp-for="Jumlah" class="control-label">Jumlah Objek</label>
                            <input asp-for="Jumlah" class="form-control form-control-sm" id="jumlahObjek" readonly />
                        </div>
                    </div>

                </div>
                @*table Objek end*@
                @*table perihal*@
                <div class="card box-shadow mb-3 mt-2">
                    <div class="card-header">
                        <h6>Perihal</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive table-sm">
                            <table id="tblPerihal" class="table table-hover" width="100%">
                                <thead>
                                    <tr>
                                        <th>Bil</th>
                                        <th>No Stok</th>
                                        <th width="30%">Perihal</th>
                                        <th>Kuantiti</th>
                                        <th>Unit</th>
                                        <th>Harga/Unit</th>
                                        <th>Amaun</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyPerihal">
                                    @foreach (var item in ViewBag.akNotaMinta2)
                                    {
                                        <tr>
                                            <td class="text-left">@item.Bil</td>
                                            <td class="text-left">@item.NoStok</td>
                                            <td class="text-left text-uppercase">@item.Perihal</td>
                                            <td class="text-right">@item.Kuantiti</td>
                                            <td class="text-center text-uppercase">@item.Unit</td>
                                            <td class="text-right">@item.Harga</td>
                                            <td class="text-right">@item.Amaun</td>
                                        </tr>

                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="form-group">
                            <label class="control-label">Jumlah Perihal</label>
                            <input class="form-control form-control-sm" id="jumlahPerihal" value="@Model.JumlahPerihal" name="JumlahPerihal" readonly />
                        </div>
                    </div>
                </div>
                @*table perihal end*@
                <hr />
        <div class="form-group">
            @if (Model.FlHapus == 0)
            {
                @if (Model.FlPosting == 1)
                {
                }
                else
                {
                    @if (Model.FlStatusSemak == 1)
                    {
                        <button class="btn ac-primary btn-sm" data-toggle="modal" data-target="#modalUbah">
                            Ubah
                        </button>
                        <button class="btn ac-secondary btn-sm" data-toggle="modal" data-target="#modalUbah">
                            Bahagian Kewangan
                        </button>
                    }
                    else
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn ac-primary btn-sm">Ubah</a>
                        <a asp-action="EditKewangan" asp-route-id="@Model.Id" class="btn ac-secondary btn-sm">Bahagian Kewangan</a>
                    }

                }
            }

            <a asp-action="Index" class="btn ac-secondary btn-sm" style="width:auto">Batal</a>
        </div>
    </div>
</div>



<!-- Modal Ubah -->
<div class="modal fade" id="modalUbah" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-md modal-dialog modal-dialog-centered">
        <div class="modal-content ">
            <div class="modal-header bg-warning text-white">

                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i>  Ubah</h5>

                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times text-white"></i>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-center">Permohonan ini telahpun disemak. Anda pasti untuk meneruskan operasi ini?</p>
                <div class="form-row">
                    <div class="col-6 mb-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-danger btn-block btn-lg ">YA</a>
                    </div>
                    <div class="col-6">
                        <a data-dismiss="modal" aria-label="Close" class=" btn btn-secondary btn-block btn-lg text-white">TIDAK</a>
                    </div>


                </div>
            </div>
            <div class="modal-footer" style="padding:0px;">


            </div>
        </div>
    </div>
</div>
<!-- Modal Ubah End -->