@model MSNK.Models.Modules.AkNotaMinta

@{
    ViewData["Title"] = "Bahagian Kewangan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_JSEdit" />
<div class="row">
    <div class="col-md-12">

        <form asp-action="EditKewangan" class="needs-validation">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="card box-shadow border-secondary mb-3" id="denganPesananTempatan">
                <div class="card-header bg-secondary text-white">
                    <h5>Nota Minta - @ViewData["Title"]</h5>
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Tarikh" class="control-label"></label>
                                <input asp-for="Tarikh" class="form-control form-control-sm" type="date" required readonly />
                                <span asp-validation-for="Tarikh" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-1">
                            <div class="form-group">
                                <label asp-for="Tahun" class="control-label"></label>
                                <input asp-for="Tahun" class="form-control form-control-sm" required id="txtTahun" readonly />
                                <span asp-validation-for="Tahun" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="JKWId" class="control-label"></label><span class="text-danger control-label">*</span>
                                <select class="form-control form-control-sm text-uppercase" asp-for="JKWId" required id="ddlKW" disabled>
                                    @foreach (var s in ViewBag.JKW)
                                    {
                                        <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                    }
                                </select>
                                <span asp-validation-for="JKWId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="JBahagianId" class="control-label"></label><span class="text-danger control-label">*</span>
                                <select class="form-control form-control-sm text-uppercase" asp-for="JKWId" required id="ddlBahagian" disabled>
                                    @foreach (var s in ViewBag.JBahagian)
                                    {
                                        <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label asp-for="NoRujukan" class="control-label"></label>
                                <input asp-for="NoRujukan" class="form-control form-control-sm text-uppercase" required disabled />
                                <span asp-validation-for="NoRujukan" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="AkPembekalId" class="control-label"></label><span class="text-danger control-label">*</span>
                        <select class="form-control form-control-sm select2" asp-for="AkPembekalId" id="ddlKodPembekal" required disabled>
                            <option value="0" disabled selected>-- Pilih Kod Pembekal --</option>
                            @foreach (var s in ViewBag.AkPembekal)
                            {
                                <option value="@s.Id">@s.KodSykt - @s.NamaSykt</option>
                            }
                        </select>
                        <span asp-validation-for="AkPembekalId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Tajuk" class="control-label"></label>
                        <textarea asp-for="Tajuk" class="form-control form-control-sm text-uppercase" rows="2" id="txtTajuk" readonly></textarea>
                        <span asp-validation-for="Tajuk" class="text-danger"></span>
                    </div>

                    <div class="form-row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="NoSiri" class="control-label"></label>
                                <input asp-for="NoSiri" class="form-control form-control-sm text-uppercase" value="@ViewBag.NoSiri" required readonly />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="NoCAS" class="control-label"></label>
                                <input asp-for="NoCAS" class="form-control form-control-sm text-uppercase" disabled />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="TarikhSeksyenKewangan" class="control-label"></label>
                                <input asp-for="TarikhSeksyenKewangan" class="form-control form-control-sm" type="date" readonly />
                            </div>
                        </div>
                    </div>
                    @*table Objek*@
                    <div class="card box-shadow mb-3 mt-2">
                        <div class="card-header">
                            <h6>Objek</h6>
                        </div>
                        <div class="card-body">
                            <table id="tblObjek" class="table table-sm nowrap" cellpadding="0" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th style="width:40%">Kod</th>
                                        <th style="width:50%">Amaun</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyObjek">

                                    @foreach (var item in ViewBag.akNotaMinta1)
                                    {
                                        <tr id="@item.Id">
                                            <td id="akCartaId" hidden>@item.AkCartaId</td>
                                            <td>@item.AkCarta.Kod - @item.AkCarta.Perihal</td>
                                            <td id="td1Amaun" class="text-right">@item.Amaun</td>
                                            <td>
                                                <button class="btn btn-primary btn-sm" type="button" id="btnUpdate1" data-toggle="modal" data-target="#modalObjek" onclick="Update1(this)">
                                                    <i class="fa fa-edit"></i>
                                                </button>
                                            </td>
                                            <td>
                                                <button class="btn btn-danger btn-sm" type="button" id="btnRemove1" onclick="Remove1(this)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>

                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td id="akCartaId" hidden></td>
                                        <td style="width:40%">
                                            <select class="form-control form-control-sm select2" id="txtKodAkaun">
                                                <option value="" disabled selected>-- Pilih Kod Akaun --</option>
                                                @foreach (var s in ViewBag.AkCarta)
                                                {
                                                    <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                                }
                                            </select>
                                        </td>
                                        <td style="width:50%"><input class="form-control form-control-sm" type="number" id="txtAmaunObjek" step="0.01" value="0.00"></td>
                                        <td><button class="btn btn-success btn-sm" type="button" id="btnAdd1"><i class="fas fa-plus"></i></button></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <div class="card-footer">
                            <div class="form-group pb-2">
                                <label asp-for="Jumlah" class="control-label">Jumlah Objek</label>
                                <input asp-for="Jumlah" class="form-control form-control-sm" id="jumlahObjek" readonly />
                                <span asp-validation-for="Jumlah" class="text-danger"></span>
                            </div>
                        </div>

                    </div>
                    @*table Objek end*@

                    @*table perihal*@
                    <div class="card box-shadow mb-3 mt-2">
                        <div class="card-header">
                            <h6>Perihal</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive-md">
                                <table id="tblPerihal" class="table table-sm" cellpadding="0" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Bil</th>
                                            <th>No Stok</th>
                                            <th width="30%">Perihal</th>
                                            <th>Kuantiti</th>
                                            <th>Unit</th>
                                            <th>Harga/Unit</th>
                                            <th>Amaun</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyPerihal">
                                        @foreach (var item in ViewBag.akNotaMinta2)
                                        {
                                            <tr id="@item.Id">
                                                <td hidden>@item.Indek</td>
                                                <td class="text-left" hidden>@item.Baris</td>
                                                <td class="text-left">@item.Bil</td>
                                                <td class="text-left text-uppercase">@item.NoStok</td>
                                                <td class="text-left text-uppercase">@item.Perihal</td>
                                                <td class="text-right">@item.Kuantiti</td>
                                                <td class="text-uppercase">@item.Unit</td>
                                                <td class="text-right">@item.Harga</td>
                                                <td class="text-right amaunPerihal">@item.Amaun</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                       
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="form-group">
                                <label class="control-label">Jumlah Perihal</label>
                                <input class="form-control form-control-sm" id="jumlahPerihal" name="JumlahPerihal" readonly />
                            </div>
                        </div>
                    </div>
                    @*table perihal end*@
                </div>
            </div>

            <div class="form-group ">
                <input type="submit" id="btnSave" value="Simpan" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Kembali ke Indeks</a>
</div>

<!-- Modal Objek -->
<div class="modal fade bd-example-modal-lg" id="modalObjek" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Objek</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input id="moId1" hidden />
                    <div class="form-group">
                        <label class="col-form-label">Kod Akaun</label>
                        <select class="form-control form-control-sm" id="moKodAkaun" disabled>
                            <option value="" disabled selected>-- Pilih Kod Akaun --</option>
                            @foreach (var s in ViewBag.AkCarta)
                            {
                                <option value="@s.Id">@s.Kod - @s.Perihal </option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Amaun</label>
                        <input type="number" class="form-control form-control-sm" id="moAmaun1">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-dismiss="modal" onclick="modalUpdate1()">OK</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal Objek End -->
<!-- Modal Perihal -->
<div class="modal fade bd-example-modal-lg" id="modalPerihal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Perihal</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input id="moId2" hidden />
                    <input id="moIndek" hidden />
                    <div class="form-row">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="col-form-label">Baris</label>
                                <input type="number" class="form-control form-control-sm" id="moBaris">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="col-form-label">Bil</label>
                                <input type="number" class="form-control form-control-sm" id="moBil">
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group">
                                <label class="col-form-label">No Stok</label>
                                <input type="text" class="form-control form-control-sm" id="moNoStok">
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-form-label">Perihal</label>
                                <input type="text" class="form-control form-control-sm text-uppercase" id="moPerihal">
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-form-label">Kuantiti</label>
                                <input type="number" class="form-control form-control-sm kuantiti" id="moKuantiti">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-form-label">Unit</label>
                                <input type="text" class="form-control form-control-sm text-uppercase" id="moUnit">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-form-label">Harga/Unit</label>
                                <input type="number" class="form-control form-control-sm hargaUnit" id="moHargaUnit">
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-form-label">Amaun</label>
                                <input type="text" class="form-control form-control-sm amaun" id="moAmaun2" readonly>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-dismiss="modal" onclick="modalUpdate2()">OK</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal Perihal End -->
