@model IEnumerable<MSNK.Models.Modules.ViewModel.AbAlirTunaiViewModel>

@{
    ViewData["Title"] = "Alir Tunai (Bandingan Tahun)";
    Layout = "~/Views/Shared/_Layout.cshtml";

    decimal jum1 = 0;
    decimal jum2 = 0;
    decimal jum3 = 0;

}

<div class="card box-shadow">
    <div class="card-body border">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase mb-0">@ViewData["Title"]</h5>
                <span class="ac-ref">Indeks</span>
            </div>

        </div>
        <hr class="mt-2" />
        <div class="card mb-2">
            <div class="card-body pl-3 pb-2 ">
                <label class="form-control-plaintext" for="searchselect">Carian : </label>
                <div class="form-actions no-color mb-2">
                    <form asp-action="IndexTahun" method="get" class="needs-validation" novalidate>
                        <div class="form-actions no-color mb-3">
                            @*kw*@
                            <div class="col-md-4" hidden>

                                <div class="input-group mb-2 input-group-sm ">
                                    <select class="form-control form-control-sm select2" name="JKWId" asp-items="@ViewBag.jKW" id="ddljKW" required></select>
                                    <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                </div>
                            </div>
                            @*bahagian*@
                            <div class="col-md-4" hidden>

                                <div class="input-group mb-2 input-group-sm ">
                                    <select class="form-control form-control-sm select2" name="JBahagianId" asp-items="@ViewBag.bahagian" id="ddlBahagian" required></select>
                                    <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="col-md-1">
                                                <div class="input-group mb-2 input-group-sm ">
                                                    <label class="form-control-label">Tahun</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6">

                                                <div class="input-group mb-2 input-group-sm ">
                                                    <input class="form-control form-control-sm" type="text" name="Tahun1" value="@ViewData["Tahun1"]" id="tahun1" required />
                                                    <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="col-md-1">
                                                <div class="input-group mb-2 input-group-sm ">
                                                    <label class="form-control-label">Tahun</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6">

                                                <div class="input-group mb-2 input-group-sm ">
                                                    <input class="form-control form-control-sm" type="text" name="Tahun2" value="@ViewData["Tahun2"]" id="tahun2" />
                                                    <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="col-md-1">
                                                <div class="input-group mb-2 input-group-sm ">
                                                    <label class="form-control-label">Tahun</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6">

                                                <div class="input-group mb-2 input-group-sm ">
                                                    <input class="form-control form-control-sm" type="text" name="Tahun3" value="@ViewData["Tahun3"]" id="tahun3" />
                                                    <label class="invalid-feedback">Sila isi ruangan ini.</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="mb-3">
                            <div class="text-center hidden-mobile">
                                <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                                    <button class="btn ac-primary" disabled="disabled"><i class="fas fa-eye"></i></button>
                                    <button class="btn ac-primary" style="color: white;" type="submit">Papar</button>
                                </div>
                                <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                                    <button class="btn ac-warning" disabled="disabled"><i class="fa-solid fa-xmark"></i></button>
                                    <a class="btn ac-warning" asp-action="IndexTahun"> Batal Papar </a>
                                </div>
                                <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                                    <button class="btn ac-info" disabled="disabled"><i class="fas fa-print"></i></button>
                                    <button class="btn ac-info" data-toggle="modal" data-target="#modalCetak" style="color: white;" type="button" data-placement="top" title="Cetak">Cetak</button>
                                </div>

                                @*<a class="text-right btn btn-info text-white" asp-action="PrintCarta">Cetak Carta</a>*@
                            </div>
                            <div class="text-center show-mobile">
                                <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                                    <button class="btn text-primary" type="submit" data-toggle="tooltip" data-placement="top" title="Papar"><i class="fa fa-eye fa-2x"></i></button>
                                    <a class="btn text-warning" asp-action="IndexTahun"><i class="fa-solid fa-xmark fa-2x"></i></a>
                                    <button class="btn text-info" data-toggle="modal" data-target="#modalCetak" data-placement="top" type="button" title="Cetak"><i class="fas fa-print fa-2x"></i></button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>

        @if (Model != null && Model.Count() > 0)
        {
            <div class="form-row overflow-auto" style="max-height:70vh;">
                <div class="col-lg-12">

                    <div class="table-responsive table-sm">
                        <table class="table table-bordered table-hover display compact nowrap" width="100%" id="tblBakiAwal">

                            @*baki awal*@
                            <tbody id="tbodyAlirTunai">
                                <tr>
                                    <th>
                                        No Akaun
                                    </th>
                                    <th>
                                        Nama Akaun
                                    </th>
                                    <th align="right">
                                        Jumlah (@ViewData["Tahun1"]) RM
                                    </th>
                                    @if (ViewData["Tahun2"] != null)
                                    {
                                        <th align="right">
                                            Jumlah (@ViewData["Tahun2"]) RM
                                        </th>

                                    }
                                    @if (ViewData["Tahun3"] != null)
                                    {
                                        <th align="right">
                                            Jumlah (@ViewData["Tahun3"]) RM
                                        </th>
                                    }

                                </tr>
                                @foreach (var item in Model)
                                {
                                    jum1 += item.JumAkaun1;
                                    jum2 += item.JumAkaun2;
                                    jum3 += item.JumAkaun3;
                                    <tr>
                                        <td>
                                            @item.NoAkaun
                                        </td>
                                        <td>
                                            @item.NamaAkaun
                                        </td>
                                        <td>
                                            @Convert.ToDecimal(item.JumAkaun1).ToString("#,##0.00")
                                        </td>
                                        @if (ViewData["Tahun2"] != null)
                                        {
                                            <td>
                                                @Convert.ToDecimal(item.JumAkaun2).ToString("#,##0.00")
                                            </td>
                                        }
                                        @if (ViewData["Tahun3"] != null)
                                        {
                                            <td>
                                                @Convert.ToDecimal(item.JumAkaun3).ToString("#,##0.00")
                                            </td>
                                        }

                                    </tr>

                                }
                                <tr class="font-weight-bold">
                                    <td colspan="2" class="text-right text-uppercase table-warning">Jumlah RM</td>
                                    <td>@Convert.ToDecimal(jum1).ToString("#,##0.00")</td>
                                    @if (ViewData["Tahun2"] != null)
                                    {
                                        <td>@Convert.ToDecimal(jum2).ToString("#,##0.00")</td>

                                    }
                                    @if (ViewData["Tahun3"] != null)
                                    {
                                        <td>@Convert.ToDecimal(jum3).ToString("#,##0.00")</td>
                                    }

                                </tr>
                            </tbody>
                            @*baki awal end*@
                        </table>
                    </div>
                </div>
            </div>
            <hr />
        }
    </div>
</div>