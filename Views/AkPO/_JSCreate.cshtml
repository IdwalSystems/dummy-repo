            var pembekal =
            {
                id: pembekalId
            };

            $("#AkPembekal_NamaSykt").val('');

            $.ajax({
                type: "POST",
                url: '@Url.Action("Details", "AkPembekal")',
                data: pembekal,
                dataType: "json",
                success: function (data) {
                var item = data.record;
                //alert(item.alamat1);
                $("#AkPembekal_NamaSykt").val(item.NamaSykt);
