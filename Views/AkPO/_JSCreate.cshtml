<script type="text/javascript">

    // In your Javascript (external .js resource or <script> tag)
    $(document).ready(function () {
        //$('.js-example-basic-single').select2();


        //$("#ddlPembekal").on('change', function () { //Guna untk capture value input
        //    var pembekal = $("#ddlPembekal").val();
        //    //alert(pembekal);

        //});

        $("#ddlPembekal").on('change', function () {
            var pembekal = $("#ddlPembekal").val();
            JsonKod(pembekal);
            //alert(pembekal);
        });

        //Sum value to Total text field
        $("#txtHargaUnit").on('change', function () {
            var sum = 0;
            var txtKuantiti = $("#txtKuantiti");
            var txtHargaUnit = $("#txtHargaUnit");
            var txtAmaun = $("#txtAmaun");
            sum = parseFloat(txtKuantiti.val()) * parseFloat(txtHargaUnit.val());
            txtAmaun.val(sum);
        });

        //Sum value to Total text field
        $("#txtKuantiti").on('change', function () {
            var sum = 0;
            var txtKuantiti = $("#txtKuantiti");
            var txtHargaUnit = $("#txtHargaUnit");
            var txtAmaun = $("#txtAmaun");
            sum = parseFloat(txtKuantiti.val()) * parseFloat(txtHargaUnit.val());
            txtAmaun.val(sum);
        });
    });

    function JsonKod(id) {
        var Objek = {
            Id: id
        }
        //alert(id);
        $.ajax({
            type: "POST",
            url: "/AkPO/GetMaklumat",
            data: Objek,
            dataType: "json",
            success: function (data) {
                var item = data.record;
                //Nama val kena camelcase
                $("#txtNamaSykt").val(item.namaSykt);
                $("#txtAkaunBank").val(item.akaunBank);
                $("#txtJenisBank").val(item.jBank.nama);
                $("#txtTelefon").val(item.telefon1);
                //var listId = $("#select2-ddlPembekal-container").val(); //Get Datalist Value
                //var string = listId.substring(0, 7); // Substring a Value
                //document.getElementById("txtNamaSykt").value = string;
            },
            error: function (req, status, error) {
                alert(error);
            }
        });
    }

    //add tbl objek
    $("body").on("click", "#btnAdd1", function () {
        //Reference the Name and Country TextBoxes.
        var txtKodAkaun = $("#txtKodAkaun");
        GetCarta(txtKodAkaun.val());
    });

    function GetCarta(id) {
        var Objek = {
            Id: id
        }
        if (id != "") {
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: "/AkPO/GetCarta",
                data: Objek,
                dataType: "json",
                success: function (r) {
                    //Reference the TextBoxes.
                    var txtKodAkaun = $("#txtKodAkaun");
                    var txtAmaunObjek = $("#txtAmaunObjek");
                    var txtJumlah = $("#jumlahObjek");

                    //Sum value to Total text field
                    var sum = 0;
                    sum = parseFloat(txtAmaunObjek.val()) + parseFloat(txtJumlah.val());
                    txtJumlah.val(sum);

                    //Get the reference of the Table's TBODY element.
                    var tBody = $("#tblObjek > TBODY")[0];
                    //Add Row.
                    var row = tBody.insertRow(-1);

                    //Add akCartaId cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(r.record.id);
                    cell.prop("hidden", !this.checked);

                    //Add kod cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(r.record.kod + ' - ' + r.record.perihal);

                    //Add amaun cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(txtAmaunObjek.val());

                    //Add Button cell.
                    cell = $(row.insertCell(-1));
                    var btnRemove1 = $("<button class='btn btn-danger btn-sm' type='button' id='btnRemove1' onclick='Remove1(this)'><i class='fas fa-trash'></i></button>");
                    cell.append(btnRemove1);

                    var AkPO1 = {
                        AkCartaId: txtKodAkaun.val(),
                        Amaun: txtAmaunObjek.val()
                    }

                        $.ajax({
                            type: "POST",
                            url: "/AkPO/SaveAkPO1",
                            data: AkPO1,
                            dataType: "json",
                            success: function (r) {
                                //Clear the TextBoxes.
                                txtKodAkaun.val("");
                                txtAmaunObjek.val("");
                            }
                        });

                }
            });
        }

    }
    //add tbl objek end


    //add tbl Perihal
    var bil = $('#tblPerihal tr').length;
    if (bil == 0) {
        bil = 1;
    }
    $("body").on("click", "#btnAdd2", function () {
        //Reference the Name and Country TextBoxes.
        GetIndek(bil);
    });

    function GetIndek(indek) {
        //Send the JSON array to Controller using AJAX.

        //Reference the TextBoxes.
        var txtIndek = indek;
        var txtBaris = $("#txtBaris");
        var txtBil = $("#txtBil");
        var txtNoStok = $("#txtNoStok");
        var txtPerihal = $("#txtPerihal");
        var txtKuantiti = $("#txtKuantiti");
        var txtUnit = $("#txtUnit");
        var txtHargaUnit = $("#txtHargaUnit");
        var txtAmaun = $("#txtAmaun");
        var txtJumlah = $("#jumlahPerihal");

        //Sum value to Total text field
        var sum = 0;
        sum = parseFloat(txtAmaun.val()) + parseFloat(txtJumlah.val());
        txtJumlah.val(sum);

        //Get the reference of the Table's TBODY element.
        var tBody = $("#tblPerihal > TBODY")[0];
        //Add Row.
        var row = tBody.insertRow(-1);

        //Add Indek cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtIndek);
        cell.prop("hidden", !this.checked);

        //Add Baris cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtBaris.val());

        //Add Bil cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtBil.val());

        //Add No Stok cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtNoStok.val());
        cell.addClass('text-uppercase');

        //Add Perihal cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtPerihal.val());
        cell.addClass('text-uppercase');

        //Add Kuantiti cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtKuantiti.val());

        //Add Unit cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtUnit.val());
        cell.addClass('text-uppercase');

        //Add Harga cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtHargaUnit.val());

        //Add Amaun cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtAmaun.val());

        //Add Edit Button cell.
        cell = $(row.insertCell(-1));

        var btnUpdate2 = $("<button class='btn btn-primary btn-sm' type='button' id='btnUpdate2' onclick='Update2(this)'><i class='fas fa-edit'></i></button>");
        cell.append(btnUpdate2);

        //Add Button cell.
        cell = $(row.insertCell(-1));
        var btnRemove2 = $("<button class='btn btn-danger btn-sm' type='button' id='btnRemove1' onclick='Remove2(this)'><i class='fas fa-trash'></i></button>");
        cell.append(btnRemove2);

        var AkPO2 = {
            Indek: indek,
            Baris: txtBaris.val(),
            Bil: txtBil.val(),
            NoStok: txtNoStok.val(),
            Perihal: txtPerihal.val(),
            Kuantiti: txtKuantiti.val(),
            Unit: txtUnit.val(),
            Harga: txtHargaUnit.val(),
            Amaun: txtAmaun.val()
        }
        $.ajax({
            type: "POST",
            url: "/AkPO/SaveAkPO2",
            data: AkPO2,
            dataType: "json",
            success: function (r) {
                //Clear the TextBoxes.
                txtBaris.val("0");
                txtBil.val("0");
                txtNoStok.val("");
                txtPerihal.val("");
                txtKuantiti.val("0");
                txtUnit.val("");
                txtHargaUnit.val("0.00");
                txtAmaun.val("0.00");
                bil++;
            }
        });
    }


    //add tbl urusniaga end

    //remove tbl objek
    function Remove1(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var name = $("TD", row).eq(0).html();
        var amaun = $("TD", row).eq(2).html();
        var txtJumlah = $("#jumlahObjek");
        if (confirm("Hapus kod Akaun : " + name + " ?")) {
            //Get the reference of the Table.
            var table = $("#tblObjek")[0];

            //Sum value to Total text field
            var sum = 0;
            sum = parseFloat(txtJumlah.val() - parseFloat(amaun));
            txtJumlah.val(sum);

            var AkPO1 = {
                AkCartaId: name,
            }
            if (name != null) {
                $.ajax({
                    type: "POST",
                    url: "/AkPO/RemoveAkPO1",
                    data: AkPO1,
                    dataType: "json",
                    success: function (r) {
                        //Delete the Table row using it's Index.
                        table.deleteRow(row[0].rowIndex);
                    }
                });
            }

        }
    };
    //remove tbl objek end

    //remove tb urusniaga
    function Remove2(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var name = $("TD", row).eq(0).html();
        var amaun = $("TD", row).eq(8).html();
        var txtJumlah = $("#jumlahObjek");
        if (confirm("Hapus : " + name + " ?")) {
            //Get the reference of the Table.
            var table = $("#tblPerihal")[0];
            var txtJumlah = $("#jumlahPerihal");

            //Sum value to Total text field
            var sum = 0;
            sum = parseFloat(txtJumlah.val() - parseFloat(amaun));
            txtJumlah.val(sum);

            var AkPO2 = {
                JCaraBayarId: name,
            }
            if (name != null) {
                $.ajax({
                    type: "POST",
                    url: "/AkPO/RemoveAkPO2",
                    data: AkPO2,
                    dataType: "json",
                    success: function (r) {
                        //Delete the Table row using it's Index.
                        table.deleteRow(row[0].rowIndex);
                    }
                });
            }
        }
    };
    //remove tbl urusniaga end

    $("body").on("click", "#btnSave", function () {
        //insert validation form here
    });

</script>