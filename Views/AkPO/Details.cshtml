@model MSNK.Models.Modules.AkPO

@{
    ViewData["Title"] = "Papar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="card box-shadow border-dark mb-3">
            <div class="card-header bg-dark text-white">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="text-left">Pesanan Tempatan - @ViewData["Title"]</h5>
                    </div>
                </div>

            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="col-lg-10">
                        <div class="form-row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="control-label">Tahun</label>
                                    <input class="form-control form-control-sm" value="@Model.Tahun" readonly />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="control-label">Jenis Kumpulan Wang</label>
                                    <input class="form-control form-control-sm" value="@Model.JKW.Kod - @Model.JKW.Perihal " readonly />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label asp-for="Tarikh" class="control-label"></label>
                                    <input class="form-control form-control-sm" value="@Model.Tarikh.ToString("dd/MM/yyyy")" readonly />
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="control-label">No PO</label>
                                    <input class="form-control form-control-sm" value="@Model.NoPO" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="AkNotaMintaId" class="control-label"></label>
                                    <select class="form-control form-control-sm select2" asp-for="AkNotaMintaId" id="ddlNotaMinta" disabled>
                                        <option value="" hidden>-- Pilih Nota Minta --</option>
                                        @foreach (var s in ViewBag.AkNotaMinta)
                                        {
                                            <option value="@s.Id">@s.NoSiri - @s.NoRujukan </option>
                                        }
                                    </select>
                                </div>
                            </div>
                            @*<div class="col-md-3">
                                    <div class="form-group">
                                        <label class="control-label">Kod Bank</label>
                                        <input class="form-control form-control-sm" value="@Model.AkBank.Kod - @Model.AkBank.JBank.Nama " readonly />
                                    </div>
                                </div>*@
                        </div>
                        <div class="form-row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="control-label">No Pembekal</label>
                                    <input class="form-control form-control-sm" value="@Model.AkPembekal.KodSykt" readonly />
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-group">
                                    <label class="control-label">Nama Pembekal</label>
                                    <input class="form-control form-control-sm text-uppercase" value="@Model.AkPembekal.NamaSykt" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label">Alamat</label>
                            <input class="form-control form-control-sm text-uppercase" value="@Model.AkPembekal.Alamat1 " readonly />
                        </div>
                        <div class="form-group">
                            <input class="form-control form-control-sm text-uppercase" value="@Model.AkPembekal.Alamat2 " readonly />
                        </div>
                        <div class="form-group">
                            <input class="form-control form-control-sm text-uppercase" value="@Model.AkPembekal.Alamat3 " readonly />
                        </div>
                        <div class="form-row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label">Poskod</label>
                                    <input class="form-control form-control-sm" value="@Model.AkPembekal.Poskod " readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label">Bandar</label>
                                    <input class="form-control form-control-sm text-uppercase" value="@Model.AkPembekal.Bandar " readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label">Tel</label>
                                    <input class="form-control form-control-sm" value="@Model.AkPembekal.Telefon1 " readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label">Emel</label>
                                    <input class="form-control form-control-sm" value="@Model.AkPembekal.Emel " readonly />
                                </div>
                            </div>
                            @*<div class="col-md-4">
                                    <div class="form-group">
                                        <label class="control-label">Negeri</label>
                                        <input class="form-control form-control-sm" value="@Model.JNegeri.Kod - @Model.JNegeri.Perihal" readonly />
                                    </div>
                                </div>*@
                        </div>
                    </div>
                    <div class="col-lg-2">

                        @*<div class="card mb-2">
                                <div class="card-body p-1">
                                    <div class="form-group col-sm">
                                        <label asp-for="FlCetak" class="control-label"></label>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlCetak" type="radio" id="FlCetak1" name="FlCetak" class="custom-control-input" value="0" checked>
                                            <label class="custom-control-label" for="FlCetak1">Belum</label>
                                        </div>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlCetak" type="radio" id="FlCetak2" name="FlCetak" class="custom-control-input" value="1">
                                            <label class="custom-control-label" for="FlCetak">Sudah</label>
                                        </div>
                                    </div>
                                </div>
                            </div>*@
                        <div class="card mb-2">
                            <div class="card-body p-1">
                                <div class="form-group col-sm">
                                    <label asp-for="FlPosting" class="control-label"></label>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlPosting" type="radio" id="FlPosting1" name="FlPosting" class="custom-control-input" value="0" checked>
                                        <label class="custom-control-label" for="FlPosting">Belum</label>
                                    </div>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlPosting" type="radio" id="FlPosting2" name="FlPosting" class="custom-control-input" value="1">
                                        <label class="custom-control-label" for="FlPosting">Sudah</label>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="card mb-2">
                            <div class="card-body p-1">
                                <div class="form-group col-sm">
                                    <label asp-for="FlHapus" class="control-label"></label>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlHapus" type="radio" id="FlHapus1" name="FlHapus" class="custom-control-input" value="0" checked>
                                        <label class="custom-control-label" for="FlHapus">Tidak</label>
                                    </div>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="FlHapus" type="radio" id="FlHapus1" name="FlHapus" class="custom-control-input" value="1">
                                        <label class="custom-control-label" for="FlHapus">Ya</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                @*table Objek*@
                <div class="card box-shadow mb-3">
                    <div class="card-header">
                        <h6>Objek</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">

                            <table id="tblObjek" class="table table-sm" cellpadding="0" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th style="width:40%">Kod</th>
                                        <th style="width:50%" class="text-right">Amaun</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyObjek">
                                    @foreach (var item in ViewBag.akPO1)
                                    {
                                        <tr id="@item.Id">
                                            <td id="akCartaId" hidden>@item.AkCartaId</td>
                                            <td>@item.AkCarta.Kod - @item.AkCarta.Perihal</td>
                                            <td class="editable-txt text-right" id="td1Amaun">@item.Amaun</td>
                                        </tr>

                                    }
                                </tbody>
                                <tfoot>

                                </tfoot>
                            </table>

                        </div>
                    </div>
                </div>
                @*table Objek end*@

                @*table urusniaga*@
                <div class="card box-shadow mb-3">
                    <div class="card-header">
                        <h6>Urusniaga</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="tblUrusniaga" class="table table-sm" cellpadding="0" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th class="text-left">Bil</th>
                                        <th class="text-left">No Stok</th>
                                        <th class="text-left">Perihal</th>
                                        <th class="text-right">Kuantiti</th>
                                        <th class="text-center">Unit</th>
                                        <th class="text-right">Harga RM/Unit</th>
                                        <th class="text-right">Amaun RM</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyPerihal">
                                    @foreach (var item in ViewBag.akPO2)
                                    {
                                        <tr>
                                            <td class="text-left">@item.Bil</td>
                                            <td class="text-left">@item.NoStok</td>
                                            <td class="text-left text-uppercase">@item.Perihal</td>
                                            <td class="text-right">@item.Kuantiti</td>
                                            <td class="text-center text-uppercase">@item.Unit</td>
                                            <td class="text-right">@item.Harga</td>
                                            <td class="text-right">@item.Amaun</td>
                                        </tr>

                                    }
                                </tbody>
                                <tfoot>

                                </tfoot>
                            </table>
                        </div>


                    </div>
                </div>
                @*table perihal end*@
            </div>

        </div>
    </div>

</div>

<div>
    @if (Model.FlHapus == 0)
    {
        @if (Model.FlPosting == 1)
        {
        }
        else
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Ubah</a>

            @*<button type="button" class="btn btn-warning btn-sm" data-toggle="modal" data-target="#modalBatal">
                    Batal
                </button>*@
        }
    }
    <a asp-action="Index">Kembali ke Indeks</a>
</div>

<!-- Modal Batal -->
<div class="modal fade" id="modalBatal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-md modal-dialog modal-dialog-centered">
        <div class="modal-content ">
            <div class="modal-header bg-warning text-white">

                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i>  Batal</h5>

                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times text-white"></i>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-center">Anda pasti untuk meneruskan operasi ini?</p>
                <div class="form-row">
                    <div class="col-6 mb-2">
                        <a asp-action="Cancel" asp-route-id="@Model.Id" class="btn btn-danger btn-block btn-lg ">YA</a>
                    </div>
                    <div class="col-6">
                        <a data-dismiss="modal" aria-label="Close" class=" btn btn-secondary btn-block btn-lg text-white">TIDAK</a>
                    </div>


                </div>
            </div>
            <div class="modal-footer" style="padding:0px;">


            </div>
        </div>
    </div>
</div>
<!-- Modal Batal End -->