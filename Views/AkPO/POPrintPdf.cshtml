@model MSNK.Models.Modules.PrintModel.POPrintModel

@{
    ViewData["Title"] = "Cetakan Pesanan Tempatan";
    Layout = "~/Views/Shared/_PrintLayout.cshtml";
}
<style>
    .flexrow {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex !important;
    }

        .flexrow > div {
            -webkit-box-flex: 1;
            -webkit-flex: 1;
            flex: 1;
        }

    .image-container {
        width: 80px;
        height: 80px;
        text-align: center;
    }

        .image-container img {
            height: 100%;
        }

    h1 {
        font-size: 1.5rem;
    }

    h2 {
        font-size: 1.3rem;
    }

    h3 {
        font-size: 1.2rem;
    }

    h4 {
        font-size: 1.1rem;
    }

    h5 {
        font-size: 1rem;
    }

    h6 {
        font-size: 0.8rem;
    }

    p {
        font-size: 0.6rem;
    }

    .topic tr {
        line-height: 0.5rem;
    }

    .center {
        padding: 70px 0;
        border: 3px solid green;
        text-align: center;
    }

    .notbold {
        font-weight: normal
    }

    table tbody tr td {
        font-size: 0.8rem;
        line-height: 1.0rem;
    }

    table thead tr th {
        font-size: 0.8rem;
        line-height: 1.0rem;
    }

    .breakhere {
        page-break-after: always
    }
</style>
<div class="row flexrow mb-1 ml-1">
    <div class="col-2 image-container">
        <img src="~/img/MainLogo_Syarikat.png" alt="Logo syarikat" />
    </div>
    <div class="col-8 text-uppercase">
        <h5 class="mb-1"><strong>@Model.CompanyDetail.NamaSyarikat</strong></h5>
        <p class="mb-0"> @Model.CompanyDetail.AlamatSyarikat1 , @Model.CompanyDetail.AlamatSyarikat2</p>
        <p class="mb-0"> @Model.CompanyDetail.AlamatSyarikat3</p>
        <p class="mb-0"> Tel: @Model.CompanyDetail.TelSyarikat   Faks: @Model.CompanyDetail.FaksSyarikat</p>
    </div>

    <div class="col-2 text-right">
        <h6 class="mb-0"><strong>PESANAN TEMPATAN</strong></h6>
        @*<h6 class="mb-0">NO PO:</h6>
            <h6 class="mb-0 ">@Model.AkPO.NoPO</h6>
            <h6 class="mb-0">TARIKH PESANAN TEMPATAN: @Html.DisplayFor(x => x.AkPO.Tarikh, "{0:dd/MM/yyyy}")</h6>*@
    </div>
</div>
<div class="row flexrow mb-1">
    <div class="col-8 text-center text-uppercase">
        <h5 class="mb-1"><strong>Tahun Kewangan @Model.AkPO.Tahun</strong></h5>
    </div>
</div>
<div class="table-responsive-sm mb-0">
    <table class="table table-bordered table-sm topic">
        <tbody>
            <tr>
                <td class="text-center text-uppercase font-weight-bold" width="15%">No Pesanan Tempatan</td>
                <td class="text-center text-uppercase font-weight-bold" width="15%">Tarikh</td>
                <td class="text-center text-uppercase font-weight-bold" width="15%">Kumpulan Wang </td>
            </tr>
            <tr>
                <td class="text-center">@Model.AkPO.NoPO</td>
                <td class="text-center" width="15%">@Convert.ToDateTime(Model.AkPO.Tarikh).ToString("dd/MM/yyyy")</td>
                <td class="text-center">@Model.AkPO.JKW.Kod - @Model.AkPO.JKW.Perihal</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="table-responsive-sm">
    <table class="table table-sm topic table-bordered">
        <thead class="table-dark">

        </thead>
        <tbody>
            <tr class="bg-dark text-white font-weight-bold">
                <td class="text-center" style="font-size:0.8rem;" colspan="2"><strong>MAKLUMAT PEMBEKAL</strong></td>
            </tr>
            <tr>
                <td class="text-left" width="15%">KOD SYARIKAT</td>
                <td class="text-left">@Model.AkPO.AkPembekal.KodSykt</td>
            </tr>
            <tr>
                <td class="text-left" width="15%" rowspan="4">PEMBEKAL</td>
                <td class="text-left">@Model.AkPO.AkPembekal.NamaSykt</td>
            </tr>
            <tr>
                <td class="text-left">@Model.AkPO.AkPembekal.Alamat1</td>
            </tr>
            <tr>
                <td class="text-left">@Model.AkPO.AkPembekal.Alamat2</td>
            </tr>
            <tr>
                <td class="text-left">@Model.AkPO.AkPembekal.Alamat3</td>
            </tr>
            <tr>
                <td class="text-left">Nama Bank</td>
                <td class="text-left">@Model.AkPO.AkPembekal.JBank.Nama</td>
            </tr>
            <tr>
                <td class="text-left">No Akaun Bank</td>
                <td class="text-left">@Model.AkPO.AkPembekal.AkaunBank</td>
            </tr>
        </tbody>
    </table>
</div>
<div class="table-responsive-sm mb-0">
    <table class="table table-bordered table-sm topic">
        <thead class="text-center">
            <tr>
                <th>KOD</th>
                <th>OBJEK</th>
                <th>AMAUN</th>
            </tr>
        </thead>

        @foreach (var item in Model.AkPO.AkPO1)
        {

            <tr>
                <td>@item.AkCarta.Kod</td>
                <td>@item.AkCarta.Perihal</td>
                <td align="right">@Convert.ToDecimal(item.Amaun).ToString("#,##0.00")</td>
            </tr>
            @*<tr class="bg-light">
                    <td class="text-right">JUMLAH OBJEK (RM)</td>
                    <td class="text-right">@Convert.ToDecimal(@Model.AkPO.Jumlah).ToString("#,##0.00")</td>
                </tr>*@
        }
        <tr class="font-weight-bold">
            <td class="text-right" colspan="2">Jumlah RM</td>
            <td class="text-right">@Convert.ToDecimal(Model.AkPO.Jumlah).ToString("#,##0.00")</td>
        </tr>
        <tfoot>

        </tfoot>
    </table>
</div>

<div class="table-responsive-sm mb-0">
    <table class="table table-bordered table-sm topic">
        <thead class="text-center">
            <tr>
                <th colspan="7">PERIHAL</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="text-center">BIL</td>
                <td class="text-center">NO STOK</td>
                <td class="text-center">PERIHAL</td>
                <td class="text-center">KUANTITI</td>
                <td class="text-center">UNIT</td>
                <td class="text-center">HARGA/UNIT</td>
                <td class="text-center">AMAUN</td>
            </tr>
            @foreach (var item in Model.AkPO.AkPO2)
            {

                <tr>
                    <td>@item.Bil</td>
                    <td>@item.NoStok</td>
                    <td>@item.Perihal</td>
                    <td align="right">@item.Kuantiti</td>
                    <td align="right">@item.Unit</td>
                    <td align="right">@item.Harga</td>
                    <td align="right">@item.Amaun</td>
                </tr>

            }
            <tr class="font-weight-bold">
                <td class="text-right" colspan="6">Jumlah RM</td>
                <td class="text-right">@Convert.ToDecimal(Model.AkPO.Jumlah).ToString("#,##0.00")</td>
            </tr>
        </tbody>
        <tfoot>

        </tfoot>
    </table>
</div>

<div class="table-responsive-sm mb-0">
    <table class="table table-bordered table-sm topic">
        <tbody>
            <tr>
                <td class="text-right" style="line-height:1.0rem;">AMAUN DALAM PERKATAAN</td>
                <td class="text-left" style="line-height:0.8rem;">@Model.JumlahDalamPerkataan</td>
            </tr>
        </tbody>
        <tfoot>

        </tfoot>
    </table>
</div>

<div class="table-responsive-sm">
    <table class="table table-sm topic table-bordered">
        <thead class="table-dark">

        </thead>
        <tbody>
            <tr class="bg-dark text-white font-weight-bold">

                <td class="text-center" colspan="3"><h6 class="mb-0"><strong>UNTUK KEGUNAAN BAHAGIAN KEWANGAN</strong></h6></td>
            </tr>
            <tr>
                <td class="text-center">Disedia </td>
                <td class="text-center">Disemak </td>
                <td class="text-center">Diluluskan </td>
            </tr>
            <tr>
                <td class="text-center" height="50px"></td>
                <td class="text-center" height="50px"></td>
                <td class="text-center" height="50px"></td>

            </tr>
            <tr>
                <td class="text-left">Nama:</td>
                <td class="text-left">Nama:</td>
                <td class="text-left">Nama:</td>
                                
            </tr>               
            <tr>                
                <td class="text-left">Jawatan:</td>
                <td class="text-left">Jawatan:</td>
                <td class="text-left">Jawatan:</td>

            </tr>
            <tr>
                <td class="text-left">Tarikh:</td>
                <td class="text-left">Tarikh:</td>
                <td class="text-left">Tarikh:</td>
            </tr>
        </tbody>
    </table>
</div>