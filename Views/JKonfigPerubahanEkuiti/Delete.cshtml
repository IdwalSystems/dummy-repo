@model JKonfigPerubahanEkuiti

@{
    ViewData["Title"] = "Konfigurasi Perubahan Ekuiti - Hapus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card box-shadow">
    <div class="card-body">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase text-danger mb-0">@ViewData["Title"]</h5>
                <span class="ac-ref"><a asp-action="Index" class="text-secondary">Indeks</a> / Hapus</span>
            </div>
            <div class="col-4">
                <a asp-action="Index" class="text-secondary float-right"><i class="fas fa-times fa-2x"></i></a>
            </div>

        </div>
        <hr class="mt-2" />

        <p class="text-danger">Anda pasti untuk menghapuskan maklumat berikut?</p>
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.EnLajurJadual)
            </dt>
            <dd class="col-sm-10">
                @Model.EnLajurJadual.GetDisplayName()
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.JKWId)
            </dt>
            <dd class="col-sm-10">
                @Model.JKW?.Kod - @Model.JKW?.Perihal
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Tahun)
            </dt>
            <dd class="col-sm-10">
                @Model.Tahun
            </dd>
        </dl>
        <hr />
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input name="syscode" value="SPPB" hidden />
            <input type="submit" value="Hapus" class="btn ac-danger btn-sm" />
            <a asp-action="Index" class="btn ac-secondary btn-sm" style="width:auto">Batal</a>
        </form>
    </div>
</div>
