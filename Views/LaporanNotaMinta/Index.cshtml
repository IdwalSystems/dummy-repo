@model MSNK.Models.Modules.FormModel.ReportFormModel

@{
    ViewData["Title"] = "LPN001 Laporan Daftar Bil / Nota Minta";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string monthYear = DateTime.Now.ToString("yyyy-MM");
}
<script>
    //add tbl objek
    $("body").on("click", "#btnExportExcel", function () {
        //$(".loading").prop('hidden', false);
        $(".loading").css("display", "");
        $("#btnExportExcel").prop('disabled', true);
        var kodLaporan = "";
        if ($('#LPN00101').is(':checked')) {
            kodLaporan = "LPN00101";
        }
        else {
            kodLaporan = "LPN00102";
        }
        var JKWId = $('#JKWId').val();
        var JBahagianId = $('#JBahagianId').val();
        var bulanTahun = $('#bulanTahun').val();
        var status = $('#status').val();
        var susunan = $('#susunan').val();
        var AkBankId = $('#AkBankId').val();

        var param = {
            JKWId : JKWId,
            JBahagianId : JBahagianId,
            bulanTahun : bulanTahun,
            status : status,
            susunan : susunan,
            AkBankId : AkBankId
        }
        var myData = {};
        myData.kodLaporan = kodLaporan;
        myData.param = param;

        if (kodLaporan != "") {
            $.ajax({
                type: "POST",
                url: '@Url.Action("ExportExcel","LaporanNotaMinta")',
                data: myData,
                dataType: "json",
                success: function (r) {
                    window.location = "@Url.Action("Download","Profile")?fileGuid=" + r.fileGuid
                        + "&filename=" + r.fileName;
                    //window.location = '/Profile/Download?fileGuid=' + r.fileGuid
                    //    + '&filename=' + r.fileName;
                    toastr.success("laporan berjaya dijana.", "Berjaya");
                    toastr.options.timeOut = 2000; // 2s
                    $("#btnExportExcel").prop('disabled', false);
                    $(".loading").css("display", "none");
                }
            })
        }

        //$(".loading").prop('hidden', true);

    });
</script>
<div class="container">
    <div class="card box-shadow">
        <div class="card-body">
            <div class="row">
                <div class="col-8">
                    <h5 class="text-uppercase text-info mb-0">@ViewData["Title"]</h5>
                    <span class="ac-ref">Indeks</span>
                </div>
                <div class="col-4 text-right">
                </div>
    
            </div>
            <hr class="mt-2"/>
            <form asp-action="PRINT">

                        <div class="card mb-2">
                            <div class="card-body">
                                <div class="form-group col-sm">

                                    <div class="custom-control custom-radio pb-2">

                                        <input class="custom-control-input" type="radio" name="kodLaporan" id="LPN00101" value="LPN00101" checked>
                                        <label class="custom-control-label" for="LPN00101">
                                            01 - Laporan Daftar Bil Mengikut Bulan &amp; Tahun
                                        </label>
                                    </div>
                                    <div class="custom-control custom-radio" hidden>

                                        <input class="custom-control-input" type="radio" name="kodLaporan" id="LPN00102" value="LPN00102">
                                        <label class="custom-control-label" for="LPN00102">
                                            02 - Laporan Daftar Bil Dengan Nota Minta
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-body">
                                <div class="form-group form-row">
                                    <label asp-for="JKWId" class="col-sm-2 col-form-label"></label>
                                    <div class="col-sm-5">
                                        <select class="form-control form-control-sm text-uppercase" asp-for="JKWId" id="ddlKW">
                                            @foreach (var s in ViewBag.JKW)
                                            {
                                                <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group form-row" hidden>
                                    <label asp-for="JBahagianId" class="col-sm-2 col-form-label"></label>
                                    <div class="col-sm-5">
                                        <select class="form-control form-control-sm text-uppercase" asp-for="JBahagianId" id="ddlBahagian">
                                            @foreach (var s in ViewBag.JBahagian)
                                            {
                                                <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group form-row">
                                    <label asp-for="bulanTahun" class="col-sm-2 col-form-label"></label>
                                    <div class="col-sm-5">
                                        <input type="month" class="form-control form-control-sm"  asp-for="bulanTahun" value="@monthYear">
                                    </div>
                                </div>
                                <div class="form-group form-row">
                                    <label asp-for="status" class="col-sm-2 col-form-label"></label>
                                    <div class="col-sm-5">
                                        <select class="form-control form-control-sm input-group-sm" asp-for="status" required>
                                            <option value="0">SEMUA</option>
                                            <option value="1">BELUM POSTING</option>
                                            <option value="2">SUDAH POSTING</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group form-row">
                                    <label asp-for="susunan" class="col-sm-2 col-form-label"></label>
                                    <div class="col-sm-5">
                                        <select class="form-control form-control-sm input-group-sm" asp-for="susunan" required>
                                            <option value="0">TARIKH</option>
                                            <option value="1" selected>NO SIRI</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr />
                        <div class="form-group text-right">
                            <input type="submit" value="Cetak" formtarget="_blank" class="btn ac-primary" />
                            <button type="button" formtarget="_blank" id="btnExportExcel" class="btn ac-info">Jana Excel</button>
                            <span class="loading" style="padding-right:3px; padding-top: 3px; display:inline-block;">
                                <img src="~/img/Spinner.gif" style="height:40px;">
                            </span>
                        </div>

            </form>
        </div>
    </div>


</div>
