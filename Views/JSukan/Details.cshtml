@model MSNK.Models.Modules.JSukan

@{
    ViewData["Title"] = "Papar";
}

<div>
    <h4>Sukan - Papar</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Perihal)
        </dt>
        <dd class = "col-sm-10 text-uppercase">
            @Model.Perihal
        </dd>
        <dt class = "col-sm-2">
            Jenis Sukan
        </dt>
        @if(Model.IsElit == true && Model.IsPembangunan == false)
        {
          <dd class = "col-sm-10 text-uppercase">
            Elit
        </dd>  
        }
        @if(Model.IsElit == false  && Model.IsPembangunan == true)
        {
          <dd class = "col-sm-10 text-uppercase">
            Pembangunan
        </dd>  
        }
        @if(Model.IsElit == true  && Model.IsPembangunan == true)
        {
          <dd class = "col-sm-10 text-uppercase">
            Elit Dan Pembangunan
        </dd>  
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Ubah</a> |
    <a asp-action="Index">Kembali ke Indeks</a>
</div>
