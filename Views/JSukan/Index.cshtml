@model IEnumerable<MSNK.Models.Modules.JSukan>

@{
    ViewData["Title"] = "Index";
}

<h1>Senarai</h1>

<p>
    <a asp-action="Create">Tambah Baru</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Perihal)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Perihal)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Ubah</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Papar</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Hapus</a>
            </td>
        </tr>
}
    </tbody>
</table>
