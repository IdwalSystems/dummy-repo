@model MSNK.Models.Modules.AkTunaiCV

@{
    ViewData["Title"] = "Ubah";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_JSEdit" />

<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit" class="needs-validation">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="card box-shadow border-primary mb-3">
                <div class="card-header bg-primary text-white">
                    <h5>Tunai Keluar - @ViewData["Title"]</h5>
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Tarikh" class="control-label"></label><span class="text-danger control-label">*</span>
                                <input asp-for="Tarikh" class="form-control form-control-sm" readonly />
                                <span asp-validation-for="Tarikh" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Tahun" class="control-label"></label><span class="text-danger control-label">*</span>
                                <input asp-for="Tahun" class="form-control form-control-sm form-control-sm-custom" id="txtTahun" readonly />
                                <span asp-validation-for="Tahun" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="AkTunaiRuncitId" class="control-label"></label><span class="text-danger control-label">*</span>
                                <select class="form-control form-control-sm" asp-for="AkTunaiRuncitId" disabled id="ddlTunaiRuncit">
                                    @foreach (var s in ViewBag.AkTunaiRuncit)
                                    {
                                        <option value="@s.Id">@s.KaunterPanjar (@s.AkCarta.Kod - @s.AkCarta.Perihal )</option>
                                    }
                                </select>
                                <span asp-validation-for="AkTunaiRuncitId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="NoCV" class="control-label"></label>
                                <input id="txtNoRujukan" value="@Model.NoCV.Substring(3)" class="form-control form-control-sm" readonly />
                                <span asp-validation-for="NoCV" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    @switch (Model.KategoriPenerima)
                    {
                        case 1:
                            <div class="form-row">
                                <div class="col-md-6">
                                    <label asp-for="SuPekerjaId" class="control-label"></label>
                                    <select class="form-control form-control-sm select2" asp-for="SuPekerjaId" id="ddlKodPekerja" disabled>
                                        <option value="0" selected>-- Pilih Kod Pekerja --</option>
                                        @foreach (var s in ViewBag.SuPekerja)
                                        {
                                            <option value="@s.Id">@s.NoGaji - @s.Nama</option>
                                        }
                                    </select>
                                    <span asp-validation-for="SuPekerjaId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="AkPembekalId" class="control-label"></label>
                                    <select class="form-control form-control-sm select2" asp-for="AkPembekalId" id="ddlKodPembekal">
                                        <option value="0" selected>-- Pilih Kod Pembekal --</option>
                                        @foreach (var s in ViewBag.AkPembekal)
                                        {
                                            <option value="@s.Id">@s.KodSykt - @s.NamaSykt</option>
                                        }
                                    </select>
                                    <span asp-validation-for="AkPembekalId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="col-md-12">
                                    <label asp-for="Penerima" class="control-label"></label><span class="text-danger control-label">*</span>
                                    <input asp-for="Penerima" class="form-control form-control-sm text-uppercase" required disabled />
                                </div>
                            </div>
                            <div class="form-group">
                                <label asp-for="Alamat1" class="control-label">Alamat</label>
                                <input asp-for="Alamat1" class="form-control form-control-sm text-uppercase" id="txtAlamat1" disabled />
                                <span asp-validation-for="Alamat1" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <input asp-for="Alamat2" class="form-control form-control-sm text-uppercase" id="txtAlamat2" disabled />
                                <span asp-validation-for="Alamat2" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <input asp-for="Alamat3" class="form-control form-control-sm text-uppercase" id="txtAlamat3" disabled />
                                <span asp-validation-for="Alamat3" class="text-danger"></span>
                            </div>
                            break;
                        case 2:
                            <div class="form-row">
                                <div class="col-md-6">
                                    <label asp-for="SuPekerjaId" class="control-label"></label>
                                    <select class="form-control form-control-sm select2" asp-for="SuPekerjaId" id="ddlKodPekerja">
                                        <option value="0" selected>-- Pilih Kod Pekerja --</option>
                                        @foreach (var s in ViewBag.SuPekerja)
                                        {
                                            <option value="@s.Id">@s.NoGaji - @s.Nama</option>
                                        }
                                    </select>
                                    <span asp-validation-for="SuPekerjaId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="AkPembekalId" class="control-label"></label>
                                    <select class="form-control form-control-sm select2" asp-for="AkPembekalId" id="ddlKodPembekal" disabled>
                                        <option value="0" selected>-- Pilih Kod Pembekal --</option>
                                        @foreach (var s in ViewBag.AkPembekal)
                                        {
                                            <option value="@s.Id">@s.KodSykt - @s.NamaSykt</option>
                                        }
                                    </select>
                                    <span asp-validation-for="AkPembekalId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="col-md-12">
                                    <label asp-for="Penerima" class="control-label"></label><span class="text-danger control-label">*</span>
                                    <input asp-for="Penerima" class="form-control form-control-sm text-uppercase" required disabled />
                                </div>
                            </div>
                            <div class="form-group">
                                <label asp-for="Alamat1" class="control-label">Alamat</label>
                                <input asp-for="Alamat1" class="form-control form-control-sm text-uppercase" id="txtAlamat1" disabled />
                                <span asp-validation-for="Alamat1" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <input asp-for="Alamat2" class="form-control form-control-sm text-uppercase" id="txtAlamat2" disabled />
                                <span asp-validation-for="Alamat2" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <input asp-for="Alamat3" class="form-control form-control-sm text-uppercase" id="txtAlamat3" disabled />
                                <span asp-validation-for="Alamat3" class="text-danger"></span>
                            </div>
                            break;
                        default:
                            <div class="form-row">
                                <div class="col-md-6">
                                    <label asp-for="SuPekerjaId" class="control-label"></label>
                                    <select class="form-control form-control-sm select2" asp-for="SuPekerjaId" id="ddlKodPekerja">
                                        <option value="0" selected>-- Pilih Kod Pekerja --</option>
                                        @foreach (var s in ViewBag.SuPekerja)
                                        {
                                            <option value="@s.Id">@s.NoGaji - @s.Nama</option>
                                        }
                                    </select>
                                    <span asp-validation-for="SuPekerjaId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="AkPembekalId" class="control-label"></label>
                                    <select class="form-control form-control-sm select2" asp-for="AkPembekalId" id="ddlKodPembekal">
                                        <option value="0" selected>-- Pilih Kod Pembekal --</option>
                                        @foreach (var s in ViewBag.AkPembekal)
                                        {
                                            <option value="@s.Id">@s.KodSykt - @s.NamaSykt</option>
                                        }
                                    </select>
                                    <span asp-validation-for="AkPembekalId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="col-md-12">
                                    <label asp-for="Penerima" class="control-label"></label><span class="text-danger control-label">*</span>
                                    <input asp-for="Penerima" class="form-control form-control-sm text-uppercase" required />
                                </div>
                            </div>
                            <div class="form-group">
                                <label asp-for="Alamat1" class="control-label">Alamat</label>
                                <input asp-for="Alamat1" class="form-control form-control-sm text-uppercase" id="txtAlamat1" />
                                <span asp-validation-for="Alamat1" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <input asp-for="Alamat2" class="form-control form-control-sm text-uppercase" id="txtAlamat2" />
                                <span asp-validation-for="Alamat2" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <input asp-for="Alamat3" class="form-control form-control-sm text-uppercase" id="txtAlamat3" />
                                <span asp-validation-for="Alamat3" class="text-danger"></span>
                            </div>
                            break;
                    }

                    <div class="form-group">
                        <label asp-for="Catatan" class="control-label"></label>
                        <textarea asp-for="Catatan" class="form-control form-control-sm text-uppercase" rows="2"></textarea>
                        <span asp-validation-for="Catatan" class="text-danger"></span>
                    </div>
                    @*hidden values*@
                    <div hidden>
                        @*hidden type input*@
                        <div class="form-group">
                            <label asp-for="NoCV" class="control-label"></label>
                            <input id="noRujukan" asp-for="NoCV" class="form-control form-control-sm" readonly />
                            <span asp-validation-for="NoCV" class="text-danger"></span>
                        </div>

                        <div class="col-lg-2 pb-3">
                            <div class="card mb-2">
                                <div class="card-body p-1">

                                    <div class="form-group col-sm">
                                        <label class="control-label">Jenis Baucer</label>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="KategoriPenerima" type="radio" id="KategoriPenerima1" name="KategoriPenerima" class="custom-control-input" value="0" checked>
                                            <label class="custom-control-label" for="KategoriPenerima1">Am</label>
                                        </div>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="KategoriPenerima" type="radio" id="KategoriPenerima2" name="KategoriPenerima" class="custom-control-input" value="1">
                                            <label class="custom-control-label" for="KategoriPenerima2">Pembekal</label>
                                        </div>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="KategoriPenerima" type="radio" id="KategoriPenerima3" name="KategoriPenerima" class="custom-control-input" value="2">
                                            <label class="custom-control-label" for="KategoriPenerima3">Pekerja</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card mb-2">
                                <div class="card-body p-1">
                                    <div class="form-group col-sm">
                                        <label class="control-label">Cetak</label>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlCetak" type="radio" id="FlCetak1" name="FlCetak" class="custom-control-input" value="0" checked>
                                            <label class="custom-control-label" for="FlCetak1">Belum</label>
                                        </div>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlCetak" type="radio" id="FlCetak2" name="FlCetak" class="custom-control-input" value="1">
                                            <label class="custom-control-label" for="FlCetak2">Sudah</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card mb-2">
                                <div class="card-body p-1">
                                    <div class="form-group col-sm">
                                        <label class="control-label">Posting</label>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlPosting" type="radio" id="FlPosting1" name="FlPosting" class="custom-control-input" value="0" checked>
                                            <label class="custom-control-label" for="FlPosting">Belum</label>
                                        </div>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlPosting" type="radio" id="FlPosting2" name="FlPosting" class="custom-control-input" value="1">
                                            <label class="custom-control-label" for="FlPosting">Sudah</label>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="card mb-2">
                                <div class="card-body p-1">
                                    <div class="form-group col-sm">
                                        <label class="control-label">Batal</label>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlHapus" type="radio" id="FlHapus1" name="FlHapus" class="custom-control-input" value="0" checked>
                                            <label class="custom-control-label" for="FlHapus">Tidak</label>
                                        </div>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlHapus" type="radio" id="FlHapus1" name="FlHapus" class="custom-control-input" value="1">
                                            <label class="custom-control-label" for="FlHapus">Ya</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <br />
                    @*table Objek*@
                    <div class="card box-shadow mb-3 mt-2">
                        <div class="card-header">
                            <h6>Objek</h6>
                        </div>
                        <div class="card-body">
                            <table id="tblObjek" class="table table-sm nowrap" cellpadding="0" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th style="width:70%">Kod</th>
                                        <th style="width:30%">Amaun</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyObjek">
                                    @foreach (var item in ViewBag.akTunaiCV1)
                                    {
                                        <tr id="@item.Id">
                                            <td id="akCartaId" hidden>@item.AkCartaId</td>
                                            <td class="text-left">@item.AkCarta.Kod - @item.AkCarta.Perihal</td>
                                            <td class="text-right" id="td1Amaun">@item.Amaun</td>
                                            <td>
                                                <button class="btn btn-primary btn-sm" type="button" id="btnUpdate1" data-toggle="modal" data-target="#modalObjek" onclick="Update1(this)">
                                                    <i class="fa fa-edit"></i>
                                                </button>
                                            </td>
                                            <td>
                                                <button class="btn btn-danger btn-sm" type="button" id="btnRemove1" onclick="Remove1(this)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td id="akCartaId" hidden></td>
                                        <td hidden><input id="txtAkPV1" value="@Model.Id" /></td>
                                        <td style="width:40%">
                                            <select class="form-control form-control-sm select2" id="txtKodAkaun">
                                                <option value="" disabled selected>-- Pilih Kod Akaun --</option>
                                                @foreach (var s in ViewBag.AkCarta)
                                                {
                                                    <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                                }
                                            </select>
                                        </td>
                                        <td style="width:50%"><input class="form-control form-control-sm" type="number" id="txtAmaunObjek" step="0.01" value="0.00"></td>
                                        <td><button class="btn btn-success btn-sm" type="button" id="btnAdd1"><i class="fas fa-plus"></i></button></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <div class="card-footer">
                            <div class="form-group pb-2">
                                <label asp-for="Jumlah" class="control-label">Jumlah Objek</label>
                                <input asp-for="Jumlah" class="form-control form-control-sm" id="jumlahObjek" readonly />
                                <span asp-validation-for="Jumlah" class="text-danger"></span>
                            </div>
                        </div>

                    </div>
                    @*table Objek end*@
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Simpan" class="btn btn-primary" />
            </div>
        </form>
    </div>

</div>
<div>
    <a asp-action="Index">Kembali Ke Indeks</a>
</div>

<!-- Modal Objek -->
<div class="modal fade bd-example-modal-lg" id="modalObjek" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Objek</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input id="moId1" hidden />
                    <div class="form-group">
                        <label class="col-form-label">Kod Akaun</label>
                        <select class="form-control form-control-sm" id="moKodAkaun" disabled>
                            <option value="" disabled selected>-- Pilih Kod Akaun --</option>
                            @foreach (var s in ViewBag.AkCarta)
                            {
                                <option value="@s.Id">@s.Kod - @s.Perihal </option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Amaun</label>
                        <input type="number" class="form-control form-control-sm" id="moAmaun1">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-dismiss="modal" onclick="modalUpdate1()">OK</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal Objek End -->