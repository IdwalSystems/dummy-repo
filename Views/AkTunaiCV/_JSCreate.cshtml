<script type="text/javascript">
     // onchange no Rujukan
    $("body").on('change', "#ddlTunaiRuncit , #txtTahun", function () {
        var kodKaunter = $("#ddlTunaiRuncit").val();
        var year = $("#txtTahun").val();
        if (kodKaunter != 0) {
            JsonKod(kodKaunter, year);
        }

    });

    function JsonKod(id, year) {
        $.ajax({
            type: "POST",
            //url: "/AkPV/JsonGetKod",
            url: '@Url.Action("JsonGetKod", "AkTunaiCV")',
            data: { data: id, year: year },
            dataType: "json",
            success: function (msg) {
                $("#txtNoRujukan").val(msg.record);
            },
            error: function (req, status, error) {
                alert(error);
            }
        });
    }
    // onchange no Rujukan end

    // on change jenis baucer
    $("body").on('change', ".KategoriPenerima", function () {
        $("#ddlKodPekerja").val(0).change();
        $("#ddlKodPembekal").val(0).change();
        switch ($(this).val()) {
            case "0":
                $("#divPembekal").prop('hidden', true);
                $("#divPekerja").prop('hidden', true);
                break;
            case "1":
                $("#divPembekal").removeAttr('hidden');
                $("#divPekerja").prop('hidden', true);
                break;
            case "2":
                $("#divPekerja").removeAttr('hidden');
                $("#divPembekal").prop('hidden', true);
                break;
        }

    });

        //on change jenis baucer end

    // onchange kod pembekal
    $("body").on('change', "#ddlKodPembekal", function () {
        var kodPembekal = $("#ddlKodPembekal").val();
        if (kodPembekal != 0) {
            JsonKodPembekal(kodPembekal);
            $("#Penerima").prop('required', false);
        } else {
            //enable field
            $("#Penerima").prop('disabled', false);
            $("#txtAlamat1").prop('disabled', false);
            $("#txtAlamat2").prop('disabled', false);
            $("#txtAlamat3").prop('disabled', false);
            $("#ddlKodPekerja").prop('disabled', false);

            //empty field
            $("#txtNoKP").val('');
            $("#Penerima").val('');
            $("#txtAlamat1").val('');
            $("#txtAlamat2").val('');
            $("#txtAlamat3").val('');

        }

    });

    function JsonKodPembekal(id) {
        if (id != null) {
            $.ajax({
                type: "POST",
                //url: "/AkPV/JsonGetPembekal",
                url: '@Url.Action("JsonGetPembekal", "AkTunaiCV")',
                data: { data: id },
                dataType: "json",
                success: function (msg) {
                    $("#Penerima").val(msg.record.namaSykt);
                    $("#txtAlamat1").val(msg.record.alamat1);
                    $("#txtAlamat2").val(msg.record.alamat2);
                    $("#txtAlamat3").val(msg.record.alamat3);
                    // disable fields
                    $("#Penerima").prop('disabled', true);
                    $("#txtAlamat1").prop('disabled', true);
                    $("#txtAlamat2").prop('disabled', true);
                    $("#txtAlamat3").prop('disabled', true);
                    $("#ddlKodPekerja").prop('disabled', true);
                    $("#ddlKodPekerja").val(0);
                },
                error: function (req, status, error) {
                    alert(error);
                }
            });
        }
    }
    //on change Kod Pembekal end

    // onchange kod Pekerja
    $("body").on('change', "#ddlKodPekerja", function () {
        var kodPekerja = $("#ddlKodPekerja").val();
        if (kodPekerja != 0) {
            JsonKodPekerja(kodPekerja);
            $("#Penerima").prop('required', false);
        } else {
            //enable field
            $("#Penerima").prop('disabled', false);
            $("#txtAlamat1").prop('disabled', false);
            $("#txtAlamat2").prop('disabled', false);
            $("#txtAlamat3").prop('disabled', false);
            $("#ddlKodPembekal").prop('disabled', false);

            //empty field
            $("#Penerima").val('');
            $("#txtAlamat1").val('');
            $("#txtAlamat2").val('');
            $("#txtAlamat3").val('');

        }
    });

    function JsonKodPekerja(id) {
        if (id != null) {
            $.ajax({
                type: "POST",
                //url: "/AkPV/JsonGetPekerja",
                url: '@Url.Action("JsonGetPekerja", "AkTunaiCV")',
                data: { data: id },
                dataType: "json",
                success: function (msg) {
                    $("#Penerima").val(msg.record.nama);
                    $("#txtAlamat1").val(msg.record.alamat1);
                    $("#txtAlamat2").val(msg.record.alamat2);
                    $("#txtAlamat3").val(msg.record.alamat3);
                    // disable fields
                    $("#Penerima").prop('disabled', true);
                    $("#txtAlamat1").prop('disabled', true);
                    $("#txtAlamat2").prop('disabled', true);
                    $("#txtAlamat3").prop('disabled', true);
                    $("#ddlKodPembekal").prop('disabled', true);
                    $("#ddlKodPembekal").val(0);
                },
                error: function (req, status, error) {
                    alert(error);
                }
            });
        }
    }
    //on change Kod Pembekal end

    //add tbl objek
    $("body").on("click", "#btnAdd1", function () {
        //Reference the Name and Country TextBoxes.
        var txtKodAkaun = $("#txtKodAkaun");
        if (txtKodAkaun.val() != null) {
            GetCarta(txtKodAkaun.val());
        }
    });

    function GetCarta(id) {
        var Objek = {
            Id: id
        }
        if (id != "") {
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                //url: "/AkPV/GetCarta",
                url: '@Url.Action("GetCarta", "AkTunaiCV")',
                data: Objek,
                dataType: "json",
                success: function (r) {
                    //Reference the TextBoxes.
                    var txtKodAkaun = $("#txtKodAkaun");
                    var txtAmaunObjek = $("#txtAmaunObjek");
                    var txtJumlah = $("#jumlahObjek");

                    //Sum value to Total text field
                    var sum = 0;
                    sum = parseFloat(txtAmaunObjek.val()) + parseFloat(txtJumlah.val());
                    txtJumlah.val(sum.toFixed(2));

                    //Get the reference of the Table's TBODY element.
                    var tBody = $("#tblObjek > TBODY")[0];
                    //Add Row.
                    var row = tBody.insertRow(-1);

                    //Add akCartaId cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(r.record.id);
                    cell.prop("hidden", !this.checked);

                    //Add kod cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(r.record.kod + ' - ' + r.record.perihal);

                    //Add amaun cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(parseFloat(txtAmaunObjek.val()).toFixed(2));
                    cell.addClass('text-right');

                    //Add Edit Button cell.
                    cell = $(row.insertCell(-1));

                    var btnUpdate1 = $("<button class='btn btn-primary btn-sm' type='button' id='btnUpdate1' onclick='Update1(this)'><i class='fas fa-edit'></i></button>");
                    cell.append(btnUpdate1);

                    //Add Button cell.
                    cell = $(row.insertCell(-1));
                    var btnRemove1 = $("<button class='btn btn-danger btn-sm' type='button' id='btnRemove1' onclick='Remove1(this)'><i class='fas fa-trash'></i></button>");
                    cell.append(btnRemove1);

                    var AkTunaiCV1 = {
                        AkCartaId: txtKodAkaun.val(),
                        Amaun: txtAmaunObjek.val()
                    }

                    $.ajax({
                        type: "POST",
                        //url: "/AkPV/SaveAkPV1",
                        url: '@Url.Action("SaveAkTunaiCV1", "AkTunaiCV")',
                        data: AkTunaiCV1,
                        dataType: "json",
                        success: function (r) {
                            //Clear the TextBoxes.
                            txtKodAkaun.val("").trigger('change');
                            txtAmaunObjek.val("0.00");

                        }
                    });

                    $("#txtKodAkaun option[value=" + txtKodAkaun.val() + "]").prop('disabled', true);

                }
            });
        }

    }
    //add tbl objek end

    //remove tbl objek
    function Remove1(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var name = $("TD", row).eq(0).html();
        var namaAkaun = $("TD", row).eq(1).html();
        var amaun = $("TD", row).eq(2).html();
        var txtJumlah = $("#jumlahObjek");
        if (confirm("Hapus kod Akaun : " + namaAkaun + " ?")) {
            //Get the reference of the Table.
            var table = $("#tblObjek")[0];

            //Sum value to Total text field
            var sum = 0;
            sum = parseFloat(txtJumlah.val()) - parseFloat(amaun);
            txtJumlah.val(sum.toFixed(2));

            var AkTunaiCV1 = {
                AkCartaId: name,
            }
            if (name != null) {
                $.ajax({
                    type: "POST",
                    //url: "/AkPV/RemoveAkPV1",
                    url: '@Url.Action("RemoveAkTunaiCV1", "AkTunaiCV")',
                    data: AkTunaiCV1,
                    dataType: "json",
                    success: function (r) {
                        //Delete the Table row using it's Index.
                        table.deleteRow(row[0].rowIndex);
                    }
                });
            }
            $("#txtKodAkaun option[value=" + name + "]").prop('disabled', false);

        }
    };
    //remove tbl objek end

    //update tbl objek
    function Update1(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var akCartaId = $("TD", row).eq(0).html();

        var AkTunaiCV1 = {
            AkCartaId: akCartaId
        }
        if (akCartaId != null) {
            $.ajax({
                type: "POST",
                //url: "/AkPV/GetAnItemCartAkPV1",
                url: '@Url.Action("GetAnItemCartAkTunaiCV1", "AkTunaiCV")',
                data: AkTunaiCV1,
                dataType: "json",
                success: function (r) {
                    //insert data in modal objek
                    $("#moId1").val(r.record.akCartaId);
                    $("#moKodAkaun").val(r.record.akCartaId);
                    $("#moAmaun1").val(r.record.amaun);

                    //show modal objek
                    $("#modalObjek").modal({ backdrop: 'static', keyboard: false });

                }
            });
        }
    };

    function modalUpdate1() {
        var id = $("#moId1").val();
        var amaun = $("#moAmaun1").val();
        var jumlah = $("#jumlahObjek");

        var AkTunaiCV1 = {
            akCartaId: id,
            Amaun: amaun
        }
        $.ajax({
            type: "POST",
            //url: "/AkPV/SaveCartAkPV1",
            url: '@Url.Action("SaveCartAkTunaiCV1", "AkTunaiCV")',
            data: AkTunaiCV1,
            dataType: "json",
            success: function (r) {
                //insert notification here

                $.ajax({
                    type: "POST",
                    //url: "/AkPV/GetAllItemCartAkPV1",
                    url: '@Url.Action("GetAllItemCartAkTunaiCV1", "AkTunaiCV")',
                    dataType: "json",
                    success: function (r) {

                        //refresh updated table objek
                        $("table tbody#tbodyObjek").empty();
                        var sum = 0;
                        if (r.record.length > 0) {
                            for (var i = 0; i < r.record.length; i++) {
                                var item1 = r.record[i];
                                var str = "<tr><td id='akCartaId' hidden>" + item1.akCartaId +
                                    "</td><td>" + item1.akCarta.kod + " - " + item1.akCarta.perihal +
                                    "</td><td class='text-right'>" + (item1.amaun).toFixed(2) +
                                    "</td><td>" +
                                    "<button class='btn btn-primary btn-sm' type='button' id='btnUpdate1' data-toggle='modal' data-target='#modalObjek' onclick='Update1(this)'><i class='fa fa-edit' ></i></button>" +
                                    "</td><td>" +
                                    "<button class='btn btn-danger btn-sm' type='button' id='btnRemove1' onclick='Remove1(this)'><i class='fas fa-trash' ></i></button>" +
                                    "</td><tr>";
                                $("table tbody#tbodyObjek").append(str);
                                sum += item1.amaun;
                            }
                        }

                        jumlah.val(sum.toFixed(2));
                    }
                });
            }
        });
    };
    //update tbl objek end

    //validation form
    (function () {
        'use strict';
        window.addEventListener('load', function () {
            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.getElementsByClassName('needs-validation');
            // Loop over them and prevent submission
            Array.prototype.filter.call(forms, function (form) {
                form.addEventListener('submit', function (event) {
                    if (form.checkValidity() === false) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        }, false);
    })();

    $(document).ready(function () {

        $.validator.setDefaults({
            errorElement: "span",
            errorClass: "help-block",
            //	validClass: 'stay',
            highlight: function (element, errorClass) {
                $(element).addClass(errorClass); //.removeClass(errorClass);
                $(element).closest('.form-group').removeClass('has-success').addClass('has-error');
            },
            unhighlight: function (element, errorClass) {
                $(element).removeClass(errorClass); //.addClass(validClass);
                $(element).closest('.form-group').removeClass('has-error').addClass('has-success');
            },

            errorPlacement: function (error, element) {
                if (element.parent('.input-group').length) {
                    error.insertAfter(element.parent());
                } else {
                    error.insertAfter(element);
                }

            },

        });
    });
    //validation form end
</script>