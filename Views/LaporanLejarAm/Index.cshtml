@model MSNK.Models.Modules.FormModel.ReportFormModel

@{
    ViewData["Title"] = "LPL001 Laporan Lejar Am";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int year = DateTime.Now.Year;
    DateTime firstDay = new DateTime(year, 1, 1);
    DateTime lastDay = new DateTime(year, 12, 31);
}
<script>
    //add tbl objek
    $("body").on("click", "#btnExportExcel", function () {
        //$(".loading").prop('hidden', false);
        $(".loading").css("display", "");
        $("#btnExportExcel").prop('disabled', true);
        var kodLaporan = "";
        if ($('#LPL00101').is(':checked')) {
            kodLaporan = "LPL00101";
        }
        else {
            kodLaporan = "";
        }
        var JKWId = $('#JKWId').val();
        var IdDari = $('#ddlCarta1').val();
        var IdHingga = $('#ddlCarta2').val();
        var tarikhDari = $('#tarikhDari').val();
        var tarikhHingga = $('#tarikhHingga').val();

        var model = {
            JKWId : JKWId,
            IdDari: IdDari,
            IdHingga: IdHingga,
            tarikhDari: tarikhDari,
            tarikhHingga: tarikhHingga
        }
        var myData = {};
        myData.kodLaporan = kodLaporan;
        myData.model = model;

        if (kodLaporan != "") {
            $.ajax({
                type: "POST",
                url: '@Url.Action("ExportExcel","LaporanLejarAm")',
                data: myData,
                dataType: "json",
                success: function (r) {
                    window.location = '/Profile/Download?fileGuid=' + r.fileGuid
                        + '&filename=' + r.fileName;
                    toastr.success("laporan berjaya dijana.", "Berjaya");
                    toastr.options.timeOut = 2000; // 2s
                    $("#btnExportExcel").prop('disabled', false);
                    $(".loading").css("display", "none");
                }
            })
        }

        //$(".loading").prop('hidden', true);

    });
</script>
<div class="container">
    <div class="card box-shadow">
        <div class="card-body">
            <div class="row">
                <div class="col-8">
                    <h5 class="text-uppercase text-info mb-0">@ViewData["Title"]</h5>
                    <span class="ac-ref">Indeks</span>
                </div>
                <div class="col-4 text-right">
                </div>

            </div>
            <hr class="mt-2" />
            <form asp-action="PRINT">

                <div class="card mb-2">
                    <div class="card-body">
                        <div class="form-group col-sm">

                            <div class="custom-control custom-radio pb-2">

                                <input class="custom-control-input" type="radio" name="kodLaporan" id="LPL00101" value="LPL00101" checked>
                                <label class="custom-control-label" for="LPL00101">
                                    01 - Laporan Lejar Am Mengikut Julat Akaun
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <div class="form-group form-row">
                            <label asp-for="JKWId" class="col-sm-2 col-form-label"></label>
                            <div class="col-sm-4">
                                <select class="form-control form-control-sm text-uppercase" asp-for="JKWId">
                                    @foreach (var s in ViewBag.KW)
                                    {
                                        <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group form-row">
                            <label asp-for="IdDari" class="col-sm-2 col-form-label">Kod Akaun</label>
                            <div class="col-sm-4">
                                <select class="form-control form-control-sm text-uppercase select2" asp-for="IdDari" id="ddlCarta1">
                                    @foreach (var s in ViewBag.Carta1)
                                    {
                                        <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                    }
                                </select>
                            </div>
                            <label class="col-sm-1 col-form-label text-center"><i class="fas fa-angle-right"></i></label>
                            <div class="col-sm-5">
                                <select class="form-control form-control-sm text-uppercase select2" asp-for="IdHingga" id="ddlCarta2">
                                    @foreach (var s in ViewBag.Carta2)
                                    {
                                        <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group form-row">
                            <label for="Tarikh" class="col-sm-2 col-form-label">Tarikh</label>
                            <div class="col-sm-4">
                                <input type="date" class="form-control form-control-sm" asp-for="tarikhDari" value="@firstDay.ToString("yyyy-MM-dd")">
                            </div>
                            <label class="col-sm-1 col-form-label text-center"><i class="fas fa-angle-right"></i></label>
                            <div class="col-sm-5">
                                <input type="date" class="form-control form-control-sm" asp-for="tarikhHingga" value="@lastDay.ToString("yyyy-MM-dd")">
                            </div>
                        </div>
                    </div>
                </div>

                <hr />
                <div class="form-group text-right">
                    <input type="submit" value="Cetak" formtarget="_blank" class="btn ac-primary" />
                    <button type="button" formtarget="_blank" id="btnExportExcel" class="btn ac-info">Jana Excel</button>
                    <span class="loading" style="padding-right:3px; padding-top: 3px; display:inline-block;">
                        <img src="~/img/Spinner.gif" style="height:40px;">
                    </span>
                </div>

            </form>
        </div>
    </div>


</div>
