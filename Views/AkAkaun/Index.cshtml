@model IEnumerable<MSNK.Models.Modules.AkAkaun>

@{
    ViewData["Title"] = "Lejar Am";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .debit, .kredit, .total, .thdebit, .thkredit, .thtotal {
        text-align: right;
    }

    .bil, .thbil {
        text-align: center;
    }

</style>

<partial name="_JSIndex" />

<div class="card box-shadow">
    <div class="card-body">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase mb-0">Lejar Am</h5>
                <span class="ac-ref">Indeks</span>
            </div>
            <div class="col-4 text-right">
            </div>
    
        </div>
        <hr class="mt-2"/>
        <div class="card mb-3">
            <div class="card-body pl-3 pb-2 ">
                <label class="form-control-plaintext" for="searchselect">Carian : </label>
                <div class="form-actions no-color mb-2">
                    <form asp-action="Index" method="get" class="needs-validation" novalidate>
                        <div class="form-actions no-color mb-3">
                            <div class="form-row">
                                <div class="col-md">
                                    <div class="input-group mb-2 input-group-sm ">
                                        <select class="custom-select" name="searchKW" asp-items="@ViewBag.Kw" required id="searchKW"></select>
                                        <label class="invalid-feedback">Kumpulan Wang Diperlukan.</label>
                                    </div>
                                    <div class="input-group mb-2 input-group-sm ">
                                        <select class="custom-select select2" name="searchCarta" asp-items="@ViewBag.AkCarta1" id="searchCarta" style="width:100%" required></select>
                                        <label class="invalid-feedback">Carta Diperlukan.</label>
                                    </div>
                                </div>
                                <div class="col-md mb-2">
                                    <div class="input-group mb-2 input-group-sm ">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" id="basic-addon1">Daripada</span>
                                        </div>
                                        <input class="form-control" type="date" name="searchFrom" value="@ViewData["searchFrom"]" required id="tarDari" />
                                        <label class="invalid-feedback">Tarikh Diperlukan.</label>
                                    </div>
                                    <div class="input-group mb- input-group-sm ">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" id="basic-addon1">Sehingga</span>
                                        </div>
                                        <input class="form-control" type="date" name="searchUntil" value="@ViewData["searchUntil"]" required id="tarHingga" />
                                        <label class="invalid-feedback">Tarikh Diperlukan.</label>
                                    </div>
                                </div>
                            </div>
                            <input type="submit" value="Papar" class="btn btn-outline-primary" /> |
                            <a asp-action="Index" class="btn btn-link">Batal Papar</a>
                            @*<button type="submit" class="btn btn-sm btn-info"><i class="fa fa-search"></i></button>*@
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="mb-3">
            <div class="text-center">
                <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                    <button class="btn btn-info" disabled="disabled"><i class="fas fa-print"></i></button>
                    <a class="btn btn-info" onclick="printPDF()" style="color: white;" href="" id="printButton" target="_blank"> Cetak Lejar Akaun </a>
                </div>
                @*<a class="text-right btn btn-info text-white" asp-action="PrintCarta">Cetak Carta</a>*@
            </div>
        </div>
        <div class="table-responsive table-sm">
            <table class="table table-bordered table-hover display compact nowrap" width="100%">
                <thead>
                    <tr>
                        <th class="thbil">
                            Bil
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Tarikh)
                        </th>
                        <th>
                            Objek
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.NoRujukan)
                        </th>
                        <th class="thdebit">
                            @Html.DisplayNameFor(model => model.Debit)
                        </th>
                        <th class="thkredit">
                            @Html.DisplayNameFor(model => model.Kredit)
                        </th>
                        <th class="thtotal">
                            Baki RM
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNo = 0; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="bil">
                                @(rowNo += 1)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Tarikh)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AkCarta2.Kod) - @Html.DisplayFor(modelItem => item.AkCarta2.Perihal)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.NoRujukan)
                            </td>
                            <td class="debit">
                                @Convert.ToDecimal(item.Debit).ToString("#,##0.00")
                            </td>
                            <td class="kredit">
                                @Convert.ToDecimal(item.Kredit).ToString("#,##0.00")
                            </td>
                            <td class="total">
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @*@Model.Count()*@
    </div>

</div>
