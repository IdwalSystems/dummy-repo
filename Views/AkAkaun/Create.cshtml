@model MSNK.Models.Modules.AkAkaun

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>AkAkaun</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="KWId" class="control-label"></label>
                <select class="form-control" asp-for="KWId">
                    <option value="" hidden>-- Pilih Kumpulan Wang --</option>
                    @foreach (var s in ViewBag.KW)
                    {
                        <option value="@s.Id">@s.Perihal </option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="AkCartaId1" class="control-label"></label>
                <select class="form-control" asp-for="AkCartaId1">
                    <option value="" hidden>-- Pilih Carta --</option>
                    @foreach (var s in ViewBag.AkCarta1)
                    {
                        <option value="@s.id">@s.Nama </option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Tarikh" class="control-label"></label>
                <input asp-for="Tarikh" class="form-control" />
                <span asp-validation-for="Tarikh" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AkCartaId2" class="control-label"></label>
                <select class="form-control" asp-for="AkCartaId2">
                    <option value="" hidden>-- Pilih Carta --</option>
                    @foreach (var s in ViewBag.AkCarta2)
                    {
                        <option value="@s.id">@s.Nama </option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="NoRujukan" class="control-label"></label>
                <input asp-for="NoRujukan" class="form-control" />
                <span asp-validation-for="NoRujukan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Debit" class="control-label"></label>
                <input asp-for="Debit" class="form-control" />
                <span asp-validation-for="Debit" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Kredit" class="control-label"></label>
                <input asp-for="Kredit" class="form-control" />
                <span asp-validation-for="Kredit" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
