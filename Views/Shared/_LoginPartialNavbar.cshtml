@{ 
    var user = UserManager.GetUserAsync(User);
    var namaUser = _context.applicationUsers.FirstOrDefault(x => x.Email == user.Result.Email);

}
<ul class="navbar-nav ml-auto">
    @if (SignInManager.IsSignedIn(User))
    {
    <li class="nav-item dropdown">
        <a class="nav-link" href="#"  aria-haspopup="true" aria-expanded="false">Selamat Datang, @namaUser.Nama  <i class="fas fa-angle-down"></i> </a>
        <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
            <a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="ChangePassword">Tukar Kata Laluan</a>
            <form id="logOutForm" method="post" class="form-inline" asp-controller="Account" asp-action="LogOff">
                <button type="submit" class="btn dropdown-item">Log Keluar</button>
            </form>
        </div>
    </li>
        <li class="nav-item">
             
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
        </li>
    }


</ul>