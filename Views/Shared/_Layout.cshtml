

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MSNK</title>
    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/plugins/bootstrap-datepicker/dist/css/bootstrap-datepicker.min.css">
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" />
    <link href="~/lib/datatables/css/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.css" rel="stylesheet" />
    <link href="~/lib/toastr.js/toastr.min.css" rel="stylesheet" />
    <link href="~/lib/select2-bootstrap-theme/select2-bootstrap.css" rel="stylesheet" />


    <link href="~/lib/animate.css/animate.min.css" rel="stylesheet" />
    <partial name="_Favicons" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/plugins/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.js"></script>
    <script src="~/lib/select2/js/select2.js"></script>
    <script src="~/lib/toastr.js/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @*<script>
            $(function () {
                $('[data-toggle="tooltip"]').tooltip()
            })
        </script>*@
</head>


<body>
    <style>
        .bg-super {
            background: rgb(238,174,202);
            background: radial-gradient(circle, rgba(238,174,202,1) 0%, rgba(148,187,233,1) 100%);
        }

            .bg-super .nav-link {
                color: white;
            }
    </style>
    <nav class="navbar navbar-expand-lg navbar-toggleable-lg bg-light navbar-light mb-0 border-bottom" style="height: fit-content;">

        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-home" hidden></i></a>
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/MainLogo_Syarikat.png" alt="Logo syarikat" style="width: 40px; height: 40px; align-content: center; height: 100%;" class="border border-light rounded-circle" />
            </a>
            MSNK
            <partial name="_LoginPartialNavbar" />
        </div>
    </nav>
    <header>
        @{
            var navtype = "";
        }
        @if (User.IsInRole("Admin"))
        {
            navtype = "bg-dark navbar-dark";
        }
        else if (User.IsInRole("Supervisor"))
        {
            navtype = "bg-info navbar-dark";
        }
        else if (User.IsInRole("User"))
        {
            navtype = "bg-light navbar-light";
        }
        else
        {
            navtype = "bg-super navbar-dark";
        }


        <nav class="navbar navbar-expand-lg navbar-toggleable-lg @navtype border-bottom mb-3">
            <div class="container">
                @*<button class="navbar-toggler" type="button" style="cursor:pointer" onclick="openNav()">
                    <span class="navbar-toggler-icon"  ></span>
                </button>*@
                
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between ">
                    <ul class="navbar-nav text-nowrap flex-nowrap " style="overflow-x: auto; width: 120vh; overflow:visible;">

                        @if (User.Identity.IsAuthenticated)
                        {

                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <partial name="_SistemPartialNavbar" />
                                <partial name="_JadualPartialNavbar" />
                                <partial name="_DaftarPartialNavbar" />
                                <partial name="_BelanjawanPartialNavbar" />
                                <partial name="_LejarPartialNavbar" />
                                <partial name="_TerimaanPartialNavbar" />
                                <partial name="_TanggunganPartialNavbar" />
                                <partial name="_BaucerPartialNavbar" />
                                <partial name="_TunaiRuncitPartialNavbar" />
                                <partial name="_PermohonanPartialNavbar" />

                            }
                            else if (User.IsInRole("Admin"))
                            {
                                <partial name="_SistemPartialNavbar" />
                            }
                            else if (User.IsInRole("Supervisor"))
                            {
                                <partial name="_JadualPartialNavbar" />
                                <partial name="_DaftarPartialNavbar" />
                                <partial name="_BelanjawanPartialNavbar" />
                                <partial name="_LejarPartialNavbar" />
                                <partial name="_TerimaanPartialNavbar" />
                                <partial name="_TanggunganPartialNavbar" />
                                <partial name="_BaucerPartialNavbar" />
                                <partial name="_TunaiRuncitPartialNavbar" />
                                <partial name="_PermohonanPartialNavbar" />
                            }
                            else
                            {
                                <partial name="_TerimaanPartialNavbar" />
                                <partial name="_TanggunganPartialNavbar" />
                                <partial name="_BaucerPartialNavbar" />
                                @*<partial name="_TunaiRuncitPartialNavbar" />*@
                                <partial name="_PermohonanPartialNavbar" />
                            }
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @*AK TEST*@
        @*<div id="mySidenav" class="sidenav @navtype">
            <a href="javascript:void(0)" class="closebtn" onclick="closeNav()">&times;</a>
            <ul class="list-unstyled components">
                <li>
                    <a href="#">
                        About
                    </a>
                    <a href="#">
                        About
                    </a>
                </li>
            </ul>
        </div>*@
        @*AK TEST END*@
        <main role="main" class="pb-3">
            <partial name="_Notifications" />
            <partial name="_ToTopButton" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2022 - MSNK - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privasi</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
