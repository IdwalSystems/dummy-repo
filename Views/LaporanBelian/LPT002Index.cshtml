@model MSNK.Models.Modules.FormModel.ReportFormModel

@{
    ViewData["Title"] = "LPT002 Laporan Daftar Belian";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<div class="container">
    <div class="card box-shadow">
        <div class="card-body">
            <div class="row">
                <div class="col-8">
                    <h5 class="text-uppercase text-info mb-0">@ViewData["Title"]</h5>
                    <span class="ac-ref">Indeks</span>
                </div>
                <div class="col-4 text-right">
                </div>

            </div>
            <hr class="mt-2" />
            <form asp-action="PRINT">
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="form-group col-sm">

                            <div class="custom-control custom-radio pb-2">

                                <input class="custom-control-input" type="radio" asp-for="kodLaporan" id="LPT00201" value="LPT00201" checked>
                                <label class="custom-control-label" for="LPT00201">
                                    01 - Laporan Daftar Belian
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <div class="form-group form-row">
                            <label for="Tarikh" class="col-sm-2 col-form-label">Tarikh</label>
                            <div class="col-sm-5">
                                <input type="date" class="form-control form-control-sm" id="tarikhDari" asp-for="tarikhDari" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                            </div>
                            <div class="col-sm-5">
                                <input type="date" class="form-control form-control-sm" id="tarikhHingga" asp-for="tarikhHingga" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                            </div>

                        </div>

                        <div class="form-group form-row">
                            <label for="Status" class="col-sm-2 col-form-label">Status</label>
                            <div class="col-sm-5">
                                <select class="form-control form-control-sm input-group-sm" id="status" asp-for="status" required>
                                    <option value="0" selected>SEMUA</option>
                                    <option value="1">BELUM POSTING</option>
                                    <option value="2">SUDAH POSTING</option>
                                    <option value="3">BATAL</option>

                                </select>
                            </div>
                        </div>

                        <div class="form-group form-row">
                            <label for="Susunan" class="col-sm-2 col-form-label">Susunan</label>
                            <div class="col-sm-5">
                                <select class="form-control form-control-sm input-group-sm" id="susunan" asp-for="susunan" required>
                                    <option value="0" selected>NO INVOIS</option>
                                    <option value="1">TARIKH</option>
                                    <option value="2">KOD PEMBEKAL</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="form-group text-right">
                    <input type="submit" value="Cetak" formtarget="_blank" class="btn ac-primary" />
                </div>

            </form>
        </div>
    </div>


</div>
