@model IEnumerable<MSNK.Models.Modules.SuPekerja>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_JSIndex" />
<style>
    th:last-child, td:last-child {
        position: sticky;
        right: 0px;
        background-color: white;
        border-inline-style: inherit;
    }
</style>
<div class="row mb-2">
    <div class="col-8">
        <h3 class="text-left">Anggota</h3>
    </div>
    <div class="col-4 text-right">
        <a class="text-right btn btn-success text-white" asp-action="Create">Tambah Baru</a>
    </div>
</div>
<div class="card mb-2">
    <div class="card-body pl-3 pb-2">
        <label class="form-control-plaintext" for="columnSearch">Carian : </label>
        <div class="form-actions no-color mb-2">
            <div class="form-row">
                <div class="col-sm-2 mb-2">
                    <select class="custom-select form-control-sm" id="columnSearch">
                        <option value="" selected>Semua</option>
                        <option value=".noGaji">No Gaji</option>
                        <option value=".nama">Nama</option>
                        <option value=".noKp">No KP</option>
                    </select>
                </div>
                <div class="col-sm-8 mb-2">
                    <input class="form-control form-control-sm text-uppercase" type="text" id="myInput" />
                </div>
                @*<div class="col-sm mb-2">
                    <button class="btn btn-warning btn-sm" id="batalCari" value="Batal Carian"><i class="fas fa-backspace"></i></button>
                </div>*@
            </div>
        </div>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-bordered table-hover text-nowrap table-sm nowrap" width="100%">
        <thead>
            <tr>
                <th width="5%">Bil</th>
                <th class="noGaji" width="5%">
                    @Html.DisplayNameFor(model => model.NoGaji)
                </th>
                <th class="nama">
                    @Html.DisplayNameFor(model => model.Nama)
                </th>
                <th class="noKp">
                    @Html.DisplayNameFor(model => model.NoKp)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Emel)
                </th>
                @*<th>
            @Html.DisplayNameFor(model => model.Alamat1)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Poskod)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Bandar)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TelefonBimbit)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.StatusKahwin)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.BilAnak)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TarikhMasukKerja)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TarikhBerhentiKerja)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TarikhPencen)
        </th>*@
                <th>
                    @Html.DisplayNameFor(model => model.NoAkaunBank)
                </th>
                @*<th>
            @Html.DisplayNameFor(model => model.JNegeri)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JAgama)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JBangsa)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.JJawatanPekerja)
        </th>*@
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
