        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TarikhBerhentiKerja)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TarikhPencen)
        </td>*@
                <td>
                    @Html.DisplayFor(modelItem => item.NoAkaunBank)
                </td>
                @*<td>
            @Html.DisplayFor(modelItem => item.JNegeri.Kod)
        </td>
