@model MSNK.Models.Modules.AkJurnal

@{
    ViewData["Title"] = "Ubah";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_JSEdit" />

<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="NoJurnal" />
            <input type="hidden" asp-for="Tarikh" />
            <input type="hidden" asp-for="JKWId" />
            <div class="card box-shadow border-primary mb-3">
                <div class="card-header bg-primary text-white ">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-left">Baucer Jurnal - @ViewData["Title"]</h5>
                        </div>
                        <div class="col-md-6">
                            <p class="text-right">No Jurnal : @Model.NoJurnal</p>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="form-group col-md">
                            <label class="control-label">No Jurnal</label>
                            <input class="form-control form-control-sm" readonly value="@Model.NoJurnal" />
                            <span asp-validation-for="NoJurnal" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md">
                            <label asp-for="JKWId" class="control-label"></label>
                            <span class="text-danger control-label">*</span>
                                <input class="form-control form-control-sm" id="jkwtxt"
                                       value="@Html.DisplayFor(model => model.JKW.Kod) - @Html.DisplayFor(model => model.JKW.Perihal)" readonly />
                            @*<select class="form-control form-control-sm" asp-for="JKWId">
                                <option value="" hidden>-- Pilih Kumpulan Wang --</option>
                                @foreach (var s in ViewBag.JKW)
                                {
                                    <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                }
                            </select>
                            <span asp-validation-for="JKWId" class="text-danger"></span>*@
                        </div>
                        <div class="form-group col-md">
                            <label asp-for="Tarikh" class="control-label"></label>
                            <span class="text-danger control-label">*</span>
                            <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.Tarikh)" readonly />
                            @*<input asp-for="Tarikh" class="form-control form-control-sm" />
        <span asp-validation-for="Tarikh" class="text-danger"></span>*@
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Catatan1" class="control-label">Catatan</label>
                        <textarea class="form-control form-control-sm text-uppercase" maxlength="400" rows="4" asp-for="Catatan1" required></textarea>
                        <span asp-validation-for="Catatan1" class="text-danger"></span>
                    </div>
                    @*<div class="form-group">
                        <input asp-for="Catatan2" class="form-control form-control-sm" />
                        <span asp-validation-for="Catatan2" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <input asp-for="Catatan3" class="form-control form-control-sm" />
                        <span asp-validation-for="Catatan3" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <input asp-for="Catatan4" class="form-control form-control-sm" />
                        <span asp-validation-for="Catatan4" class="text-danger"></span>
                    </div>*@
                    <br />
                    @*table Objek*@
                    <div class="card box-shadow mb-3">
                        <div class="card-header">
                            <h6>Objek</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive-md">
                                <div class="d-flex justify-content-center" aria-hidden="true">
                                    <div class="la-ball-clip-rotate la-dark d-none" id="loader">
                                        <div></div>
                                    </div>
                                </div>
                                <table id="tblObjek" class="table table-sm" cellpadding="0" cellspacing="0" width="100%">
                                    <thead>
                                        <tr>
                                            <th>Indeks</th>
                                            <th style="width:60%">Kod</th>
                                            <th class="text-right">Debit RM</th>
                                            <th class="text-right">Kredit RM</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyObjek">
                                        @foreach (var item in ViewBag.akJurnal1)
                                        {
                                            <tr id="@item.Id">
                                                <td id="akCartaId" hidden>@item.AkCartaId</td>
                                                <td>@(item.Indeks.ToString().Length<2?"0"+ item.Indeks.ToString(): item.Indeks.ToString())</td>
                                                <td>@item.AkCarta.Kod - @item.AkCarta.Perihal</td>
                                                <td class="editable-txt text-right" id="td1Amaun">@item.Debit</td>
                                                <td class="editable-txt text-right" id="td1Amaun">@item.Kredit</td>
                                                <td>
                                                    <button class="btn btn-primary btn-sm"
                                                            type="button" id="btnUpdate1" data-toggle="modal"
                                                            data-target="#modalObjek" onclick="Update1(this)">
                                                        <i class="fa fa-edit"></i>
                                                    </button>
                                                </td>
                                                <td>
                                                    <button class="btn btn-danger btn-sm"
                                                            type="button" id="btnRemove1" onclick="Remove1(this)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>

                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td id="akCartaId" hidden></td>
                                            <td hidden><input id="txtAkJurnal1" value="@Model.Id" /></td>
                                            <td><input class="form-control form-control-sm" type="number" id="txtIndeksObjek" step="1" min="0" max="99" value="5" /></td>
                                            <td style="width:60%">
                                                <select class="form-control form-control-sm select2" id="txtKodAkaun">
                                                    <option value="" disabled selected>-- Pilih Kod Akaun --</option>
                                                    @foreach (var s in ViewBag.AkCarta)
                                                    {
                                                        <option class="@s.JKW.Kod" value="@s.Id">@s.Kod - @s.Perihal </option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input class="form-control form-control-sm" type="number" id="txtDebitObjek" step="0.01" value="0.00"></td>
                                            <td><input class="form-control form-control-sm" type="number" id="txtKreditObjek" step="0.01" value="0.00"></td>
                                            <td><button class="btn btn-success btn-sm" type="button" id="btnAdd1"><i class="fas fa-plus"></i></button></td>
                                        </tr>
                                    </tfoot>
                                </table>
                                <span class="errKodAkaun text-danger" style="display:none">Pastikan Kod Akaun unik.</span>
                                <span class="errIndeks text-danger" style="display:none">Pastikan Indeks unik.</span>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="form-row">
                                <div class="form-group col-md-4 offset-md-4">
                                    <div class="input-group input-group-sm mb-3">
                                        <div class="input-group-prepend">
                                            <div class="input-group-text font-weight-bold">Jumlah Debit RM</div>
                                        </div>
                                        <input asp-for="JumDebit" class="form-control form-control-sm font-weight-bold text-right" id="JumDebit" readonly />
                                    </div>
                                    <span asp-validation-for="JumDebit" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-4">
                                    <div class="input-group input-group-sm mb-3">
                                        <div class="input-group-prepend">
                                            <div class="input-group-text font-weight-bold">Jumlah Kredit RM</div>
                                        </div>
                                        <input asp-for="JumKredit" class="form-control form-control-sm font-weight-bold text-right" id="JumKredit" readonly />
                                    </div>
                                    <span asp-validation-for="JumKredit" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    @*table Objek end*@

                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Simpan" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Kembali Ke Indeks</a>
</div>

<!-- Modal Objek -->
<div class="modal fade bd-example-modal-lg" id="modalObjek" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Objek</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input id="moId1" hidden />
                    <div class="form-group">
                        <label class="col-form-label">Indeks</label>
                        <input type="number" class="form-control form-control-sm" id="moIndeks" step="1" min="0" max="99">
                        <span class="errModelIndeks text-danger" style="display:none">Indeks telah digunakan.</span>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Kod Akaun</label>
                        <select class="form-control form-control-sm" id="moKodAkaun" disabled>
                            <option value="" disabled selected>-- Pilih Kod Akaun --</option>
                            @foreach (var s in ViewBag.AkCarta)
                            {
                                <option class="@s.JKW.Kod" value="@s.Id">@s.Kod - @s.Perihal </option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Debit</label>
                        <input type="number" class="form-control form-control-sm" id="moDebit" step="0.01">
                    </div>
                    <div class="form-group">
                        <label class="col-form-label">Kredit</label>
                        <input type="number" class="form-control form-control-sm" id="moKredit" step="0.01">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" onclick="modalUpdate1()">OK</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal Objek End -->

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
