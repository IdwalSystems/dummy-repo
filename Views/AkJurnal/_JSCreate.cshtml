<script type="text/javascript">
    var varIndeksLama = 0;
    var rowno = 0;
    var debit = 0;
    var kredit = 0;
    //add tbl objek
    $("body").on("click", "#btnAdd1", function () {
        //Reference the Name and Country TextBoxes.
        var txtKodAkaun = $("#txtKodAkaun");
        GetCarta(txtKodAkaun.val());
    });

    function GetCarta(id) {
        var Objek = {
            Id: id
        }
        if (id) {
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: "/AkJurnal/GetCarta",
                data: Objek,
                dataType: "json",
                success: function (r) {
                    //Reference the TextBoxes.
                    var txtKodAkaun = $("#txtKodAkaun");
                    var txtKodAkaunText = $("#txtKodAkaun option:selected");
                    var txtDebitObjek = $("#txtDebitObjek");
                    var txtKreditObjek = $("#txtKreditObjek");
                    var jumDebit = $("#JumDebit");
                    var jumKredit = $("#JumKredit");
                    var indeks = $("#txtIndeksObjek");

                    //Get the reference of the Table's TBODY element.
                    var tBody = $("#tblObjek > TBODY")[0];
                    //Add Row.
                    var check = false;
                    var check2 = false;
                    var table = $("#tblObjek tbody");
                    table.find('tr').each(function (i, el) {
                        var $tds = $(this).find('td');
                        var loop = $tds.eq(2).text();
                        var loopidx = $tds.eq(1).text();
                        if (txtKodAkaunText.text().trim() === loop.trim()) {
                            //check = true;
                            //$(".errKodAkaun").css({ "display": "block" });
                        };
                        if (indeks.val() === parseInt(loopidx).toString()) {
                            check2 = true;
                            $(".errIndeks").css({ "display": "block" });
                        };
                    });
                    if (!check && !check2) {
                        var row = tBody.insertRow(-1);

                        //Add akCartaId cell.
                        var cell = $(row.insertCell(-1));
                        cell.html(r.record.id);
                        cell.prop("hidden", !this.checked);

                        //Add indeks cell.
                        var cell = $(row.insertCell(-1));
                        cell.html(indeks.val().length < 2 ? "0" + indeks.val() : indeks.val());

                        //Add kod cell.
                        var cell = $(row.insertCell(-1));
                        cell.html(r.record.kod + " - " + r.record.perihal);

                        //Add debit cell.
                        var cell = $(row.insertCell(-1));
                        if (txtDebitObjek.val()) {
                            cell.html(parseFloat(txtDebitObjek.val()).toFixed(2));
                        } else {
                            cell.html("0.00");
                        }
                        cell.attr("class", "editable-txt text-right");

                        //Add kredit cell.
                        var cell = $(row.insertCell(-1));
                        if (txtKreditObjek.val()) {
                            cell.html(parseFloat(txtKreditObjek.val()).toFixed(2));
                        } else {
                            cell.html("0.00");
                        }
                        cell.attr("class", "editable-txt text-right");

                        cell = $(row.insertCell(-1));
                        var btnUpdate1 = $("<button class='btn btn-primary btn-sm' type='button' id='btnUpdate1' onclick='Update1(this)'><i class='fas fa-edit'></i></button>");
                        cell.append(btnUpdate1);

                        //Add Button cell.
                        cell = $(row.insertCell(-1));
                        var btnRemove1 = $("<button class='btn btn-danger btn-sm' type='button' id='btnRemove1' onclick='Remove1(this)'><i class='fas fa-trash'></i></button>");
                        cell.append(btnRemove1);

                        var AkJurnal1 = {
                            AkCartaId: txtKodAkaun.val(),
                            Debit: txtDebitObjek.val(),
                            Kredit: txtKreditObjek.val(),
                            Indeks: indeks.val()
                        }

                        if (txtKodAkaun.val()) {
                            $.ajax({
                                type: "POST",
                                url: "/AkJurnal/SaveAkJurnal1",
                                data: AkJurnal1,
                                dataType: "json",
                                success: function (r) {
                                    //Clear the TextBoxes.
                                    txtDebitObjek.val("0.00");
                                    txtKreditObjek.val("0.00");
                                    jumDebit.val(r.record.value.debit);
                                    jumKredit.val(r.record.value.kredit);

                                    $(".errKodAkaun").css({ "display": "none" });
                                    $(".errIndeks").css({ "display": "none" });

                                    var nextIdx = 0;
                                    var table = $("#tblObjek tbody");
                                    table.find('tr').each(function (i, el) {
                                        var $tds = $(this).find('td');
                                        var idx = $tds.eq(1).text();
                                        var intidx = parseInt(idx);
                                        nextIdx = nextIdx < intidx ? intidx : nextIdx;
                                    });
                                    indeks.val(round5(nextIdx));

                                    $.ajax({
                                        type: "POST",
                                        url: "/AkJurnal/GetAllItemCartAkJurnal1",
                                        dataType: "json",
                                        success: function (r) {
                                            //refresh updated table objek
                                            $("table tbody#tbodyObjek").empty();
                                            var sumdebit = 0;
                                            var sumkredit = 0;
                                            var nextIdx = 0;
                                            if (r.record.length > 0) {
                                                for (var i = 0; i < r.record.length; i++) {
                                                    var item1 = r.record[i];
                                                    var str =
                                                        "<tr id='" + item1.id + "'><td id='akCartaId' hidden>" + item1.akCartaId +
                                                        "</td><td>" + (((item1.indeks.toString()).length < 2) ? ("0" + (item1.indeks).toString()) : item1.indeks) +
                                                        "</td><td>" + item1.akCarta.kod + ' - ' + item1.akCarta.perihal +
                                                        "</td><td class='editable-txt text-right'>" + (item1.debit).toFixed(2) +
                                                        "</td><td class='editable-txt text-right'>" + (item1.kredit).toFixed(2) +
                                                        "</td><td>" +
                                                        "<button class='btn btn-primary btn-sm' type='button' id='btnUpdate1' data-toggle='modal' data-target='#modalObjek' onclick='Update1(this)'><i class='fa fa-edit' ></i></button>" +
                                                        "</td><td>" +
                                                        "<button class='btn btn-danger btn-sm' type='button' id='btnRemove1' onclick='Remove1(this)'><i class='fas fa-trash' ></i></button>" +
                                                        "</td><tr>";
                                                    $("table tbody#tbodyObjek").append(str);
                                                    console.log("test :" + str);
                                                    sumdebit += item1.debit;
                                                    sumkredit += item1.kredit;
                                                    nextIdx = nextIdx < item1.indeks ? item1.indeks : nextIdx;
                                                }
                                            }
                                            jumDebit.val(sumdebit.toFixed(2));
                                            jumKredit.val(sumkredit.toFixed(2));
                                            $("#txtIndeksObjek").val(round5(nextIdx));
                                            $('#modalObjek').modal('hide');
                                            $(".errModelIndeks").css({ "display": "none" });
                                        }
                                    });

                                },
                                error: function (req, status, error) {
                                    alert(error);
                                }
                            });
                        }
                    };
                }
            });
        }
    }

    function Remove1(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var name = $("TD", row).eq(2).html();
        var jumDebit = $("#JumDebit");
        var jumKredit = $("#JumKredit");
        var cartaId = $("TD", row).eq(0).html();
        var indeks = $("TD", row).eq(1).html();
        var idxStr = indeks.toString().length < 2 ? "0" + indeks.toString() : indeks.toString();

        if (confirm("Hapus kod Akaun : " + name + " pada indeks : " + idxStr + " ?")) {
            //Get the reference of the Table.
            var table = $("#tblObjek")[0];
            var AkJurnal1 = {
                AkCartaId: cartaId,
                Indeks: indeks
            }
            if (name != null) {
                $.ajax({
                    type: "POST",
                    url: "/AkJurnal/RemoveAkJurnal1",
                    data: AkJurnal1,
                    dataType: "json",
                    success: function (r) {
                        //Delete the Table row using it's Index.
                        table.deleteRow(row[0].rowIndex);
                        jumDebit.val(r.record.value.debit);
                        jumKredit.val(r.record.value.kredit);
                        getNextIdx();
                    }
                });
            }
        }
    };

    function Update1(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var akCartaId = $("TD", row).eq(0).html();
        var indeks = $("TD", row).eq(1).html();

        var AkJurnal1 = {
            AkCartaId: akCartaId,
            Indeks: indeks
        }
        if (name != null) {
            $.ajax({
                type: "POST",
                url: "/AkJurnal/GetAnItemCartAkJurnal1",
                data: AkJurnal1,
                dataType: "json",
                success: function (r) {
                    $("#moId1").val(r.record.id);
                    $("#moIndeks").val(r.record.indeks);
                    varIndeksLama = r.record.indeks;
                    $("#moKodAkaun").val(r.record.akCartaId);
                    $("#moDebit").val(r.record.debit.toFixed(2));
                    $("#moKredit").val(r.record.kredit.toFixed(2));
                    $("#modalObjek").modal({ backdrop: 'static', keyboard: false });
                }
            });
        }
    };
    function modalUpdate1() {
        var id = $("#moId1").val();
        var debit = $("#moDebit").val();
        var kredit = $("#moKredit").val();
        var akCartaId = $("#moKodAkaun").val();
        var indeks = $("#moIndeks").val();
        var txtCarta = $("#moKodAkaun option:selected").text();
        var jumDebit = $("#JumDebit");
        var jumKredit = $("#JumKredit");

        var check = false;
        var table = $("#tblObjek tbody");
        table.find('tr').each(function (i, el) {
            var $tds = $(this).find('td');
            var idx = $tds.eq(1).text();
            var carta = $tds.eq(2).text();
            var intidx = parseInt(idx);

            if (indeks === parseInt(intidx).toString()) {
                if (txtCarta.trim() === carta.trim()) {
                    check = false;
                } else {
                    check = true;
                    $(".errModelIndeks").css({ "display": "block" });
                }
            };
        });

        var AkJurnal1 = {
            Id: id,
            AkCartaId: akCartaId,
            Debit: debit,
            Kredit: kredit,
            IndeksLama: varIndeksLama,
            IndeksBaru: indeks
        }
        if (!check) {
            $.ajax({
                type: "POST",
                url: "/AkJurnal/SaveCartAkJurnal1",
                data: AkJurnal1,
                dataType: "json",
                success: function (r) {
                    //insert notification here

                    $.ajax({
                        type: "POST",
                        url: "/AkJurnal/GetAllItemCartAkJurnal1",
                        dataType: "json",
                        success: function (r) {
                            //refresh updated table objek
                            $("table tbody#tbodyObjek").empty();
                            var sumdebit = 0;
                            var sumkredit = 0;
                            var nextIdx = 0;
                            if (r.record.length > 0) {
                                for (var i = 0; i < r.record.length; i++) {
                                    var item1 = r.record[i];
                                    var str =
                                        "<tr id='" + item1.id + "'><td id='akCartaId' hidden>" + item1.akCartaId +
                                        "</td><td>" + (((item1.indeks.toString()).length < 2) ? ("0" + (item1.indeks).toString()) : item1.indeks) +
                                        "</td><td>" + item1.akCarta.kod + ' - ' + item1.akCarta.perihal +
                                        "</td><td class='editable-txt text-right'>" + (item1.debit).toFixed(2) +
                                        "</td><td class='editable-txt text-right'>" + (item1.kredit).toFixed(2) +
                                        "</td><td>" +
                                        "<button class='btn btn-primary btn-sm' type='button' id='btnUpdate1' data-toggle='modal' data-target='#modalObjek' onclick='Update1(this)'><i class='fa fa-edit' ></i></button>" +
                                        "</td><td>" +
                                        "<button class='btn btn-danger btn-sm' type='button' id='btnRemove1' onclick='Remove1(this)'><i class='fas fa-trash' ></i></button>" +
                                        "</td><tr>";
                                    $("table tbody#tbodyObjek").append(str);
                                    console.log("test :" + str);
                                    sumdebit += item1.debit;
                                    sumkredit += item1.kredit;
                                    nextIdx = nextIdx < item1.indeks ? item1.indeks : nextIdx;
                                }
                            }
                            jumDebit.val(sumdebit.toFixed(2));
                            jumKredit.val(sumkredit.toFixed(2));
                            $("#txtIndeksObjek").val(round5(nextIdx));
                            $('#modalObjek').modal('hide');
                            $(".errModelIndeks").css({ "display": "none" });
                        }
                    });
                }
            });
        };
    };



    $("body").on("click", "#btnSave", function () {
        //insert validation form here
    });

    $("body").on('change', "#ddlKW", function () {
        JsonKod();
    });

    $("body").on('change', "#txtTarikh", function () {
        JsonKod();
    });

    function JsonKod() {

        var tar = $("#txtTarikh").val();
        var kw = $("#ddlKW").val();

        if (tar && kw) {
            var AkJurnal = {
                Tarikh: tar,
                JKWId: kw
            };

            $.ajax({
                type: "POST",
                url: "/AkJurnal/JsonGetKod",
                data: AkJurnal,
                dataType: "json",
                success: function (msg) {
                    $("#txtNoJurnal").val(msg.record);
                },
                error: function (req, status, error) {
                    alert(error);
                }
            });
        }
    }


    function getNextIdx() {
        var nextIdx = 0;
        var table = $("#tblObjek tbody");
        table.find('tr').each(function (i, el) {
            var $tds = $(this).find('td');
            var idx = $tds.eq(1).text();
            var intidx = parseInt(idx);
            nextIdx = nextIdx < intidx ? intidx : nextIdx;
        });
        $("#txtIndeksObjek").val(round5(nextIdx));
    };

    function round5(x) {
        if (Math.ceil(x / 5) * 5 === x) {
            return (Math.ceil(x / 5) * 5) + 5;
        } else {
            return Math.ceil(x / 5) * 5;
        }
    };
</script>