@model MSNK.Models.Modules.AkJurnal

@{
    ViewData["Title"] = "Hapus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Hapus</h1>

<h3 class="text-danger">Anda pasti?</h3>

<div class="row">
    <div class="col-md-12">
        <div class="card box-shadow border-danger mb-3">
            <div class="card-header bg-danger text-white">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="text-left">Baucer Jurnal - @ViewData["Title"]</h5>
                    </div>
                    <div class="col-md-6">
                        <p class="text-right">No Jurnal : @Model.NoJurnal</p>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-10">
                        <div class="form-row">
                            <div class="form-group col-md">
                                <label asp-for="JKW" class="control-label"></label>
                                <input class="form-control form-control-sm"
                                       value="@Html.DisplayFor(model => model.JKW.Kod) - @Html.DisplayFor(model => model.JKW.Perihal)" readonly />
                            </div>
                            <div class="form-group col-md">
                                <label asp-for="Tarikh" class="control-label"></label>
                                <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.Tarikh)" readonly />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md">
                                <label class="control-label">Catatan</label>
                                <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.Catatan1)" readonly />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md">
                                <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.Catatan2)" readonly />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md">
                                <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.Catatan3)" readonly />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md">
                                <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.Catatan4)" readonly />
                            </div>
                        </div>
                        @*<div class="form-row" hidden>
                        <div class="form-group col-md">
                            <label asp-for="UserId" class="control-label"></label>
                            <input class="form-control form-control-sm"
                                   value="@Html.DisplayFor(model => model.UserId)" readonly />
                        </div>
                        <div class="form-group col-md">
                            <label asp-for="TarMasuk" class="control-label"></label>
                            <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.TarMasuk)" readonly />
                        </div>
                    </div>*@

                    </div>
                    <div class="col-lg-2">
                        <div class="card mb-2">
                            <div class="card-body p-1">
                                <div class="form-group col-sm">
                                    <label asp-for="Cetak" class="control-label"></label>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="Cetak" type="radio" id="Cetak1" name="Cetak" class="custom-control-input" value="0">
                                        <label class="custom-control-label" for="Cetak1">Belum</label>
                                    </div>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="Cetak" type="radio" id="Cetak2" name="Cetak" class="custom-control-input" value="1">
                                        <label class="custom-control-label" for="Cetak">Sudah</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card mb-2">
                            <div class="card-body p-1">
                                <div class="form-group col-sm">
                                    <label asp-for="Posting" class="control-label"></label>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="Posting" type="radio" id="Posting1" name="Posting" class="custom-control-input" value="0">
                                        <label class="custom-control-label" for="Posting">Belum</label>
                                    </div>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="Posting" type="radio" id="Posting2" name="Posting" class="custom-control-input" value="1">
                                        <label class="custom-control-label" for="Posting">Sudah</label>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="card mb-2">
                            <div class="card-body p-1">
                                <div class="form-group col-sm">
                                    <label asp-for="Batal" class="control-label"></label>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="Batal" type="radio" id="Batal1" name="Batal1" class="custom-control-input" value="0">
                                        <label class="custom-control-label" for="Batal">Belum</label>
                                    </div>
                                    <div class="custom-control custom-radio">
                                        <input asp-for="Batal" type="radio" id="Batal1" name="Batal" class="custom-control-input" value="1">
                                        <label class="custom-control-label" for="Batal">Sudah</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <br />
                <div class="card box-shadow mb-3">
                    <div class="card-header">
                        <h6>Objek</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="tblObjek" class="table table-sm" cellpadding="0" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th style="width:60%">Kod</th>
                                        <th class="text-right">Debit RM</th>
                                        <th class="text-right">Kredit RM</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyObjek">
                                    @foreach (var item in ViewBag.akJurnal1)
                                    {
                                        <tr id="@item.Id">
                                            <td id="akCartaId" hidden>@item.AkCartaId</td>
                                            <td>@item.AkCarta.Kod - @item.AkCarta.Perihal</td>
                                            <td class="editable-txt text-right" id="td1Amaun">@item.Debit</td>
                                            <td class="editable-txt text-right" id="td1Amaun">@item.Kredit</td>
                                        </tr>

                                    }
                                </tbody>
                                <tfoot>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="form-row">
                            <div class="form-group col-md-4 offset-md-4">
                                <div class="input-group input-group-sm mb-3">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text font-weight-bold">Jumlah Debit RM</div>
                                    </div>
                                    <input class="form-control form-control-sm font-weight-bold text-right" value="@Html.DisplayFor(model => model.JumDebit)" readonly />
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <div class="input-group input-group-sm mb-3">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text font-weight-bold">Jumlah Kredit RM</div>
                                    </div>
                                    <input class="form-control form-control-sm font-weight-bold text-right" value="@Html.DisplayFor(model => model.JumKredit)" readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Hapus" class="btn btn-danger btn-sm" />
        <a asp-action="Index" class="btn btn-link">Kembali Ke Indeks</a>
    </form>
</div>
