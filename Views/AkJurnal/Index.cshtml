@model IEnumerable<MSNK.Models.Modules.AkJurnal>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_JSIndex" />

<div class="row mb-2">
    <div class="col-8">
        <h3 class="text-left">Baucer Jurnal</h3>
    </div>
    <div class="col-4 text-right">
        <a class="text-right btn btn-success text-white" asp-action="Create">Tambah Baru</a>
    </div>
</div>

@*div carian*@
<div class="card mb-2">
    <div class="card-body pl-3 pb-2 ">
        <label class="form-control-plaintext" for="searchselect">Carian : </label>

        <div class="form-actions no-color mb-2">
            <form asp-action="Index" method="get">
                <div class="form-row">
                    <div class="col-sm-3 mb-2">
                        <select class="custom-select form-control-sm"
                                name="searchColumn"
                                asp-items="@ViewBag.SearchColumn" id="searchColumn"></select>
                    </div>
                    <div class="col-sm-9 mb-2">
                        <div class="form-row">
                            <div class="col-10">
                                <div class="form-row">
                                    <div class="col-12">
                                        <input class="form-control form-control-sm" type="text" name="searchString" id="myInput" value="@ViewBag.SearchData1" />
                                    </div>
                                    <div class="col-6" id="myInputDate1">
                                        <input class="form-control form-control-sm mb-2" type="date" name="searchDate1" id="inputTarikh1" value="@ViewBag.SearchData1" />
                                    </div>
                                    <div class="col-6" id="myInputDate2">
                                        <input class="form-control form-control-sm" type="date" name="searchDate2" id="inputTarikh2" value="@ViewBag.SearchData2" />
                                    </div>
                                    <div class="col-12" id="myInputKw">
                                        <select class="custom-select form-control-sm"
                                                name="searchKw"
                                                asp-items="@ViewBag.SearchKw" id="searchKw"></select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-2">
                                <button type="submit" class="btn btn-sm btn-info"><i class="fa fa-search"></i></button>
                                @*<a asp-action="Index" class="btn btn-sm btn-warning"><i class="fas fa-backspace"></i></a>*@
                            </div>
                        </div>

                    </div>

                </div>
            </form>
        </div>
    </div>
</div>
@*div carian end*@


<div class="table-responsive table-sm">
    <table class="table table-bordered table-hover display compact nowrap" width="100%">
        <thead>
            <tr>
                <th width="2%">
                    Bil
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NoJurnal)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.JKW)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Tarikh)
                </th>
                <th>
                    Jum Debit RM
                </th>
                <th>
                    Jum Kredit RM
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Posting)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Cetak)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FlHapus)
                </th>
                <th class="action-button" width="5%"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var tabletype = item.FlHapus == 1 ? "table-danger" : null;
                <tr class="@tabletype">
                    <td></td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NoJurnal)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.JKW.Kod)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Tarikh, "{0:dd/MM/yyyy}")
                    </td>
                    <td align="right">
                        @Convert.ToDecimal(item.JumDebit).ToString("#,##0.00")
                    </td>
                    <td align="right">
                        @Convert.ToDecimal(item.JumKredit).ToString("#,##0.00")
                    </td>
                    <td>
                        @if (item.Posting == 0)
                        {
                            <label class="mb-0">BELUM</label>
                        }
                        else
                        {
                            <label class="mb-0">SUDAH</label>
                        }
                    </td>
                    <td>
                        @if (item.Cetak == 0)
                        {
                            <label class="mb-0">BELUM</label>
                        }
                        else
                        {
                            <label class="mb-0">SUDAH</label>
                        }
                    </td>
                    <td>
                        @if (item.FlHapus == 0)
                        {
                            <label class="mb-0">TIDAK</label>
                        }
                        else
                        {
                            <label class="mb-0">YA</label>
                        }
                    </td>
                    <td class="action-button">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Ubah/Papar"><i class="fas fa-edit"></i></a>
                        <a asp-action="PrintPdf" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Cetak" target="_blank" id="btnCetak"><i class="fas fa-print"></i></a>
                        @if (item.FlHapus == 0)
                        {
                            @if (item.Posting == 0)
                            {
                                @if (item.Cetak != 0)
                                {
                                    <a asp-action="Posting" asp-route-id="@item.Id" class="btn btn-success btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Kemaskini Lejar">
                                        <i class="fas fa-sync"></i>
                                    </a>
                                }

                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Hapus"><i class="fas fa-trash"></i></a>
                            }
                            else
                            {
                                <a asp-action="UnPosting" asp-route-id="@item.Id" class="btn btn-warning btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Batal Kemaskini Lejar">
                                    <i class="fas fa-sync"></i>
                                </a>
                            }
                        }
                        else
                        {
                            if (User.IsInRole("Supervisor") || User.IsInRole("SuperAdmin"))
                            {
                                <a asp-action="Rollback" asp-route-id="@item.Id" class="btn btn-warning btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Rollback">
                                    <i class="fas fa-trash-restore"></i>
                                </a>

                            }
                        }

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
