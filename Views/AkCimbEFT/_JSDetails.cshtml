<script type="text/javascript">
    $(document).ready(function () {

        var table = $('#tblBaucer').DataTable({
            "paging": false,
            rowReorder: false,
            columnDefs: [
                { orderable: false, targets: '_all' }
            ],
            "scrollY": "30vh",
            "scrollX": false,
            "scrollCollapse": false,
            "paging": false,
            dom: 'lrt'
        }).draw();

        table.on('order.dt search.dt', function () {
            table.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();

    });

        function saveStaticDataToFile(id) {
        var blob = "";
        var namaFail = "@Model.NamaFail";
        $.ajax({
            type: "POST",
            //url: "/AkPV/JsonGetKod",
            url: '@Url.Action("JsonJanaTxt", "AkCimbEFT")',
            data: { id: id },
            dataType: "json",
            success: function (msg) {
                //if (msg.record.length > 0) {
                //    for (var i = 0; i < msg.record.length; i++) {
                //        var item1 = msg.record[i];
                //         str += item1 + '/n';
                //    }
                //}
                var blob = new Blob([msg.record.join('\n')],
                    { type: "text/plain;charset=utf-8" });

                saveAs(blob, namaFail);
            },
            error: function (req, status, error) {
                alert(error);
            }
        });

    }

</script>