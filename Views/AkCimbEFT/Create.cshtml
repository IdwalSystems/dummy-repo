@model MSNK.Models.Modules.AkCimbEFT

@{
    ViewData["Title"] = "Tambah";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_JSCreate" />
<div class="row">
    <div class="col-md-12">

        <form asp-action="Create" class="needs-validation">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="card box-shadow border-success mb-3" id="denganPesananTempatan">
                <div class="card-header bg-success text-white">
                    <h5>Invois Pembekal - @ViewData["Title"]</h5>
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="col-md-12">
                            <div class="card mb-2">
                                <div class="card-body pb-1 pt-1">
                                    <div class="form-group mb-0 mt-1">
                                        <label class="control-label">Jenis Janaan</label>
                                    </div>
                                    <div class="form-row col-sm ml-2">
                                        <div class="custom-control custom-radio col-md-4 " >
                                            <input class="custom-control-input " type="radio" id="FlKategori0" asp-for="FlKategori" value="false" checked>
                                            <label class="custom-control-label" for="FlKategori0">
                                                Tanpa Emel
                                            </label>
                                        </div>
                                        <div class="custom-control custom-radio col-md-4 " >
                                            <input class="custom-control-input " type="radio" id="FlKategori1" asp-for="FlKategori" value="true">
                                            <label class="custom-control-label" for="FlKategori1">
                                                Dengan Emel
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label asp-for="NoPBI" class="control-label"></label>
                                <input asp-for="NoPBI" class="form-control form-control-sm" required readonly value="@ViewBag.NoPBI"/>
                                <span asp-validation-for="NoPBI" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label asp-for="TarJana" class="control-label"></label>
                                <input asp-for="TarJana" class="form-control form-control-sm" value="@DateTime.Now.ToString("s")" required />
                                <span asp-validation-for="TarJana" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label asp-for="TarBayar" class="control-label"></label>
                                <input asp-for="TarBayar" class="form-control form-control-sm" value="@DateTime.Now.ToString("s")" required />
                                <span asp-validation-for="TarBayar" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="NamaFail" class="control-label"></label>
                                <input asp-for="NamaFail" class="form-control form-control-sm" required readonly value="@ViewBag.NamaFail"/>
                                <span asp-validation-for="NamaFail" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="AkBankId" class="control-label"></label><span class="text-danger control-label">*</span>
                                <select class="form-control select2 input-group-sm" asp-for="AkBankId" required>
                                    @foreach (var s in ViewBag.AkBank)
                                    {
                                        <option value="@s.Id">@s.NoAkaun - @s.JBank.Nama</option>
                                    }
                                </select>
                                <span asp-validation-for="AkBankId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-row">

                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">Tarikh Baucer</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-inline">
                        <div class="form-group mr-2">
                            <input type="date" name="TarDari" class="form-control form-control-sm" id="TarDari"/>
                        </div>
                        <div class="form-group mr-2">
                            <input type="date" name="TarHingga" class="form-control form-control-sm" id="TarHingga"/>
                        </div>
                        <div class="form-group">
                            <a class="btn btn-primary text-white btn-sm" onclick="JanaKelompok()">Jana Kelompok</a>
                        </div>
                    </div>
                    @*table baucer*@
                    <div class="card box-shadow mb-3 mt-2">
                        <div class="card-header">
                            <h6>Senarai Baucer</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive-md">
                                <table id="tblBaucer" class="table table-sm" cellpadding="0" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Bil</th>
                                            <th>No Baucer</th>
                                            <th width="30%">No KP</th>
                                            <th width="30%">No Akaun</th>
                                            <th>Penerima</th>
                                            <th>Amaun</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyBaucer">
                                    </tbody>
                                    <tfoot>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="form-group">
                                <label class="control-label">Jumlah Baucer</label>
                                <input class="form-control form-control-sm" id="jumlahBaucer" name="JumlahBaucer" value="0.00" readonly />
                            </div>
                        </div>
                    </div>
                    @*table baucer end*@
                </div>
            </div>

            <div class="form-group ">
                <input type="submit" id="btnSave" value="Simpan" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Kembali Ke Indeks</a>
</div>

