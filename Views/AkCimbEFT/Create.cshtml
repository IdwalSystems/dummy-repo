@model MSNK.Models.Modules.AkCimbEFT

@{
    ViewData["Title"] = "Biz Channel - Tambah";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_JSCreate" />

<div class="card box-shadow">
    <div class="card-body">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase text-success mb-0">Biz Channel - Tambah</h5>
                <span class="ac-ref"><a asp-action="Index" class="text-secondary">Indeks</a> / Tambah</span>
            </div>
            <div class="col-4 text-right">
                <a asp-action="Index" class="text-secondary"><i class="fas fa-times fa-2x"></i></a>
            </div>
    
        </div>
        <hr class="mt-2"/>
        <form asp-action="Create" class="needs-validation">
            <input asp-for="FlStatus" hidden value="1"/>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-row">
                <div class="col-md-12">
                    <div class="card mb-2" hidden>
                        <div class="card-body pb-1 pt-1">
                            <div class="form-group mb-0 mt-1">
                                <label class="control-label">Jenis Janaan</label>
                            </div>
                            <div class="form-row col-sm ml-2">
                                <div class="custom-control custom-radio col-md-4 " >
                                    <input class="custom-control-input " type="radio" id="FlKategori0" asp-for="FlKategori" value="0" checked>
                                    <label class="custom-control-label" for="FlKategori0">
                                        Tanpa Emel
                                    </label>
                                </div>
                                <div class="custom-control custom-radio col-md-4 " >
                                    <input class="custom-control-input " type="radio" id="FlKategori1" asp-for="FlKategori" value="1">
                                    <label class="custom-control-label" for="FlKategori1">
                                        Dengan Emel
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-row">
                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="NoPBI" class="control-label"></label>
                        <input asp-for="NoPBI" class="form-control form-control-sm" required readonly value="@ViewBag.NoPBI"/>
                        <span asp-validation-for="NoPBI" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="TarJana" class="control-label"></label>
                        <input asp-for="TarJana" class="form-control form-control-sm" value="@DateTime.Now.ToString("s")" required />
                        <span asp-validation-for="TarJana" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label asp-for="TarBayar" class="control-label"></label>
                        <input asp-for="TarBayar" class="form-control form-control-sm" value="@DateTime.Now.ToString("s")" required />
                        <span asp-validation-for="TarBayar" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="NamaFail" class="control-label"></label>
                        <input asp-for="NamaFail" class="form-control form-control-sm" required readonly value="@ViewBag.NamaFail"/>
                        <span asp-validation-for="NamaFail" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="AkBankId" class="control-label"></label><span class="text-danger control-label">*</span>
                        <select class="form-control select2 input-group-sm" asp-for="AkBankId" required>
                            @foreach (var s in ViewBag.AkBank)
                            {
                                <option value="@s.Id">@s.NoAkaun - @s.JBank.Nama</option>
                            }
                        </select>
                        <span asp-validation-for="AkBankId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-row ">

                <div class="col-md-12">
                    <div class="form-group mb-0">
                        <label class="control-label">Tarikh Baucer</label>
                    </div>
                </div>
            </div>

            <div class="form-inline mb-3">
                <div class="form-group mr-2">
                    <input type="date" name="TarDari" class="form-control form-control-sm" id="TarDari"/>
                </div>
                <div class="form-group mr-2">
                    <input type="date" name="TarHingga" class="form-control form-control-sm" id="TarHingga"/>
                </div>
                <div class="form-group">
                    <a class="btn btn-primary text-white btn-sm" onclick="JanaKelompok()">Jana Kelompok</a>
                    <span class="loading" style="padding-right:3px; padding-top: 3px; display:inline-block;" hidden>
                        <img src="~/img/Spinner.gif" style="height:40px;">
                    </span>
                </div>
            </div>
            @*table baucer*@
            <div class="card box-shadow mb-3 mt-2">
                <div class="card-header">
                    <h6>Senarai Baucer</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive-md">
                        <table id="tblBaucer" class="table table-sm" cellpadding="0" cellspacing="0">
                            <thead>
                                <tr>
                                    <th hidden>Id</th>
                                    <th width="5%">Bil</th>
                                    <th width="10%">No Baucer</th>
                                    <th width="10%">No KP</th>
                                    <th width="10%">No Akaun</th>
                                    <th width="55%">Penerima</th>
                                    <th width="10%">Amaun</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="tbodyBaucer">
                            </tbody>
                            <tfoot>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="form-row">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="control-label">Bil Baucer</label>
                                <input type="number" class="form-control form-control-sm" id="bilBaucer" asp-for="BilPV" value="0" readonly />
                            </div>
                        </div>
                        <div class="col-md-10">
                            <div class="form-group">
                                <label class="control-label">Jumlah Baucer RM</label>
                                <input class="form-control form-control-sm" id="jumlahBaucer" asp-for="Jumlah" value="0.00" readonly />
                            </div>
                        </div>
                    </div>
                            
                </div>
            </div>
            @*table baucer end*@
            <hr />
            <div class="form-group">
                <input type="submit" value="Simpan" id="btnSave" class="btn ac-primary btn-sm" />
                 <a asp-action="Index" class="btn ac-secondary btn-sm" style="width:auto">Batal</a>
            </div>
        </form>
    </div>
</div>
