<script type="text/javascript">
    // onchange no Rujukan
    $("body").on('change', "#TarJana", function () {
        var tarJana = $("#TarJana").val();
        var noPBI = moment(tarJana).format('YYYYMM');
        if (tarJana != null || tarJana != undefined) {
            JsonKod(tarJana, noPBI);
        }

    });

    function JsonKod(tarJana, noPBI) {
        $.ajax({
            type: "POST",
            //url: "/AkPV/JsonGetKod",
            url: '@Url.Action("JsonGetKod", "AkCimbEFT")',
            data: { tarJana: tarJana, noPBI: noPBI },
            dataType: "json",
            success: function (msg) {
                if (msg.record) {
                    $("#NoPBI").val(msg.record);
                    $("#NamaFail").val(msg.record + ".txt");
                }
            },
            error: function (req, status, error) {
                alert(error);
            }
        });
    }
    // onchange no Rujukan end

    // jana kelompok
    function JanaKelompok() {
        var tarDari = $("#TarDari").val();
        var tarHingga = $("#TarHingga").val();

        var jumlah = $("#jumlahBaucer");
        var bilBaucer = $("#bilBaucer");

        if (tarHingga < tarDari)
        {
            $("#TarHingga").val(tarDari);
        }

        $.ajax({
            type: "POST",
            //url: "/AkPV/JsonGetKod",
            url: '@Url.Action("JsonGetBaucer", "AkCimbEFT")',
            data: { tarDari: tarDari, tarHingga: tarHingga },
            dataType: "json",
            success: function (msg) {
                //refresh updated table Baucer\
                $("table tbody#tbodyBaucer").empty();
                var sum = 0;
                var bil = 0;
                if (msg.table.length > 0) {
                    for (var i = 0; i < msg.table.length; i++) {
                        var item1 = msg.table[i];
                        var str = "<tr><td id='Indek' hidden>" + item1.indek +
                            "</td><td class='text-uppercase'>" + item1.indek +
                            "</td><td class='text-uppercase'>" + item1.noPV +
                            "</td><td class='text-uppercase'>" + item1.noKP +
                            "</td><td class='text-uppercase'>" + item1.noAkaun +
                            "</td><td class='text-uppercase'>" + item1.penerima +
                            "</td><td class='text-right'>" + (item1.amaun).toFixed(2) +
                            "</td><tr>";
                        $("table tbody#tbodyBaucer").append(str);
                        sum += item1.amaun;
                        bil++;
                    }
                }
                jumlah.val(sum.toFixed(2));
                bilBaucer.val(bil);
            },
            error: function (req, status, error) {
                alert(error);
            }
        });
    }
    // jana kelompok end
</script>