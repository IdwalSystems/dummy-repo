@model dynamic;

@{
    ViewData["Title"] = "Cetakan LPB00101";
    Layout = "~/Views/Shared/_PrintLayout.cshtml";
    CompanyDetails company = new CompanyDetails();

    int kodCount = 0;
    int kodCountInPage = 0;
}
<style>

    .image-container {
        width: 80px;
        height: 80px;
        text-align: center;
    }

        .image-container img {
            height: 100%;
        }

    .topic tr {
        line-height: 1rem;
    }

    .center {
        padding: 70px 0;
        border: 3px solid green;
        text-align: center;
    }

    .notbold {
        font-weight: normal
    }

    .max-lines {
        display: block; /* or inline-block */
        text-overflow: ellipsis;
        word-wrap: break-word;
        overflow: hidden;
        max-height: 5.8em;
    }

    .breakhere {
        page-break-after: always
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-row-group
    }

    tr {
        page-break-inside: avoid;
        padding-right: 5px;
    }
</style>
<table class="table table-borderless table-sm topic">
    <thead>
        <tr>
            <th class="bg-white" style="width:8%;">
                <img class="image-container mb-2" src="~/img/@ViewData["CompanyLogoPrintPDF"]" alt="Logo syarikat" />
            </th>
            <th colspan="10" class=" text-uppercase">
                <strong>
                    @company.NamaSyarikat
                    <br />
                    @company.AlamatSyarikat1,
                    @company.AlamatSyarikat2,
                    @company.AlamatSyarikat3
                    <br />
                    SENARAI LEJAR BUKU VOT @Model.printModel.ParamCarta BAGI KW : @Model.printModel.ParamKW
                    <br />
                    BAHAGIAN : @Model.printModel.ParamBahagian
                    <br />
                    DARI TARIKH : @Model.printModel.ParamTarikh
                </strong>
            </th>
            <th class="text-right" style="width:10%;">
                <small>
                    Laporan : @Model.printModel.KodLaporan
                    <br />
                    @DateTime.Now
                </small>

            </th>
        </tr>
    </thead>
</table>
@foreach (var group in Model.AbBukuVotGrouped)
{
    kodCount++;
}
@{ 
    //string JBahagian = Model.Key.JBahagian;
}
@foreach (var group in Model.AbBukuVotGrouped)
{
    kodCountInPage++;
    <table class="table table-bordered table-sm topic">
        <thead>
            @foreach (var item in group)
            {
                <tr><th colspan="9" class="text-uppercase bg-dark text-white font-weight-bold"> @item.JBahagian - @item.Vot</th></tr>
                break;
            }
            @**@
            <tr style="line-height:0.8rem;" class="bg-secondary text-white">


                <th class="thbil" width="2%">
                    BIL
                </th>
                <th width="5%">
                    TARIKH
                </th>
                <th width="25%">
                    NAMA
                </th>
                <th width="20%">
                    NO RUJUKAN
                </th>
                <th width="3%">
                    DEBIT RM
                </th>
                <th width="3%">
                    KREDIT RM
                </th>
                <th width="3%">
                    TANGG. RM
                </th>
                <th width="3%">
                    LIABILITI RM
                </th>
                <th width="5%">
                    BAKI RM
                </th>
            </tr>
        </thead>
        <tbody>

            @{
                int rowNo = 0;
                decimal baki = 0;
            }


            @foreach (var item in group)
            {

                <tr>
                    <td class="bil">
                        @(rowNo += 1)
                    </td>

                    <td>
                        @item.Tarikh.ToString("dd/MM/yyyy")
                    </td>
                    <td>
                        @if (item.Nama.Length > 52)
                        {
                            item.Nama = item.Nama.Substring(0, 52) + "..";
                        }
                        @item.Nama
                    </td>
                    <td>
                        @item.NoRujukan
                    </td>
                    <td class="debit text-right">
                        @Convert.ToDecimal(item.Debit).ToString("#,##0.00")
                    </td>
                    <td class="kredit text-right">
                        @Convert.ToDecimal(item.Kredit).ToString("#,##0.00")
                    </td>
                    <td class="kredit text-right">
                        @Convert.ToDecimal(item.Tanggungan).ToString("#,##0.00")
                    </td>
                    <td class="kredit text-right">
                        @Convert.ToDecimal(item.Liabiliti).ToString("#,##0.00")
                    </td>
                    <td class="total text-right">
                        @{
                            baki += item.Kredit - item.Debit - item.Tanggungan;// - item.Liabiliti;
                        }
                        @Convert.ToDecimal(baki).ToString("#,##0.00")
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
        </tfoot>
    </table>
    <br />
    <br />
    <br />
    <div class="table-responsive-sm">
        <table class="table table-sm topic table-bordered">
            <thead class="table-dark">

            </thead>
            <tbody>

                <tr>
                    <td class="text-center">Disedia </td>
                    <td class="text-center">Disemak </td>
                    <td class="text-center">Diluluskan </td>
                </tr>
                <tr>
                    <td class="text-center" height="50px"></td>
                    <td class="text-center" height="50px"></td>
                    <td class="text-center" height="50px"></td>

                </tr>
                <tr>
                    <td class="text-center text-uppercase">@Model.printModel.Username</td>
                    <td class="text-center">@Model.printModel.Penyemak</td>
                    <td class="text-center">@Model.printModel.Pelulus</td>

                </tr>
                <tr>
                    <td class="text-center text-uppercase">Pembantu Tadbir (Kewangan)</td>
                    <td class="text-center">@Model.printModel.JawatanPenyemak</td>
                    <td class="text-center">@Model.printModel.JawatanPelulus</td>

                </tr>
                <tr>
                    <td class="text-center">Majlis Sukan Negeri Kedah</td>
                    <td class="text-center">Majlis Sukan Negeri Kedah</td>
                    <td class="text-center">Majlis Sukan Negeri Kedah</td>

                </tr>
                <tr>
                    <td class="text-center">@DateTime.Now.ToString()</td>
                    <td class="text-center"></td>
                    <td class="text-center"></td>
                </tr>
            </tbody>
        </table>
    </div>
    if (kodCount != kodCountInPage)
    {
        <p class="breakhere"></p>
    }

}
