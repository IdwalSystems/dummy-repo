@{
    ViewData["Title"] = "Halaman Utama";
}

@*div Header*@
<div class="row">
    <div class="col-8">
        <h5 class="text-secondary text-uppercase">Dashboard</h5>
    </div>
    
</div>
<hr class="mt-0" />
@*div Header end*@
