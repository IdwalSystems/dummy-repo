
<script type="text/javascript">
    var columnSearchVar;
    $(document).ready(function () {

        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            tableNM.columns.adjust();
        });

        var tableNM = $('.tableNM').DataTable({
            "paging": false,
            rowReorder: false,
            columnDefs: [
                { orderable: false, targets: '_all' }
            ],
            "scrollY": "40vh",
            "scrollX": true,
            "scrollCollapse": true,
            "paging": false,
            dom: 'lrtip',
            "language": {
                "info": "_TOTAL_ entri yang dipamerkan",
                "infoEmpty": "Tiada data untuk dipamerkan",
                "infoFiltered": " - ditapis daripada _MAX_ jumlah keseluruhan rekod"
            }
        });

        tableNM.columns.adjust();

        $('#columnSearch').change(function () {
            columnSearchVar = $(this).val();
            // refresh table
            tableNM.destroy();

            tableNM = $('.tableNM').DataTable({
                "paging": false,
                rowReorder: false,
                columnDefs: [
                    { orderable: false, targets: '_all' }
                ],
                "scrollY": "40vh",
                "scrollX": true,
                "scrollCollapse": true,
                "paging": false,
                dom: 'lrtip',
                "language": {
                    "info": "_TOTAL_ entri yang dipamerkan",
                    "infoEmpty": "Tiada data untuk dipamerkan",
                    "infoFiltered": " - ditapis daripada _MAX_ jumlah keseluruhan rekod"
                }
            });

            // refresh table end
        });

    });
</script>

@if (Model.AkNotaMinta.Count > 0)
{
    <div class="card box-shadow">
        <div class="card-header bg-transparent container-fluid">

            <div class="row">
                <div class="col-md-6">
                    <h5 class=" mb-0 text-info">Status Nota Minta</h5>
                </div>

            </div>

        </div>
        <div class="card-body">
            <div class="table-responsive table-sm">
                <table class="table tableNM table-bordered table-hover display compact nowrap" width="100%">
                    <thead>
                        <tr>
                            <th width="5%">Tarikh</th>
                            <th>No Rujukan</th>
                            <th>
                                Pembekal
                            </th>
                            <th width="5%">
                                Tindakan
                            </th>
                            <th width="5%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AkNotaMinta)
                        {
                            var tindakan = "";
                            var badgeType = "ac-warning";

                            if(item.NoSiri == null)
                            {
                                tindakan = "KEWANGAN";

                            }
                            else
                            {
                                tindakan = "LULUS";
                                badgeType = "ac-success";
                            }
                            <tr class="text-uppercase ">
                                <td width="5%" data-sort='YYYYMMDD'>
                                    @item.Tarikh.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @item.NoRujukan
                                </td>
                                <td class="text-uppercase">
                                    @item.AkPembekal.KodSykt - @item.AkPembekal.NamaSykt
                                </td>
                                <td>
                                    <div class="mt-sm-1 d-block" width="5%">
                                        <span class="badge @badgeType rounded-pill text-white p-1 px-2">
                                            @tindakan
                                        </span>
                                    </div>
                                </td>
                                <td class="action-button text-center" width="5%">
                                <div class="btn-group" role="group" aria-label="action">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn text-primary btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Ubah/Papar"><i class="fas fa-edit"></i></a>
                                    <a asp-action="PrintPdf" asp-route-id="@item.Id" class="btn text-secondary btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Cetak" target="_blank"><i class="fas fa-print"></i></a>
                                    @if (item.FlHapus == 0)
                                    {
                                        @if (item.FlPosting == 0)
                                        {
                                            @if (item.Jumlah != 0)
                                            {
                                                @if (item.Jumlah == item.JumlahPerihal && item.FlCetak != 0)
                                                {

                                                    @if (item.FlStatusSemak != 0)
                                                    {
                                                        <button data-toggle="modal" data-target="#modalPosting" class="btn text-success btn-sm bg-white" type="button" data-placement="top" title="Lulus" onclick="ModalClick(this)">
                                                            <i class="fas fa-file-signature"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button data-toggle="modal" data-target="#modalSemak" class="btn btn-sm bg-white text-purple" type="button" data-placement="top" title="Semak" onclick="ModalClick(this)">
                                                            <i class="fas fa-file-signature"></i>
                                                        </button>
                                                    }
                                                }
                                            }

                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn text-danger btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Hapus"><i class="fas fa-trash"></i></a>

                                        }
                                        else
                                        {
                                            <a asp-action="UnPosting" asp-route-id="@item.Id" class="btn text-warning btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Batal Lulus">
                                                <i class="fas fa-file"></i>
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        if (User.IsInRole("Supervisor") || User.IsInRole("SuperAdmin"))
                                        {
                                            <a asp-action="Rollback" asp-route-id="@item.Id" class="btn text-info btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Rollback">
                                                <i class="fas fa-trash-restore"></i>
                                            </a>

                                        }
                                    }
                                </div>

                            </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>


        </div>
    </div>
}
else
{

}

