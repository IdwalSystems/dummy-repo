@model dynamic

<script type="text/javascript">
    var columnSearchVar;
    $(document).ready(function () {

        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            tablePP.columns.adjust();
        });

        var tablePP = $('.tablePP').DataTable({
            "paging": false,
            rowReorder: false,
            columnDefs: [
                { orderable: false, targets: '_all' }
            ],
            "scrollY": "40vh",
            "scrollX": true,
            "scrollCollapse": true,
            "paging": false,
            dom: 'lrtip',
            "language": {
                "info": "_TOTAL_ entri yang dipamerkan",
                "infoEmpty": "Tiada data untuk dipamerkan",
                "infoFiltered": " - ditapis daripada _MAX_ jumlah keseluruhan rekod"
            }
        });

        tablePP.columns.adjust();

        $('#columnSearch').change(function () {
            columnSearchVar = $(this).val();
            // refresh table
            tablePP.destroy();

            tablePP = $('.tablePP').DataTable({
                "paging": false,
                rowReorder: false,
                columnDefs: [
                    { orderable: false, targets: '_all' }
                ],
                "scrollY": "40vh",
                "scrollX": true,
                "scrollCollapse": true,
                "paging": false,
                dom: 'lrtip',
                "language": {
                    "info": "_TOTAL_ entri yang dipamerkan",
                    "infoEmpty": "Tiada data untuk dipamerkan",
                    "infoFiltered": " - ditapis daripada _MAX_ jumlah keseluruhan rekod"
                }
            });

            // refresh table end
        });

    });
</script>

@if (Model.SpPendahuluanPelbagai.Count > 0)
{
    <div class="card box-shadow">
        <div class="card-header bg-transparent container-fluid">

            <div class="row">
                <div class="col-md-6">
                    <h5 class=" mb-0 text-info">Status Pendahuluan Pelbagai</h5>
                </div>

            </div>

        </div>
        <div class="card-body">
            <div class="table-responsive table-sm">
                <table class="table tablePP table-bordered table-hover display compact nowrap" width="100%">
                    <thead>
                        <tr>
                            <th width="5%">Tarikh</th>
                            <th width="10">No Permohonan</th>
                            <th>
                                Pemohon
                            </th>
                            <th>
                                Tajuk
                            </th>
                            <th width="5%">
                                Tindakan
                            </th>
                            <th width="5%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SpPendahuluanPelbagai)
                        {
                            var tindakan = "KEWANGAN";
                            var badgeType = "badge-warning";

                            var namaPekerja = "";
                            var noGaji = "";
                            if (item.SuPekerja != null)
                            {
                                namaPekerja = item.SuPekerja.Nama;
                                noGaji = item.SuPekerja.NoGaji;
                            }
                            @*if(item.NoSiri == null)
                            {
                                tindakan = "KEWANGAN";

                            }
                            else
                            {
                                tindakan = "LULUS";
                                badgeType = "badge-secondary";
                            }*@
                            <tr class="text-uppercase ">
                                <td width="5%" data-sort='YYYYMMDD'>
                                    @item.TarMasuk.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @item.NoPermohonan
                                </td>
                                <td class="text-uppercase">
                                    @noGaji - @namaPekerja
                                </td>
                                <td class="text-uppercase">
                                    @item.Aktiviti
                                </td>
                                <td>
                                    <div class="mt-sm-1 d-block" width="5%">
                                        <span class="badge @badgeType rounded-pill text-white p-1 px-2">
                                            @tindakan
                                        </span>
                                    </div>
                                </td>
                                <td class="action-button" width="5%">
                                    <div class="btn-group" role="group" aria-label="action">
                                        <a asp-action="Details" asp-controller="SpPendahuluanPelbagai" asp-route-id="@item.Id" class="btn text-primary btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Ubah/Papar"><i class="fas fa-edit"></i></a>
                                        <a asp-action="PrintPdf" asp-controller="SpPendahuluanPelbagai" asp-route-id="@item.Id" class="btn text-secondary btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Cetak" target="_blank"><i class="fas fa-print"></i></a>
                                        @if (item.FlPosting == 0)
                                        {
                                            @if (item.FlCetak != 0)
                                            {
                                                <a asp-action="Posting" asp-controller="SpPendahuluanPelbagai" asp-route-id="@item.Id" class="btn text-success btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Lulus">
                                                    <i class="fas fa-file-signature"></i>
                                                </a>
                                            }

                                            <a asp-action="Delete" asp-controller="SpPendahuluanPelbagai" asp-route-id="@item.Id" class="btn text-danger btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Hapus"><i class="fas fa-trash"></i></a>

                                        }
                                    </div>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>


        </div>
    </div>
}
else
{

}

