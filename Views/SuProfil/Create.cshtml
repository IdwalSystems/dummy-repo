@model MSNK.Models.Modules.SuProfil

@{
    ViewData["Title"] = "Tambah";
}

<h4>Profil - Tambah</h4>

<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">

                @*table Peserta*@
                <div class="card box-shadow mb-2">
                    <div class="card-header">
                        <h6>SENARAI PENERIMA SKIM KECEMERLANGAN ATLET</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive-md">
                            <table id="tblPeserta" class="table table-sm" cellpadding="0" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th>NAMA</th>
                                        <th>NO. K/P</th>
                                        <th>NO. AKAUN</th>
                                        <th>BANK</th>
                                        <th>TUNGGAKAN</th>
                                        <th>AMAUN</th>
                                        <th>JUMLAH</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyObjek">
                                </tbody>
                                <tfoot>
                                    <tr>
                                        @*<td>
            <select class="form-control form-control-sm" id="ddlAtlet">
                <option value="" hidden>-- Pilih --</option>
                @foreach (var s in ViewBag.SuProfil)
                {
                    <option value="@s.Id">@s.Nama </option>
                }
            </select>
        </td>*@
                                        <td><input class="form-control form-control-sm atlet" type="text" id="txtAtlet" maxlength="50" value="-"></td>
                                        <td><input class="form-control form-control-sm nokp" type="number" id="txtNoKP" maxlength="20" value="-"></td>
                                        <td><input class="form-control form-control-sm noakaun" type="number" id="txtNoAkaun" maxlength="20" value="-"></td>
                                        <td><input class="form-control form-control-sm bank" type="number" id="txtBank" maxlength="10" value="-"></td>
                                        <td><input class="form-control form-control-sm tunggakan" type="number" id="txtTunggakan" maxlength="4" value="0.00"></td>
                                        <td><input class="form-control form-control-sm amaun" type="number" id="txtAmaun" maxlength="4" value="0.00"></td>
                                        <td><input class="form-control form-control-sm" type="number" id="txtJumlahPeserta" maxlength="4" readonly value="0.00"></td>
                                        <td><button class="btn btn-success btn-sm" type="button" id="btnAdd1"><i class="fas fa-plus"></i></button></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="form-group">
                            <label class="control-label">Jumlah Peserta</label>
                            <input class="form-control form-control-sm" id="jumlahPeserta" value="0" readonly />
                        </div>
                    </div>
                </div>
                @*table Peserta end*@


            </div>
            <div class="form-group">
                <input type="submit" value="Simpan" class="btn btn-primary btn-sm" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Kembali ke Indeks</a>
</div>

