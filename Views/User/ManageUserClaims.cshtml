@model MSNK.Models.Modules.ViewModel.UserClaimsViewModel

<script type="text/javascript">
    function check_uncheck_checkbox(isChecked) {
        if (isChecked) {
            $('input[class="form-check-input"]').each(function () {
                this.checked = true;
            });
        } else {
            $('input[class="form-check-input"]').each(function () {
                this.checked = false;
            });
        }
    }
    $(document).ready(function () {
        var table = $('.table').DataTable({
            "paging": false,
            rowReorder: true,
            columnDefs: [
                { orderable: true, className: 'reorder', targets: 1 },
                { orderable: true, className: 'reorder', targets: 2 },
                { orderable: false, targets: '_all' }
            ],
            "order": [[2, "asc"]],
            "language": {
                "emptyTable": "Tiada data wujud buat masa ini"
            },
            dom: 'lrt'
        });

        table.on('order.dt search.dt', function () {
            table.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();

        $('#columnSearch').change(function () {
            columnSearchVar = $(this).val();
            // refresh table
            $('#myInput').val('');
            table.destroy();

            table = $('.table').DataTable({
                "paging": false,
                rowReorder: true,
                columnDefs: [
                    { orderable: true, className: 'reorder', targets: 1 },
                    { orderable: true, className: 'reorder', targets: 2 },
                    { orderable: false, targets: '_all' }
                ],
                "order": [[2, "asc"]],
                dom: 'lrt'
            });
            // refresh table end
        });

        table.on('order.dt search.dt', function () {
            table.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();

        $('#myInput').on('keyup', function () {
            if (!columnSearchVar) {
                table
                    .search(this.value)
                    .draw();
            }
            else {
                table
                    .columns(columnSearchVar)
                    .search(this.value)
                    .draw();
            }
        });

        // Handle form submission event
        $('#btn-submit').on('click', function (e) {
            e.preventDefault();

            var data = table.$('input[type="checkbox"]').serializeArray();

            // Include extra data if necessary
            // data.push({'name': 'extra_param', 'value': 'extra_value'});

            @*$.ajax({
                type: "POST",
                url: '@Url.Action("JsonSubmit", "User")',
                data: data
            }).done(function (response) {
                console.log('Response', response);
            });*@
        });
    });


</script>
<div class="row mb-2">
    <div class="col-8">
        <h3 class="text-left">Capaian Pengguna</h3>
    </div>
    <div class="col-4 text-right">
        <a class="text-right btn btn-primary text-white" id="btn-submit">Simpan</a>
    </div>
</div>
<form method="post">
    <input asp-for="@Model.UserId" hidden />
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover text-nowrap table-sm nowrap compact" width="100%">
                    <thead>
                        <tr class="table-secondary">
                            <th>Bil</th>
                            <th class="kod">
                                Kod
                            </th>
                            <th class="nama">
                                Nama
                            </th>
                            <th>
                                Pilihan
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Claims.Count; i++)
                        {
                            <tr>
                                <td></td>
                                <td>
                                    <input asp-for="@Model.Claims[i].ClaimType" hidden />
                                    @Model.Claims[i].ClaimType
                                </td>
                                <td>
                                    @Model.Claims[i].ClaimValue
                                </td>
                                <td>
                                    <input type="checkbox" class="form-check-label" asp-for="@Model.Claims[i].IsSelected" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <input type="submit" value="Simpan" class="btn btn-primary" />
        </div>
    </div>
</form>
    
