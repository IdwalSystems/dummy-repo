@model MSNK.Models.Modules.AkBelian

@{
    ViewData["Title"] = "Tambah";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_JSCreate" />
<div class="row">
    <div class="col-md-12">
          
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="card box-shadow border-success mb-3" id="denganPesananTempatan">
                <div class="card-header bg-success text-white">
                    <h5>Invois Pembekal Dengan Pesanan Tempatan - @ViewData["Title"]</h5>
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="col-md-1">
                            <div class="form-group">
                                <label asp-for="Tahun" class="control-label"></label>
                                <input asp-for="Tahun" class="form-control form-control-sm" />
                                <span asp-validation-for="Tahun" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="NoInbois" class="control-label"></label>
                                <input asp-for="NoInbois" class="form-control form-control-sm text-uppercase" />
                                <span asp-validation-for="NoInbois" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Tarikh" class="control-label"></label>
                                <input asp-for="Tarikh" class="form-control form-control-sm" />
                                <span asp-validation-for="Tarikh" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label asp-for="JKWId" class="control-label"></label><span class="text-danger control-label">*</span>
                                <select class="form-control form-control-sm" asp-for="JKWId">
                                    <option value="" hidden>-- Pilih Kumpulan Wang --</option>
                                    @foreach (var s in ViewBag.JKW)
                                    {
                                        <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="AkPOId" class="control-label"></label><span class="text-danger control-label">*</span>
                                <select class="form-control form-control-sm select2" asp-for="AkPOId">
                                    <option value="" disabled selected>-- Pilih No PO --</option>
                                    @foreach (var s in ViewBag.AkPO)
                                    {
                                        <option value="@s.Id">@s.NoPO</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-2">
                            <label asp-for="AkPembekalId" class="control-label"></label><span class="text-danger control-label">*</span>
                            <select class="form-control form-control-sm select2" asp-for="AkPembekalId" id="ddlKodPembekal">
                                <option value="0" disabled selected>-- Pilih Kod Pembekal --</option>
                                @foreach (var s in ViewBag.AkPembekal)
                                {
                                    <option value="@s.Id">@s.KodSykt - @s.NamaSykt</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-10">
                            <div class="form-group">
                                <label class="control-label">Nama Pembekal</label>
                                <input id="txtNamaPembekal" class="form-control form-control-sm text-uppercase" readonly />
                            </div>
                        </div>
                    </div>
                    @*table Objek*@
                    <div class="card box-shadow mb-3 mt-2">
                        <div class="card-header">
                            <h6>Objek</h6>
                        </div>
                        <div class="card-body">
                            <table id="tblObjek" class="table table-sm nowrap" cellpadding="0" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th style="width:40%">Kod</th>
                                        <th style="width:50%">Amaun</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td id="akCartaId" hidden></td>
                                        <td style="width:40%">
                                            <select class="form-control form-control-sm select2" id="txtKodAkaun">
                                                <option value="" disabled selected>-- Pilih Kod Akaun --</option>
                                                @foreach (var s in ViewBag.AkCarta)
                                                {
                                                    <option value="@s.Id">@s.Kod - @s.Perihal </option>
                                                }
                                            </select>
                                        </td>
                                        <td style="width:50%"><input class="form-control form-control-sm" type="number" id="txtAmaunObjek" step="0.01"></td>
                                        <td><button class="btn btn-success btn-sm" type="button" id="btnAdd1"><i class="fas fa-plus"></i></button></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                    </div>
                    @*table Objek end*@
                </div>
            </div>
            
                @*<div class="form-group" hidden>
                    <label asp-for="Jumlah" class="control-label"></label>
                    <input asp-for="Jumlah" class="form-control" />
                    <span asp-validation-for="Jumlah" class="text-danger"></span>
                </div>*@
                
                @*<div class="form-group" hidden>
                    <label asp-for="TarikhPosting" class="control-label"></label>
                    <input asp-for="TarikhPosting" class="form-control" />
                    <span asp-validation-for="TarikhPosting" class="text-danger"></span>
                </div>

                <div class="form-group" hidden>
                    <label asp-for="FlCetak" class="control-label"></label>
                    <input asp-for="FlCetak" class="form-control" />
                    <span asp-validation-for="FlCetak" class="text-danger"></span>
                </div>
                <div class="form-group" hidden>
                    <label asp-for="FlPosting" class="control-label"></label>
                    <input asp-for="FlPosting" class="form-control" />
                    <span asp-validation-for="FlPosting" class="text-danger"></span>
                </div>
                <div class="form-group" hidden>
                    <label asp-for="FlBatal" class="control-label"></label>
                    <input asp-for="FlBatal" class="form-control" />
                    <span asp-validation-for="FlBatal" class="text-danger"></span>
                </div>*@
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

