<script type="text/javascript">
    $(document).ready(function () {
        //$("#denganPesananTempatan").hide();
        //$("#fl1").change(function () {
        //    $("#denganPesananTempatan").show();
        //    //$("#myInput").val('');
        //    //$("#inputTarikh1").val('');
