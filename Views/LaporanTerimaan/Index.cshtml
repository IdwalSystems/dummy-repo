@{
    ViewData["Title"] = "LPR001 Laporan Daftar Resit";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int year = DateTime.Now.Year;
    DateTime firstDay = new DateTime(year, 1, 1);
    DateTime lastDay = new DateTime(year, 12, 31);
}
<script>
    //add tbl objek
    $("body").on("click", "#btnExportExcel", function () {
        //$(".loading").prop('hidden', false);
        $(".loading").css("display", "");
        $("#btnExportExcel").prop('disabled', true);
        var kodLaporan = "";
        if ($('#LPR00102').is(':checked')) {
            kodLaporan = "LPR00102";
        }
        else {
            kodLaporan = "LPR00103";
        }
        var tarikhDari = $('#tarikhDari').val();
        var tarikhHingga = $('#tarikhHingga').val();
        var status = $('#status').val();
        var susunan = $('#susunan').val();
        var AkBankId = $('#AkBankId').val();

        if (kodLaporan != "") {
            $.ajax({
                type: "POST",
                url: '@Url.Action("ExportExcel","LaporanTerimaan")',
                data: { kodLaporan: kodLaporan, tarikhDari: tarikhDari, tarikhHingga: tarikhHingga, status: status, susunan: susunan, AkBankId: AkBankId },
                dataType: "json",
                success: function (r) {
                    window.location = '/Profile/Download?fileGuid=' + r.fileGuid
                        + '&filename=' + r.fileName;
                    toastr.success("laporan berjaya dijana.", "Berjaya");
                    toastr.options.timeOut = 2000; // 2s
                    $("#btnExportExcel").prop('disabled', false);
                    $(".loading").css("display", "none");
                }
            })
        }
        
        //$(".loading").prop('hidden', true);
        
    });
</script>
<div class="container">
    <div class="card box-shadow">
        <div class="card-body">
            <div class="row">
                <div class="col-8">
                    <h5 class="text-uppercase text-info mb-0">@ViewData["Title"]</h5>
                    <span class="ac-ref">Indeks</span>
                </div>
                <div class="col-4 text-right">
                </div>

            </div>
            <hr class="mt-2" />
            <form asp-action="PRINT">
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="form-group col-sm">
                            <div class="custom-control custom-radio pb-2">

                                <input class="custom-control-input" type="radio" name="kodLaporan" id="LPR00102" value="LPR00102" checked>
                                <label class="custom-control-label" for="LPR00102">
                                    02 - Laporan Daftar Resit Terperinci - Pecahan Cara Bayar
                                </label>
                            </div>
                            <div class="custom-control custom-radio">

                                <input class="custom-control-input" type="radio" name="kodLaporan" id="LPR00103" value="LPR00103">
                                <label class="custom-control-label" for="LPR00103">
                                    03 - Laporan Daftar Resit Terperinci - Pecahan Kod Akaun
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <div class="form-group form-row">
                            <label for="Tarikh" class="col-sm-2 col-form-label">Tarikh</label>
                            <div class="col-sm-5">
                                <input type="date" class="form-control form-control-sm" id="tarikhDari" name="tarikhDari" value="@firstDay.ToString("yyyy-MM-dd")">
                            </div>
                            <div class="col-sm-5">
                                <input type="date" class="form-control form-control-sm" id="tarikhHingga" name="tarikhHingga" value="@lastDay.ToString("yyy-MM-dd")">
                            </div>
                        </div>
                        <div class="form-group form-row">
                            <label for="Status" class="col-sm-2 col-form-label">Status</label>
                            <div class="col-sm-5">
                                <select class="form-control form-control-sm input-group-sm" id="status" name="status" required>
                                    <option value="0">SEMUA</option>
                                    <option value="1">BELUM POSTING</option>
                                    <option value="2">SUDAH POSTING</option>
                                    <option value="3">BATAL</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group form-row">
                            <label for="Susunan" class="col-sm-2 col-form-label">Susunan</label>
                            <div class="col-sm-5">
                                <select class="form-control form-control-sm input-group-sm" id="susunan" name="susunan" required>
                                    <option value="0">TARIKH</option>
                                    <option value="1" selected>NO RESIT</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group form-row">
                            <label for="Susunan" class="col-sm-2 col-form-label">Bank Penerima</label>
                            <div class="col-sm-5">
                                <select class="form-control form-control-sm input-group-sm" name="AkBankId" required>
                                    <option value="0">SEMUA</option>
                                    @foreach (var s in ViewBag.AkBank)
                                    {
                                        <option value="@s.Id">@s.NoAkaun - @s.JBank.Nama</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="form-group text-right">
                    <input type="submit" value="Cetak" formtarget="_blank" class="btn ac-primary" />
                    <button type="button" formtarget="_blank" id="btnExportExcel" class="btn ac-info">Jana Excel</button>
                    <span class="loading" style="padding-right:3px; padding-top: 3px; display:inline-block;"> 
                        <img src="~/img/Spinner.gif" style="height:40px;" >
                    </span>
                </div>

            </form>
        </div>
    </div>


</div>
