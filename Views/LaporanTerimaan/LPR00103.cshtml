@model dynamic

@{
    ViewData["Title"] = "Cetakan LPR00103";
    Layout = "~/Views/Shared/_PrintLayout.cshtml";
    CompanyDetails company = new CompanyDetails();

    var bil = 0;
    int id = 0;
}
<style>

    .image-container {
        width: 80px;
        height: 80px;
        text-align: center;
    }

        .image-container img {
            height: 100%;
        }

    .topic tr {
        line-height: 1rem;
    }

    .center {
        padding: 70px 0;
        border: 3px solid green;
        text-align: center;
    }

    .notbold {
        font-weight: normal
    }

    .max-lines {
        display: block; /* or inline-block */
        text-overflow: ellipsis;
        word-wrap: break-word;
        overflow: hidden;
        max-height: 5.8em;
    }

    .breakhere {
        page-break-after: always
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-row-group
    }

    tr {
        page-break-inside: avoid
    }
</style>
<div class="row flexrow mb-3 ml-0">
    <div class="col-2 image-container">
        <img src="~/img/@ViewData["CompanyLogoPrintPDF"]" alt="Logo syarikat" />
    </div>
    <div class="col-8 text-uppercase">
        <h5 class="mb-1"><strong>@ViewData["NamaSyarikat"]</strong></h5>
        <h6 class="mb-0 text-white"> -</h6>
        <h6 class="mb-0 text-white"> -</h6>
        <h6 class="mb-0">@ViewData["Tajuk"] @Model.reportModel.JKW.Kod - @Model.reportModel.JKW.Perihal </h6>
        <h6 class="mb-0">Bagi Tarikh : @Convert.ToDateTime(Model.reportModel.TarikhDari).ToString("dd/MM/yyyy") -> @Convert.ToDateTime(Model.reportModel.TarikhHingga).ToString("dd/MM/yyyy")</h6>
    </div>

    <div class="col-2 text-right">
        <h6 class="mb-0">Tarikh: @Convert.ToDateTime(DateTime.Today).ToString("dd/MM/yyyy")</h6>
        <h6 class="mb-0">Laporan: @Model.reportModel.KodLaporan</h6>
    </div>
</div>

<table class="table table-bordered table-sm topic">
    <thead>
        <tr class="bg-secondary">
            <th class="text-center font-weight-bold text-white">BIL  </th>
            <th class="text-center font-weight-bold text-white">TARIKH  </th>
            <th class="text-center font-weight-bold text-white">NO RESIT</th>
            <th class="text-center font-weight-bold text-white">PEMBAYAR </th>
            <th class="text-center font-weight-bold text-white">KOD AKAUN DEBIT</th>
            <th class="text-center font-weight-bold text-white">KOD AKAUN KREDIT</th>
            <th class="text-center font-weight-bold text-white">DEBIT RM</th>
            <th class="text-center font-weight-bold text-white">KREDIT RM</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.reportModel.AkTerima)
        {

            @foreach (var item1 in item.AkTerima1)
            {
                //if data has more than one akTerima1, jumlah change to 0.00
                if (item.Id == id)
                {
                    item.Jumlah = 0;
                }
                else
                {
                    id = item.Id;
                }
                // end

                // if data is Batal, change row color to red
                var tabletype = "";
                if (item.FlHapus == 1)
                {
                    tabletype = "table-danger";
                }
                // end
                bil++;
                <tr class="@tabletype" style="line-height:0.8rem;">
                    @if (item.Jumlah == 0)
                    {
                        <td class="text-right" style="border-top: none; border-bottom: none;"></td>
                        <td class="text-right" style="border-top: none; border-bottom: none;"></td>
                        <td class="text-right" style="border-top: none; border-bottom: none;"></td>
                        <td class="text-right" style="border-top: none; border-bottom: none;"></td>
                        <td class="text-right" style="border-top: none; border-bottom: none;"></td>
                    }
                    else
                    {
                        <td class="text-right" style="border-bottom:none;">@id</td>
                        <td class="text-center" style="border-bottom:none;">@Convert.ToDateTime(item.Tarikh).ToString("dd/MM/yyyy")</td>
                        <td class="text-center" style="border-bottom:none;">@item.NoRujukan.Substring(3)</td>
                        <td class="text-left text-uppercase" style="border-bottom:none;">@item.Nama</td>
                        <td class="text-left text-uppercase" style="border-bottom:none;">@item.AkBank?.AkCarta?.Kod - @item.AkBank?.AkCarta?.Perihal </td>
                    }


                    <td class="text-left text-uppercase">@item1.AkCarta.Kod - @item1.AkCarta.Perihal</td>
                    @if (item.Jumlah == 0)
                    {
                        <td class="text-right" style="border-top: none; border-bottom: none;"></td>
                    }
                    else
                    {
                        <td class="text-right " style="border-bottom:none;">@Convert.ToDecimal(item.Jumlah).ToString("#,##0.00")</td>
                    }

                    <td class="text-right ">@Convert.ToDecimal(item1.Amaun).ToString("#,##0.00")</td>
                </tr>
                @if (item.FlHapus == 1 && !string.IsNullOrEmpty(item.SebabHapus))
                {
                    <tr class="@tabletype" style="line-height:0.8rem;">
                        <td class="text-uppercase" colspan="8"><strong>Sebab Batal :</strong> @item.SebabHapus</td>
                    </tr>
                }
            }

        }
        <tr class="font-weight-bold">
            <td colspan="6" class="table-borderless text-right">JUMLAH RM</td>
            <td class="text-right">@Convert.ToDecimal(Model.reportModel.Debit).ToString("#,##0.00")</td>
            <td class="text-right">@Convert.ToDecimal(Model.reportModel.Kredit).ToString("#,##0.00")</td>
        </tr>
    </tbody>
</table>

@*ringkasan*@
<div>
    <p class="breakhere"></p>
</div>

