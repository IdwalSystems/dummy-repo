@model MSNK.Models.Login.ViewModel.LoginViewModel

<h4 class="text-info">Log Masuk</h4>
<div class="row">
    <div class="col-md-8">
        <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" role="form">
            <h6>Log masuk pengguna</h6>
            <hr />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Emel" class="col-md-5"></label>
                <div class="col-md-10">
                    <input asp-for="Emel" class="form-control form-control-sm" />
                    <span asp-validation-for="Emel" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Katalaluan" class="col-md-5"></label>
                <div class="col-md-10">
                    <input asp-for="Katalaluan" class="form-control form-control-sm" />
                    <span asp-validation-for="Katalaluan" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-10">
                    <div class="custom-checkbox">
                        <label asp-for="IngatSaya">
                            <input asp-for="IngatSaya" />
                            @Html.DisplayNameFor(m => m.IngatSaya)
                        </label>

                    </div>

                </div>
            </div>
            <div class="form-group">
                <div class="col-md-4">
                    <button type="submit" class="btn btn-success form-control">Log Masuk</button>
                </div>
            </div>

            @*<p>
                <a asp-action="ForgotPassword">Terlupa katalaluan?</a>
            </p>*@
            
        </form>
    </div>
</div>

@section Scripts{
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
