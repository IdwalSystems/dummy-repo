@model MSNK.Models.Login.ViewModel.RegisterViewModel

<h4 class="text-info">Daftar</h4>
<form asp-controller="Account" asp-action="Register" method="post" role="form">
    <h6>Daftar pengguna baru</h6>
    <hr />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Email" class="col-md-5"></label>
        <div class="col-md-10">
            <input asp-for="Email" class="form-control form-control-sm" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="Nama" class="col-md-5"></label>
        <div class="col-md-10">
            <input asp-for="Nama" class="form-control form-control-sm" />
            <span asp-validation-for="Nama" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="Password" class="col-md-5"></label>
        <div class="col-md-10">
            <input asp-for="Password" class="form-control form-control-sm" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword" class="col-md-5"></label>
        <div class="col-md-10">
            <input asp-for="ConfirmPassword" class="form-control  form-control-sm" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group pb-2">
        <label asp-for="RoleSelected" class="col-md-5"></label>
        <div class="col-md-10">
            <select asp-for="RoleSelected" asp-items="@Model.RoleList" class="form-control form-control-sm">
                <option disabled selected>-- Pilih Peranan --</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-2">
            <button type="submit" class="btn btn-success btn-sm form-control">Daftar</button>
        </div>
    </div>
</form>

@section Scripts{
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
