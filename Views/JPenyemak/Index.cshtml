@model IEnumerable<MSNK.Models.Modules.JPenyemak>

@{
    ViewData["Title"] = "Penyemak";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_JSIndex" />

<div class="card box-shadow">
    <div class="card-body">
        <partial name="_TitleIndexPartial" />

        <partial name="_SearchJadualIndexPartial" />

        <div class="table-responsive table-sm">
            <table class="table table-bordered table-hover display compact nowrap" width="100%">
                <thead>
                    <tr>
                        <th width="5%">Bil</th>
                        <th class="noGaji" width="10%">
                            No Gaji
                        </th>
                        <th class="nama">
                            Nama
                        </th>
                        <th class="jawatan">
                            Jawatan
                        </th>
                        <th width="10%">
                            Min. Amaun RM
                        </th>
                        <th width="10%">
                            Maks. Amaun RM
                        </th>
                        <th width="5%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var tabletype = item.FlHapus == 1 ? "table-danger" : null;
                        <tr class="@tabletype text-uppercase">
                            <td></td>
                            <td>
                                @item.SuPekerja.NoGaji
                            </td>
                            <td class="text-uppercase">
                                @item.SuPekerja.Nama
                            </td>
                            <td class="text-uppercase">
                                @item.SuPekerja.Jawatan
                            </td>
                            <td>
                                @Convert.ToDecimal(item.MinAmaun).ToString("#,##0.00")
                            </td>
                            <td>
                                @Convert.ToDecimal(item.MaksAmaun).ToString("#,##0.00")
                            </td>
                            <td width="5%" class="action-button text-center">
                                <div class="btn-group" role="group" aria-label="action">
                                    @if (item.FlHapus == 0)
                                    {
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn text-primary btn-sm bg-white" type="button"
                                           data-toggle="tooltip" data-placement="top"
                                           title="Ubah/Papar"><i class="fas fa-edit"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn text-danger btn-sm bg-white" type="button"
                                           data-toggle="tooltip" data-placement="top"
                                           title="Hapus"><i class="fas fa-trash"></i></a>
                                    }
                                    else
                                    {
                                        if (User.IsInRole("Supervisor") || User.IsInRole("SuperAdmin"))
                                        {
                                            <a asp-action="Rollback" asp-route-id="@item.Id" class="btn text-info btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Rollback">
                                                <i class="fas fa-trash-restore"></i>
                                            </a>

                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

