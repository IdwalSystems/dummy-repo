@model IEnumerable<MSNK.Models.Modules.SpPendahuluanPelbagai>

@{
    ViewData["Title"] = "Pendahuluan Pelbagai";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<partial name="_JSIndex" />

<h1></h1>

<div class="row mb-2">
    <div class="col-8">
        <h3 class="text-left">Senarai Permohonan Pendahuluan Pelbagai</h3>
    </div>
    <div class="col-4 text-right">
        <a class="text-right btn btn-success text-white" asp-action="Create">Tambah Baru</a>
    </div>
</div>
<div class="card mb-2">
    <div class="card-body pl-3 pb-2 ">
        <label class="form-control-plaintext" for="searchselect">Carian : </label>

        <div class="form-actions no-color mb-2">
            <form asp-action="Index" method="get">
                <div class="form-row">
                    <div class="col-sm-3 mb-2">
                        <select name="searchColumn" class="custom-select form-control-sm" id="searchColumn">
                            <option value="NoPermohonan">No Permohonan</option>
                            <option value="Ppn">Nama Pemohon</option>
                            <option selected value="@ViewBag.SearchColumn">Tarikh</option>
                        </select>
                    </div>
                    <div class="col-sm-9 mb-2">
                        <div class="form-row">
                            <div class="col-10">
                                <div class="form-row">
                                    <div class="col-12">
                                        <input class="form-control form-control-sm" type="text" name="searchString" id="myInput" value="@ViewBag.SearchData1" />
                                    </div>
                                    <div class="col-6" id="myInputDate1">
                                        <input class="form-control form-control-sm mb-2" type="date" name="searchDate1" id="inputTarikh1" value="@ViewBag.SearchData1" />
                                    </div>
                                    <div class="col-6" id="myInputDate2">
                                        <input class="form-control form-control-sm" type="date" name="searchDate2" id="inputTarikh2" value="@ViewBag.SearchData2" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-2">
                                <button type="submit" class="btn btn-sm btn-info"><i class="fa fa-search"></i></button>
                            </div>
                        </div>

                    </div>

                </div>
            </form>
        </div>
    </div>
</div>

<div class="table-responsive table-sm">
    <table class="table table-bordered table-hover display compact nowrap" width="100%">
        <thead>
            <tr>
                <th width="5%">Bil</th>
                <th>
                    Id
                </th>
                <th>
                    No Permohonan
                </th>
                <th>
                    Penyedia
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Tarikh)
                </th>
                <th>
                    Aktiviti
                </th>
                <th>
                    Jumlah RM
                </th>
                <th>
                    Tempat
                </th>
                <th>
                    Cetak
                </th>
                <th>
                    Lulus
                </th>
                <th>
                    Posting
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var tabletype = item.FlHapus == 1 ? "table-danger" : null;
                <tr class="@tabletype">
                    <td></td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Id)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NoPermohonan)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.SuPekerja.Nama)
                    </td>
                    <td>
                        @item.TarMasuk.ToString("dd/MM/yyyy")
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Aktiviti)
                    </td>
                    <td align="right">@Convert.ToDecimal(item.JumKeseluruhan).ToString("#,##0.00")</td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Tempat)
                    </td>
                    <td>
                        @if (item.FlCetak == 0)
                        {
                            <label class="mb-0">BELUM</label>
                        }
                        else
                        {
                            <label class="mb-0">SUDAH</label>
                        }
                    </td>
                    <td>
                        @if (item.StatusLulus == 0)
                        {
                            <label class="mb-0">BELUM</label>
                        }
                        else
                        {
                            <label class="mb-0">SUDAH</label>
                        }
                    </td>
                    <td>
                        @if (item.FlPosting == 0)
                        {
                            <label class="mb-0">TIDAK</label>
                        }
                        else
                        {
                            <label class="mb-0">YA</label>
                        }
                    </td>
                    <td class="action-button">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Ubah/Papar"><i class="fas fa-edit"></i></a>
                        <a asp-action="PrintPdf" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Cetak" target="_blank"><i class="fas fa-print"></i></a>
                        @if (item.FlHapus == 0)
                        {
                            @if (item.FlPosting == 0)
                            {
                                @if (item.FlCetak != 0)
                                {
                                    <button data-toggle="modal" data-target="#modalSokong" class="btn btn-success btn-sm" type="button" data-placement="top" title="Lulus" onclick="Posting(this)">
                                        <i class="fas fa-file-signature"></i>
                                    </button>
                                    @if (item.StatusSokong != 0)
                                    {
                                        <button data-toggle="modal" data-target="#modalPosting" class="btn btn-success btn-sm" type="button" data-placement="top" title="Lulus" onclick="Posting(this)">
                                            <i class="fas fa-file-signature"></i>
                                        </button>
                                    }

                                }

                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Hapus"><i class="fas fa-trash"></i></a>

                            }
                            else
                            {
                                <a asp-action="UnPosting" asp-route-id="@item.Id" class="btn btn-warning btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Baatal Lulus">
                                    <i class="fas fa-file"></i>
                                </a>
                            }
                        }
                        else
                        {
                            if (User.IsInRole("Supervisor") || User.IsInRole("SuperAdmin"))
                            {
                                <a asp-action="Rollback" asp-route-id="@item.Id" class="btn btn-warning btn-sm" type="button" data-toggle="tooltip" data-placement="top" title="Rollback">
                                    <i class="fas fa-trash-restore"></i>
                                </a>

                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Sokong -->
<div class="modal fade bd-example-modal-lg" id="modalSokong" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sokong Permohonan</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Sokong" asp-controller="SpPendahuluanPelbagai" class="needs-validation">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="modal-body">

                    <input id="moId" hidden name="id" />
                    <div class="form-row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-form-label">No Permohonan</label>
                                <input type="text" class="form-control form-control-sm" id="moPermohonan" name="noPermohonan" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-form-label">Jumlah RM</label>
                                <input type="text" class="form-control form-control-sm" id="moJumlah" name="jumKeseluruhan" readonly>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-form-label">Jumlah Sokong RM</label>
                                <input type="text" class="form-control form-control-sm" id="moSokong" name="jumSokong">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Tutup</button>
                    <button type="submit" class="btn btn-success">Sokong</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Modal Sokong End -->z

<!-- Modal Posting -->
<div class="modal fade bd-example-modal-lg" id="modalPosting" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Kelulusan Permohonan</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Posting" asp-controller="SpPendahuluanPelbagai" class="needs-validation">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="modal-body">

                    <input id="moId" hidden name="id" />
                    <div class="form-row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-form-label">No Permohonan</label>
                                <input type="text" class="form-control form-control-sm" id="moPermohonan" name="noPermohonan" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-form-label">Jumlah RM</label>
                                <input type="text" class="form-control form-control-sm" id="moJumlah" name="jumKeseluruhan" readonly>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-form-label">Jumlah Sokong RM</label>
                                <input type="text" class="form-control form-control-sm" id="moSokong" name="jumSokong" readonly>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-form-label">Jumlah Lulus RM</label>
                                <input type="number" class="form-control form-control-sm" id="moLulus" name="jumLulus">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Tutup</button>
                    <button type="submit" class="btn btn-success">Lulus</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Modal Posting End -->