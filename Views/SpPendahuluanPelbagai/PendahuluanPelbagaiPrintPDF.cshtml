@model MSNK.Models.Modules.PrintModel.PendahuluanPelbagaiPrintModel

@{
    ViewData["Title"] = "Cetakan Permohonan Aktiviti (Pendahuluan Pelbagai)";
    Layout = "~/Views/Shared/_PrintLayout.cshtml";

    CompanyDetails company = new CompanyDetails();
    var bil = 0;

}
<style>
    .flexrow {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex !important;
    }

        .flexrow > div {
            -webkit-box-flex: 1;
            -webkit-flex: 1;
            flex: 1;
        }

    .image-container {
        width: 50px;
        height: 50px;
        text-align: center;
    }

        .image-container img {
            height: 100%;
        }

    h1 {
        font-size: 1.5rem;
    }

    h2 {
        font-size: 1.3rem;
    }

    h3 {
        font-size: 1.2rem;
    }

    h4 {
        font-size: 1.1rem;
    }

    h5 {
        font-size: 1rem;
    }

    h6 {
        font-size: 0.8rem;
    }

    p {
        font-size: 0.6rem;
    }

    .topic tr {
        line-height: 0.5rem;
    }

    .center {
        padding: 70px 0;
        border: 3px solid green;
        text-align: center;
    }

    .notbold {
        font-weight: normal
    }

    table tbody tr td {
        font-size: 0.8rem;
        line-height: 1.0rem;
    }

    table thead tr th {
        font-size: 0.8rem;
        line-height: 1.0rem;
    }

    .breakhere {
        page-break-after: always
    }

    /* The standalone checkbox square*/
    .checkbox {
        width: 20px;
        height: 20px;
        border: 1px solid #000;
        display: inline-block;
    }

        /* This is what simulates a checkmark icon */
        .checkbox.checked:after {
            content: '';
            display: block;
            width: 4px;
            height: 7px;
            /* "Center" the checkmark */
            position: relative;
            top: 4px;
            left: 7px;
            border: solid #000;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }
</style>
<div class="row flexrow mb-2 text-center">
    <div class="col-12 text-uppercase">
        <img class="image-container mb-2" src="~/img/MainLogo_Syarikat.png" alt="Logo syarikat" />
        <h5 class="mb-1"><strong>@company.NamaSyarikat</strong></h5>
        <p class="mb-0"> @company.AlamatSyarikat1 , @company.AlamatSyarikat2</p>
        <p class="mb-0"> @company.AlamatSyarikat3</p>
        <p class="mb-0">Tarikh Cetakan: @DateTime.Now.Date.ToString("dd/MM/yyyy") @DateTime.Now.ToString("t",CultureInfo.CreateSpecificCulture("en-us"))</p>
    </div>

    <!--<div class="col-2 text-right">-->
    @*<h6 class="mb-0"><strong>SENARAI CARTA AKAUN</strong></h6>*@
    <!--</div>-->
</div>
