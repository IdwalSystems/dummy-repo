<script type="text/javascript">

    $(document).ready(function () {
        $.validator.setDefaults({
            errorElement: "span",
            errorClass: "help-block",
            //	validClass: 'stay',
            highlight: function (element, errorClass) {
                $(element).addClass(errorClass); //.removeClass(errorClass);
                $(element).closest('.form-group').removeClass('has-success').addClass('has-error');
            },
            unhighlight: function (element, errorClass) {
                $(element).removeClass(errorClass); //.addClass(validClass);
                $(element).closest('.form-group').removeClass('has-error').addClass('has-success');
            },

            errorPlacement: function (error, element) {
                if (element.parent('.input-group').length) {
                    error.insertAfter(element.parent());
                } else {
                    error.insertAfter(element);
                }

            },

        });
    });
    //Tukar running number berdasarkan KW
    //$("body").on('change', "#txtTahun", function () {
    //    RunningNumber();
    //});

    $("body").on('change', "#ddlKW", function () {
        RunningNumber();
    });

    function RunningNumber() {

        //var tahun = $("#txtTahun").val();
        var kw = $("#ddlKW").val();

        if (kw != 0) {
            var SpPendahuluanPelbagai = {
                //Tahun: tahun,
                JKWId: kw
            };

            $.ajax({
                type: "POST",
                //url: "/AkPO/JsonGetKod",
                url: '@Url.Action("JsonGetKod", "SpPendahuluanPelbagai")',
                data: SpPendahuluanPelbagai,
                dataType: "json",
                success: function (msg) {
                    $("#txtNoPermohonan").val(msg.record);
                },
                error: function (req, status, error) {
                    alert(error);
                }
            });
        }
    }

    //add tbl Peserta
    $("body").on("click", "#btnAdd1", function () {
        //Reference the Name and Country TextBoxes.
        var ddlJantina = $("#ddlJantina");
        if (ddlJantina.val() != null) {
            JumlahPeserta(ddlJantina.val());
        }

    });

    // check if jumlahObjek is equal to jumlahUrusniaga
    function checkJumlah() {
        var jumlahObjek = $("#jumlahObjek").val();
        var jumlahPerihal = $("#jumlahPerihal").val();

        if (jumlahObjek == 0.00 && jumlahPerihal == 0.00) {
            $("#btnSave").show();
        } else {
            if (jumlahObjek == jumlahPerihal) {
                $("#btnSave").show();
            }
            else {
                $("#btnSave").hide();
            }
        }
    }
    // check end

    function JumlahPeserta(id) {
        var JJantina = {
            Id: id
        }
        if (id != "") {
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                //url: "/AkTerima/GetCaraBayar",
                url: '@Url.Action("GetJantina", "SpPendahuluanPelbagai")',
                data: JJantina,
                dataType: "json",
                success: function (r) {
                    //Reference the TextBoxes.
                    var ddlJantina = $("#ddlJantina");
                    var txtAtlet = $("#txtAtlet");
                    var txtJurulatih = $("#txtJurulatih");
                    var txtPegawai = $("#txtPegawai");
                    var txtTeknikal = $("#txtTeknikal");
                    var txtUrusetia = $("#txtUrusetia");
                    var txtJumlah = $("#txtJumlah");

                    //Sum value to Total text field
                    var sum = 0;
                    sum = parseFloat(txtAtlet.val()) + parseFloat(txtJurulatih.val()) + parseFloat(txtPegawai.val()) + parseFloat(txtTeknikal.val()) + parseFloat(txtUrusetia.val());
                    txtJumlah.val(sum);

                    //Get the reference of the Table's TBODY element.
                    var tBody = $("#tblPerihal > TBODY")[0];
                    //Add Row.
                    var row = tBody.insertRow(-1);

                    //Add Jantina cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(r.record.id);
                    cell.html(ddlJantina.val());

                    //Add Atlet cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(txtAtlet.val());

                    //Add Jurulatih cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(txtJurulatih.val());

                    //Add Pegawai cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(txtPegawai.val());

                    //Add Teknikal cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(txtTeknikal.val());

                    //Add Urusetia cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(txtUrusetia.val());

                    //Add Jumlah cell.
                    var cell = $(row.insertCell(-1));
                    cell.html(txtJumlah.val());

                    //Add Edit Button cell.
                    cell = $(row.insertCell(-1));

                    var btnUpdate2 = $("<button class='btn btn-primary btn-sm' type='button' id='btnUpdate2' onclick='Update2(this)'><i class='fas fa-edit'></i></button>");
                    cell.append(btnUpdate2);

                    //Add Button cell.
                    cell = $(row.insertCell(-1));
                    var btnRemove2 = $("<button class='btn btn-danger btn-sm' type='button' id='btnRemove1' onclick='Remove2(this)'><i class='fas fa-trash'></i></button>");
                    cell.append(btnRemove2);

                    var SpPendahuluanPelbagai1 = {
                        JJantinaId: ddlJantina.val(),
                        BilAtl: txtAtlet.val(),
                        BilJul: txtJurulatih.val(),
                        BilPeg: txtPegawai.val(),
                        BilTek: txtTeknikal.val(),
                        BilUru: txtUrusetia.val(),
                    }
                    $.ajax({
                        type: "POST",
                        //url: "/AkTerima/SaveAkTerima2",
                        url: '@Url.Action("SaveSpPendahuluanPelbagai1", "SpPendahuluanPelbagai")',
                        data: SpPendahuluanPelbagai1,
                        dataType: "json",
                        success: function (r) {
                            //Clear the TextBoxes.
                            ddlJantina.val("").trigger('change');
                            txtAtlet.val("0"),
                            txtJurulatih.val("0"),
                            txtPegawai.val("0"),
                            txtTeknikal.val("0"),
                            txtUrusetia.val("0"),
                            txtJumlah.val("0"),
                            checkJumlah();
                        }
                    });
                    $("#ddlJantina option[value=" + ddlJantina.val() + "]").prop('disabled', true);

                }
            });
        }

    }
    //add tbl Peserta end

     //add tbl Perihal
    var bil = $('#tblPerihal tr').length;
    if (bil == 0) {
        bil = 1;
    }
    $("body").on("click", "#btnAdd2", function () {
        //Reference the Name and Country TextBoxes.
        GetIndek(bil);
    });

    function GetIndek(indek) {
        //Send the JSON array to Controller using AJAX.

        //Reference the TextBoxes.
        var txtIndek = indek;
        var txtBaris = $("#txtBaris");
        var txtBil = $("#txtBil");
        var txtNoStok = $("#txtNoStok");
        var txtPerihal = $("#txtPerihal");
        var txtKuantiti = $("#txtKuantiti");
        var txtUnit = $("#txtUnit");
        var txtHargaUnit = $("#txtHargaUnit");
        var txtAmaun = $("#txtAmaun");
        var txtJumlah = $("#jumlahPerihal");

        //Sum value to Total text field
        var sum = 0;
        sum = parseFloat(txtAmaun.val()) + parseFloat(txtJumlah.val());
        txtJumlah.val(sum);

        //Get the reference of the Table's TBODY element.
        var tBody = $("#tblPerihal > TBODY")[0];
        //Add Row.
        var row = tBody.insertRow(-1);

        //Add Indek cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtIndek);
        cell.prop("hidden", !this.checked);

        //Add Baris cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtBaris.val());
        cell.prop("hidden", !this.checked);

        //Add Bil cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtBil.val());

        //Add No Stok cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtNoStok.val());
        cell.addClass('text-uppercase');

        //Add Perihal cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtPerihal.val());
        cell.addClass('text-uppercase');

        //Add Kuantiti cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtKuantiti.val());

        //Add Unit cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtUnit.val());
        cell.addClass('text-uppercase');

        //Add Harga cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtHargaUnit.val());

        //Add Amaun cell.
        var cell = $(row.insertCell(-1));
        cell.html(txtAmaun.val());

        //Add Edit Button cell.
        cell = $(row.insertCell(-1));

        var btnUpdate2 = $("<button class='btn btn-primary btn-sm' type='button' id='btnUpdate2' onclick='Update2(this)'><i class='fas fa-edit'></i></button>");
        cell.append(btnUpdate2);

        //Add Button cell.
        cell = $(row.insertCell(-1));
        var btnRemove2 = $("<button class='btn btn-danger btn-sm' type='button' id='btnRemove1' onclick='Remove2(this)'><i class='fas fa-trash'></i></button>");
        cell.append(btnRemove2);

        var AkPO2 = {
            Indek: indek,
            Baris: txtBaris.val(),
            Bil: txtBil.val(),
            NoStok: txtNoStok.val(),
            Perihal: txtPerihal.val(),
            Kuantiti: txtKuantiti.val(),
            Unit: txtUnit.val(),
            Harga: txtHargaUnit.val(),
            Amaun: txtAmaun.val()
        }
        $.ajax({
            type: "POST",
            //url: "/AkPO/SaveAkPO2",
            url: '@Url.Action("SaveAkPO2", "AkPO")',
            data: AkPO2,
            dataType: "json",
            success: function (r) {
                //Clear the TextBoxes.
                txtBaris.val("0");
                txtBil.val("0");
                txtNoStok.val("-");
                txtPerihal.val("-");
                txtKuantiti.val("0");
                txtUnit.val("-");
                txtHargaUnit.val("0.00");
                txtAmaun.val("0.00");
                checkJumlah();
                bil++;
            }
        });
    }
//add tbl Perihal end

    //remove tbl Peserta
    function Remove1(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var name = $("TD", row).eq(0).html();
        var amaun = $("TD", row).eq(2).html();
        var txtJumlah = $("#txtJumlah");
        if (confirm("Hapus Peserta : " + name + " ?")) {
            //Get the reference of the Table.
            var table = $("#tblPeserta")[0];

            //Sum value to Total text field
            var sum = 0;
            sum = parseFloat(txtJumlah.val()) - parseFloat(amaun);
            txtJumlah.val();

            //var AkTerima1 = {
            //    AkCartaId: name,
            //}
            if (name != null) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("RemoveSpPendahuluanPelbagai1", "SpPendahuluanPelbagai")',
                    data: SpPendahuluanPelbagai1,
                    dataType: "json",
                    success: function (r) {
                        //Delete the Table row using it's Index.
                        table.deleteRow(row[0].rowIndex);
                        checkJumlah();
                    }
                });
            }
            $("#ddlJantina option[value=" + name + "]").prop('disabled', false);

        }
    };
    //remove tbl Peserta end

    //remove tbl Perihal
   function Remove2(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var name = $("TD", row).eq(0).html();
        var amaun = $("TD", row).eq(8).html();
        var txtJumlah = $("#jumlahPerihal");
        if (confirm("Hapus : " + name + " ?")) {
            //Get the reference of the Table.
            var table = $("#tblPerihal")[0];

            //Sum value to Total text field
            var sum = 0;
            sum = parseFloat(txtJumlah.val() - parseFloat(amaun));
            txtJumlah.val(sum);

            var AkPO2 = {
                Indek: name,
            }
            if (name != null) {
                $.ajax({
                    type: "POST",
                    //url: "/AkPO/RemoveAkPO2",
                    url: '@Url.Action("RemoveAkPO2", "AkPO")',
                    data: AkPO2,
                    dataType: "json",
                    success: function (r) {
                        //Delete the Table row using it's Index.
                        table.deleteRow(row[0].rowIndex);
                        checkJumlah();
                    }
                });
            }
        }
    };
    //remove tbl Perihal end

    //update tbl objek
    function Update1(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var akCartaId = $("TD", row).eq(0).html();

        //var AkTerima1 = {
        //    AkCartaId: akCartaId
        //}
        if (name != null) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetAnItemCartSpPendahuluanPelbagai1", "SpPendahuluanPelbagai")',
