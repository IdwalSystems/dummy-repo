    function modalUpdate1() {
        var id = $("#moId1").val();
        //var amaun = $("#moAmaun1").val();
        var jJantinaId = $("#moJJantina").val();
       // var jumlah = $("#jumlahObjek");

        var AkTerima1 = {
            Id: id,
            jJantinaId: jJantinaId,
            //Amaun: amaun
        }
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetAnItemCartSpPendahuluanPelbagai1", "SpPendahuluanPelbagai")',
            data: SpPendahuluanPelbagai1,
            dataType: "json",
            success: function (r) {
                //insert notification here

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetAllItemCartSpPendahuluanPelbagai1", "SpPendahuluanPelbagai")',
                    dataType: "json",
                    success: function (r) {

                        //refresh updated table objek
                        $("table tbody#tbodyObjek").empty();
                        var sum = 0;
                        if (r.record.length > 0) {
                            for (var i = 0; i < r.record.length; i++) {
                                var item1 = r.record[i];
                                var str = "<tr><td id='jJantinaId'>" + item1.jJantinaId +
                                    "</td><td>" + item1.SpPendahuluanPelbagaiId +
                                    "</td><td>" + item1.BilAtl +
                                    "</td><td>" + item1.BilJul +
                                    "</td><td>" + item1.BilPeg +
                                    "</td><td>" + item1.BilTek +
                                    "</td><td>" + item1.BilUru +
                                    "</td><td>" +
                                    "<button class='btn btn-primary btn-sm' type='button' id='btnUpdate1' data-toggle='modal' data-target='#modalObjek' onclick='Update1(this)'><i class='fa fa-edit' ></i></button>" +
                                    "</td><td>" +
                                    "<button class='btn btn-danger btn-sm' type='button' id='btnRemove1' onclick='Remove1(this)'><i class='fas fa-trash' ></i></button>" +
                                    "</td><tr>";
                                $("table tbody#tbodyObjek").append(str);
                                sum += item1.amaun;
                            }
                        }

                        jumlah.val(sum);
                        checkJumlah();
                    }
                });

            }
        });
    };
    //update tbl objek end

    //update tbl urusniaga
    function Update2(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var jCaraBayarId = $("TD", row).eq(0).html();
        var jenisBayar = $("TD", row).eq(1).html();

        var AkTerima2 = {
            JCaraBayarId: jCaraBayarId
        }
        $.ajax({
            type: "POST",
            url: "/AkTerima/GetAnItemCartAkTerima2",
            data: AkTerima2,
            dataType: "json",
            success: function (r) {
                //insert data in modal urusniaga
                $("#moId2").val(jCaraBayarId);
                $("#moCaraBayar").val(r.record.jCaraBayarId);
                $("#moAmaun2").val(r.record.amaun);
                $("#moNoCek").val(r.record.noCek);
                $("#moJenisCek").val(r.record.jenisCek);
                $("#moKodBankCek").val(r.record.kodBankCek);
                $("#moTempatCek").val(r.record.tempatCek);
                $("#moNoSlip").val(r.record.noSlip);
                $("#moTarSlip").val(r.record.tarSlip);

                // check if jenis bayar equal to cek, enable all related cek fields, otherwise disabled it
                if (jenisBayar == "CEK") {
                    // enable fields
                    $("#moNoCek").prop('disabled', false);
                    $("#moJenisCek").prop('disabled', false);
                    $("#moKodBankCek").prop('disabled', false);
                    $("#moTempatCek").prop('disabled', false);
                }
                else {
                    // disable fields
                    $("#moNoCek").prop('disabled', true);
                    $("#moJenisCek").prop('disabled', true);
                    $("#moKodBankCek").prop('disabled', true);
                    $("#moTempatCek").prop('disabled', true);
                }
                // end check

                //show modal Urusniaga
                $("#modalUrusniaga").modal({ backdrop: 'static', keyboard: false });

            }
        });
    };

