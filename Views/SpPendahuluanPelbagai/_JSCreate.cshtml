    function countTotalAmountPerItem(atlet, jurulatih, pegawai, teknikal, urusetia) {
        if (atlet != null && jurulatih != null && pegawai != null && teknikal != null && urusetia != null) {
            return total = atlet + jurulatih + pegawai + teknikal + urusetia;
        }
    }
