    // onchange harga/unit and kuantiti
    $("body").on('change', ".atlet, .jurulatih, .pegawai, .teknikal, .urusetia", function () {
        //main body
        var atlet = $("#txAtlet").val();
        var jurulatih = $("#txtJurulatih").val();
        var pegawai = $("#txtPegawai").val();
        var teknikal = $("#txtTeknikal").val();
        var urusetia = $("#txtUrusetia").val();

        $("#txtJumlahPeserta").val((countTotalAmountPerItem(atlet, jurulatih, pegawai, teknikal, urusetia)));
