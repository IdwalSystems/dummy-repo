@model MSNK.Models.Modules.SpPendahuluanPelbagai

@{
    ViewData["Title"] = "Lulus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row">
    <div class="col-md-12">
        <div class="card box-shadow border-dark mb-3">
            <div class="card-header bg-dark text-white">
                <div class="form-row">
                    <div class="col-md-6">
                        <h5 class="text-left">Permohonan Aktiviti - @ViewData["Title"]</h5>
                    </div>
                </div>
                </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="col-lg-10">
                        <div class="form-row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="control-label">No Rujukan</label>
                                    <input class="form-control form-control-sm" value="@Model.Id" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Tarikh" class="control-label"></label>
                                    <input class="form-control form-control-sm" value="@Html.DisplayFor(model => model.Tarikh)" readonly />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="control-label">Negeri</label>
                                    <input class="form-control form-control-sm text-uppercase" value="@Model.JNegeri.Id - @Model.JNegeri.Perihal" readonly />
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="control-label">Sukan</label>
                                    <input class="form-control form-control-sm text-uppercase" value="@Model.JSukan.Id - @Model.JSukan.Perihal" readonly />
                                </div>
                            </div>
</div>
                            <div class="form-row">

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Aktiviti</label>
                                        <input class="form-control form-control-sm text-uppercase" value="@Model.Aktiviti" readonly />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Tempat</label>
                                        <input class="form-control form-control-sm text-uppercase" value="@Model.Tempat" readonly />
                                    </div>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="card mb-2">

                                    <div class="form-row">
                                        <div class="card-body p-1">
                                            <div class="form-group col-sm">
                                                <label>Penyertaan</label>
                                                <div class="custom-control custom-radio">
                                                    <input type="checkbox" checked="checked">
                                                </div>

                                            </div>
                                        </div>
                                        <div class="card-body p-1">
                                            <div class="form-group col-sm">
                                                <label>Pengelolaan</label>
                                                <div class="custom-control custom-radio">
                                                    <input type="checkbox" checked="checked">
                                                </div>

                                            </div>
                                        </div>
                                        <div class="card-body p-1">
                                            <div class="form-group col-sm">
                                                <label>Pertandingan</label>
                                                <div class="custom-control custom-radio">
                                                    <input type="checkbox" checked="checked">
                                                </div>

                                            </div>
                                        </div>
                                        <div class="card-body p-1">
                                            <div class="form-group col-sm">
                                                <label>Program Binaan</label>
                                                <div class="custom-control custom-radio">
                                                    <input type="checkbox" checked="checked">
                                                </div>

                                            </div>
                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="control-label">Tahap</label>
                                        <input class="form-control form-control-sm text-uppercase" value="@Model.JTahapAktiviti.Id - @Model.JTahapAktiviti.Perihal" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2">
                            <div class="card mb-2">
                                <div class="card-body p-1">
                                    <div class="form-group col-sm">
                                        <label asp-for="FlCetak" class="control-label">Cetak</label>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlCetak" type="radio" id="FlCetak1" name="FlCetak" class="custom-control-input" value="0" checked>
                                            <label class="custom-control-label" for="FlCetak1">Belum</label>
                                        </div>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlCetak" type="radio" id="FlCetak2" name="FlCetak" class="custom-control-input" value="1">
                                            <label class="custom-control-label" for="FlCetak">Sudah</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card mb-2">
                                <div class="card-body p-1">
                                    <div class="form-group col-sm">
                                        <label asp-for="FlPosting" class="control-label">Posting</label>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlPosting" type="radio" id="FlPosting1" name="FlPosting" class="custom-control-input" value="0" checked>
                                            <label class="custom-control-label" for="FlPosting">Belum</label>
                                        </div>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlPosting" type="radio" id="FlPosting2" name="FlPosting" class="custom-control-input" value="1">
                                            <label class="custom-control-label" for="FlPosting">Sudah</label>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="card mb-2">
                                <div class="card-body p-1">
                                    <div class="form-group col-sm">
                                        <label asp-for="FlPosting" class="control-label">Batal</label>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlPosting" type="radio" id="FlHapus1" name="FlHapus1" class="custom-control-input" value="0" checked>
                                            <label class="custom-control-label" for="FlHapus">Tidak</label>
                                        </div>
                                        <div class="custom-control custom-radio">
                                            <input asp-for="FlPosting" type="radio" id="FlHapus1" name="FlHapus" class="custom-control-input" value="1">
                                            <label class="custom-control-label" for="FlHapus">Ya</label>
                                        </div>
                                    </div>
                                </div>
                            </div>


                        </div>

                    </div>
             
            
          </div>
        </div></div>

