@model IEnumerable<MSNK.Models.Administration.ExceptionLogger>

@{
    ViewData["Title"] = "Exception Log";
}
<script type="text/javascript">
    var columnSearchVar;
    $(document).ready(function () {

        var table = $('.table').DataTable({
            "paging": false,
            rowReorder: true,
            columnDefs: [
                { orderable: false, targets: '_all' }
            ],
            "scrollY": "50vh",
            "scrollX": true,
            "scrollCollapse": true,
            "paging": false,
            dom: 'lrt'
        });

        $('#columnSearch').change(function () {
            columnSearchVar = $(this).val();
            // refresh table
            $('#myInput').val('');
            table.destroy();

            table = $('.table').DataTable({
                "paging": false,
                rowReorder: true,
                columnDefs: [
                    { orderable: false, targets: '_all' }
                ],
                "scrollY": "50vh",
                "scrollX": true,
                "scrollCollapse": true,
                "paging": false,
                dom: 'lrt'
            });
            // refresh table end
        });

        table.on('order.dt search.dt', function () {
            table.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1;
            });
        }).draw();

        $('#myInput').on('keyup', function () {
            if (!columnSearchVar) {
                table
                    .search(this.value)
                    .draw();
            }
            else {
                table
                    .columns(columnSearchVar)
                    .search(this.value)
                    .draw();
            }
        });
    });
</script>

<div class="card box-shadow">
    <div class="card-body border">
        <div class="row">
            <div class="col-8">
                <h5 class="text-uppercase mb-0">@ViewData["Title"]</h5>
                <span class="ac-ref">Indeks</span>
            </div>

        </div>
        <hr class="mt-2" />
        <partial name="_SearchJadualIndexPartial" />
        @if (Model.Any())
        {
            <div class="table-responsive table-sm">
                <table class="table table-bordered table-hover display compact nowrap" width="100%">
                    <thead>
                        <tr class="table-secondary">
                            <th width="3%">Id</th>
                            <th width="10%">Trace Id</th>
                            <th width="5%">Log Time</th>
                            <th width="10%">Url Request</th>
                            <th width="10%">Controller Name</th>
                            <th width="10%">Username</th>
                            <th width="10%">Exception Message</th>
                            <th width="3%">Source</th>
                            @*<th></th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td></td>
                                <td>
                                    @item.TraceIdentifier
                                </td>
                                <td>
                                    @item.LogTime.ToString("dd/MM/yyyy hh:mm:ss tt")
                                </td>
                                <td>
                                    @item.UrlRequest
                                </td>
                                <td>
                                    @item.ControllerName
                                </td>
                                <td>
                                    @item.UserName
                                </td>
                                <td>
                                    @item.ExceptionMessage
                                </td>
                                <td>
                                    @item.Source
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }
    </div>
</div>