@model MSNK.Models.Modules.PrintModel.Reporting.LPR0012PrintModel

@{
    ViewData["Title"] = "Cetakan LPR0012";
    Layout = "~/Views/Shared/_PrintLayout.cshtml";
}
<style>
    .flexrow {
        display: -webkit-box;
        display: -webkit-flex;
        display: flex !important;
    }

        .flexrow > div {
            -webkit-box-flex: 1;
            -webkit-flex: 1;
            flex: 1;
        }

    .image-container {
        width: 80px;
        height: 80px;
        text-align: center;
    }

        .image-container img {
            height: 100%;
        }

    h1 {
        font-size: 1.5rem;
    }

    h2 {
        font-size: 1.3rem;
    }

    h3 {
        font-size: 1.2rem;
    }

    h4 {
        font-size: 1.1rem;
    }

    h5 {
        font-size: 1rem;
    }

    h6 {
        font-size: 0.8rem;
    }

    p {
        font-size: 0.6rem;
    }

    .topic tr {
        line-height: 0.5rem;
    }

    .center {
        padding: 70px 0;
        border: 3px solid green;
        text-align: center;
    }

    .notbold {
        font-weight: normal
    }

    table tbody tr td {
        font-size: 0.8rem;
        line-height: 1.0rem;
    }

    table thead tr th {
        font-size: 0.8rem;
        line-height: 1.0rem;
    }

    .breakhere {
        page-break-after: always
    }
</style>
<div class="row flexrow mb-3 ml-0">
    <div class="col-2 image-container">
        <img src="~/img/MainLogo_Syarikat.png" alt="Logo syarikat" />
    </div>
    <div class="col-8 text-uppercase">
        <h5 class="mb-1"><strong>@Model.CompanyDetail.NamaSyarikat</strong></h5>
        <h6 class="mb-0 text-white"> -</h6>
        <h6 class="mb-0 text-white"> -</h6>
        <h6 class="mb-0">Laporan Daftar Resit Terperinci Kump Wang : @Model.JKW.Kod - @Model.JKW.Perihal </h6>
        <h6 class="mb-0">Bagi Tarikh : @Model.TarikhDari -> @Model.TarikhHingga</h6>
    </div>

    <div class="col-2 text-right">
        <h6 class="mb-0">Tarikh: @Convert.ToDateTime(DateTime.Today).ToString("dd/MM/yyyy")</h6>
        <h6 class="mb-0">Laporan: @Model.KodLaporan</h6>
    </div>
</div>

<div class="table-responsive-sm mb-0">
    <table class="table table-bordered table-sm topic">
        <thead>
            <tr>
                <th class="text-center font-weight-bold">Tarikh  </th>
                <th class="text-center font-weight-bold">No Resit</th>
                <th class="text-center font-weight-bold">Pembayar </th>
                <th class="text-center font-weight-bold">Cara Bayar</th>
                <th class="text-center font-weight-bold">No Cek</th>
                <th class="text-center font-weight-bold">No Slip</th>
                <th class="text-center font-weight-bold">Tar Slip</th>
                <th class="text-center font-weight-bold">Debit RM</th>
                <th class="text-center font-weight-bold">Kredit RM</th>
                <th class="text-center font-weight-bold">Jumlah RM</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.AkTerima)
            {
                @foreach (var item2 in item.AkTerima2)
                {
            <tr>
                <td class="text-center">@Convert.ToDateTime(item.Tarikh).ToString("dd/MM/yyyy")</td>
                <td class="text-center">@item.NoRujukan</td>
                <td class="text-left text-uppercase">@item.Nama</td>
                <td class="text-center text-uppercase">@item2.JCaraBayar.Perihal</td>
                <td class="text-center text-uppercase">@item2.NoCek</td>
                <td class="text-center text-uppercase">@item2.NoSlip</td>
                <td class="text-center text-uppercase">@Convert.ToDateTime(item2.TarSlip).ToString("dd/MM/yyyy")</td>
                <td class="text-right text-uppercase">@Convert.ToDecimal(item.Jumlah).ToString("#,##0.00")</td>
                <td class="text-right text-uppercase">@Convert.ToDecimal(item2.Amaun).ToString("#,##0.00")</td>
                <td class="text-right text-uppercase">@Convert.ToDecimal(item.Jumlah).ToString("#,##0.00")</td>
            </tr>
                }

            }
        </tbody>
    </table>
</div>