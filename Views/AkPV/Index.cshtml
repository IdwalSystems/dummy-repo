@model IEnumerable<MSNK.Models.Modules.ViewModel.AkPVViewModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_JSIndex" />

@*div Header*@
<div class="row mb-2">
    <div class="col-8">
        <h3 class="text-left">Baucer Pembayaran</h3>
    </div>
    <div class="col-4 text-right">
        <button type="button" class="btn btn-success" data-toggle="modal" data-target="#modalTambah">
            Tambah Baru
        </button>
    </div>
</div>
@*div Header end*@

@*div carian*@
<div class="card mb-2">
    <div class="card-body pl-3 pb-2 ">
        <label class="form-control-plaintext" for="searchselect">Carian : </label>

        <div class="form-actions no-color mb-2">
            <form asp-action="Index" method="get">
                <div class="form-row">
                    <div class="col-sm-3 mb-2">
                        <select class="custom-select form-control-sm"
                                name="searchColumn"
                                asp-items="@ViewBag.SearchColumn" id="searchColumn"></select>
                    </div>
                    <div class="col-sm-9 mb-2">
                        <div class="form-row">
                            <div class="col-10">
                                <div class="form-row">
                                    <div class="col-12">
                                        <input class="form-control form-control-sm" type="text" name="searchString" id="myInput" value="@ViewBag.SearchData1" />
                                    </div>
                                    <div class="col-6" id="myInputDate1">
                                        <input class="form-control form-control-sm mb-2" type="date" name="searchDate1" id="inputTarikh1" value="@ViewBag.SearchData1" />
                                    </div>
                                    <div class="col-6" id="myInputDate2">
                                        <input class="form-control form-control-sm" type="date" name="searchDate2" id="inputTarikh2" value="@ViewBag.SearchData2" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-2">
                                <button type="submit" class="btn text-info btn-sm" data-toggle="tooltip" data-placement="top" title="Cari"><i class="fas fa-search"></i></button>
                            </div>
                        </div>

                    </div>

                </div>
            </form>
        </div>
    </div>
</div>
@*div carian end*@

@*div table*@

<div class="table-responsive table-sm">
    <table class="table table-bordered table-hover display compact nowrap" width="100%">
        <thead>
            <tr>
                <th width="2%">Bil</th>
                <th width="2%">
                    Tahun
                </th>
                <th width="2%">
                    Kategori
                </th>
                <th>
                    No Rujukan
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Tarikh)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Jumlah)
                </th>
                <th>
                    Nama / Nama Syarikat
                </th>
                <th>
                    Cara Bayaran
                </th>
                <th>
                    Cetak
                </th>
                <th>
                    Posting
                </th>
                <th>
                    Batal
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var tabletype = item.FlHapus == 1 ? "table-danger" : null;
            <tr class="@tabletype">
                <td>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Tahun)
                </td>
                @switch (item.FlKategoriPenerima)
                {
                    case 1:
                        <td>PEMBEKAL</td>
                        break;
                    case 2:
                        <td>PEKERJA</td>
                        break;
                    case 3:
                        <td>PEMEGANG PANJAR</td>
                        break;
                    default:
                        <td>AM</td>
                        break;
                }
                <td>
                    @item.NoPV.Substring(3)
                </td>
                <td>
                    @item.Tarikh.ToString("dd/MM/yyyy")
                </td>
                <td class="text-right">
                    @Convert.ToDecimal(item.Jumlah).ToString("#,##0.00")
                </td>
                <td class="text-uppercase">
                    @item.Penerima
                </td>
                <td class="text-uppercase">
                    @item.CaraBayar
                </td>
                <td>
                    @if (item.FlCetak == 0)
                    {
                        <label class="mb-0">BELUM</label>
                    }
                    else
                    {
                        <label class="mb-0">SUDAH</label>
                    }
                </td>
                <td>
                    @if (item.FlPosting == 0)
                    {
                        <label class="mb-0">BELUM</label>
                    }
                    else
                    {
                        <label class="mb-0">SUDAH</label>
                    }
                </td>
                <td>
                    @if (item.FlHapus == 0)
                    {
                        <label class="mb-0">TIDAK</label>
                    }
                    else
                    {
                        <label class="mb-0">YA</label>
                    }
                </td>
                <td class="action-button">
                    <div class="btn-group" role="group" aria-label="action">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn text-primary btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Ubah/Papar"><i class="fas fa-edit"></i></a>
                        <a asp-action="PrintPdf" asp-route-id="@item.Id" class="btn text-secondary btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Cetak" target="_blank"><i class="fas fa-print"></i></a>
                        @if (item.FlHapus == 0)
                        {
                            if (item.FlPosting == 0)
                            {
                                if (item.Jumlah != 0)
                                {
                                    if (item.FlKategoriPenerima == 1)
                                    {
                                        if (item.Jumlah == item.JumlahInbois && item.FlCetak != 0)
                                        {
                                            <a asp-action="Posting" asp-route-id="@item.Id" class="btn text-success btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Kemaskini Lejar">
                                                <i class="fas fa-file-signature"></i>
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        if (item.FlCetak != 0)
                                        {
                                            <a asp-action="Posting" asp-route-id="@item.Id" class="btn text-success btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Lulus">
                                                <i class="fas fa-file-signature"></i>
                                            </a>
                                        }

                                    }

                                }

                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn text-danger btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Hapus"><i class="fas fa-trash"></i></a>

                            }
                            else
                            {
                                <a asp-action="UnPosting" asp-route-id="@item.Id" class="btn text-warning btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Batal Lulus">
                                    <i class="fas fa-file"></i>
                                </a>
                            }
                        }
                        else
                        {
                            if (User.IsInRole("Supervisor") || User.IsInRole("SuperAdmin"))
                            {
                                <a asp-action="Rollback" asp-route-id="@item.Id" class="btn text-info btn-sm bg-white" type="button" data-toggle="tooltip" data-placement="top" title="Rollback">
                                    <i class="fas fa-trash-restore"></i>
                                </a>

                            }
                        }
                    </div>

                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
@*div table end*@
<!-- Modal Tambah -->
<div class="modal fade" id="modalTambah" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-md modal-dialog modal-dialog-centered ">
        <div class="modal-content border-0">
            <div class="modal-header bg-info text-white ">

                <h5 class="modal-title"><i class="fas fa-info-circle"></i> Kategori Penerima</h5>

                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times text-white"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group col-sm">

                    <div class="custom-control custom-radio">

                        <input class="custom-control-input" type="radio" name="jenis" id="CreateAm" value="CreateAm" checked>
                        <label class="custom-control-label" for="CreateAm">
                            Am / Pembekal
                        </label>
                    </div>
                    <div class="custom-control custom-radio">

                        <input class="custom-control-input" type="radio" name="jenis" id="CreatePekerja" value="CreatePekerja">
                        <label class="custom-control-label" for="CreatePekerja">
                            Pekerja
                        </label>
                    </div>
                    <div class="custom-control custom-radio">

                        <input class="custom-control-input" type="radio" name="jenis" id="CreatePanjar" value="CreatePanjar">
                        <label class="custom-control-label" for="CreatePanjar">
                            Pemegang Tunai Panjar
                        </label>
                    </div>
                </div>

                    <div class="form-row">
                        <div class="col-6 mb-2">
                            <a asp-action="CreateByJenis" asp-route-jenis="CreateAm" id="btnTambah" class="btn btn-success btn-block btn-lg ">TAMBAH</a>
                        </div>
                        <div class="col-6">
                            <a data-dismiss="modal" aria-label="Close" class=" btn btn-secondary btn-block btn-lg text-white">BATAL</a>
                        </div>
                    </div>
            </div>
            <div class="modal-footer bg-success" style="padding:0px;">


            </div>
        </div>
    </div>
</div>
<!-- Modal Tambah End -->