                    } else {
                        $("#txtNoPO").val(msg.record.akPO.noPO);
                        $("#txtTarPO").val(msg.record.akPO.tarikh);
                        $("#txtAmaunPO").val(msg.record.akPO.jumlah.toFixed(2));
                    }



                },
                error: function (req, status, error) {
                    alert(error);
                }
            });
        }

    }

