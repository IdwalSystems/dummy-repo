                    var btnUpdate2 = $("<button class='btn btn-primary btn-sm' type='button' id='btnUpdate2' onclick='Update2(this)'><i class='fas fa-edit'></i></button>");
                    cell.append(btnUpdate2);

                    //Add Button cell.
                    cell = $(row.insertCell(-1));
                    var btnRemove2 = $("<button class='btn btn-danger btn-sm' type='button' id='btnRemove1' onclick='Remove2(this)'><i class='fas fa-trash'></i></button>");
                    cell.append(btnRemove2);

                    var AkPV2 = {
                        AkBelianId: ddlAkBelian.val(),
                        Amaun: txtAmaunInbois.val()
                    }
                    $.ajax({
                        type: "POST",
                        url: "/AkPV/SaveAkPV2",
                        data: AkPV2,
                        dataType: "json",
                        success: function (r) {
                            //Clear the TextBoxes.
                            ddlAkBelian.val("").trigger('change');
                            txtTarInbois.val("");
                            txtAmaunInbois.val("0.00");
                            txtNoPO.val("");
                            txtTarPO.val("");
                            txtAmaunPO.val("0.00");
                            
                        }
                    });
                    $("#ddlAkBelian option[value=" + ddlAkBelian.val() + "]").prop('disabled', true);
                

                }
            });
        }

    }
    //add tbl Inbois end

    //remove tbl Inbois
    function Remove2(button) {
