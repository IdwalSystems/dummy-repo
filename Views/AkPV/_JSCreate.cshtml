            $("#Nama").prop('required', true);
            $("#txtAlamat1").prop('disabled', false);
            $("#txtAlamat2").prop('disabled', false);
            $("#txtAlamat3").prop('disabled', false);
            $("#txtNoAkaunBank").prop('disabled', false);
            $("#txtTelefon").prop('disabled', false);
            $("#txtEmel").prop('disabled', false);
            $("#ddlKodPekerja").prop('disabled', false);

            //empty field
            $("#txtNoKP").val('');
            $("#Nama").val('');
            $("#txtAlamat1").val('');
            $("#txtAlamat2").val('');
            $("#txtAlamat3").val('');
            $("#txtNoAkaunBank").val('');
            $("#txtTelefon").val('');
            $("#txtEmel").val('');

            $("#btnSave").show();
            card.prop('hidden', true);
            EmptyCart();
        }

