    //onchange Cara Bayaran end

    // onchange kod Pekerja
    $("body").on('change', "#ddlKodPekerja", function () {
        var kodPekerja = $("#ddlKodPekerja").val();
        if (kodPekerja != 0) {
            JsonKodPekerja(kodPekerja);
            $("#Nama").prop('required', false);
        } else {
            //enable field
            $("#txtNoKP").prop('disabled', false);
            $("#Nama").prop('disabled', false);
            $("#txtAlamat1").prop('disabled', false);
            $("#txtAlamat2").prop('disabled', false);
            $("#txtAlamat3").prop('disabled', false);
            $("#txtNoAkaunBank").prop('disabled', false);
            $("#txtTelefon").prop('disabled', false);
            $("#txtEmel").prop('disabled', false);
            $("#ddlKodPembekal").prop('disabled', false);

            //empty field
            $("#txtNoKP").val('');
            $("#Nama").val('');
            $("#txtAlamat1").val('');
            $("#txtAlamat2").val('');
            $("#txtAlamat3").val('');
            $("#txtNoAkaunBank").val('');
            $("#txtTelefon").val('');
            $("#txtEmel").val('');

            $("#btnSave").show();
            EmptyCart();
