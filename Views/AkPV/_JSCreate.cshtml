<script type="text/javascript">
    // onchange no Rujukan
    $("body").on('change', "#ddlKW , #txtTahun", function () {
        var kodkw = $("#ddlKW").val();
        var year = $("#txtTahun").val();
        if (kodkw != 0) {
            JsonKod(kodkw, year);
        }

    });

    function JsonKod(id, year) {
        $.ajax({
            type: "POST",
            //url: "/AkPV/JsonGetKod",
            url: '@Url.Action("JsonGetKod", "AkPV")',
            data: { data: id, year: year },
            dataType: "json",
            success: function (msg) {
                $("#txtNoRujukan").val(msg.record);
            },
            error: function (req, status, error) {
                alert(error);
            }
        });
    }
    // onchange no Rujukan end

     // onchange no Rujukan
    $("body").on('change', "#ddlTunaiRuncit", function () {
        var kodKaunter = $("#ddlTunaiRuncit").val();
        if (kodKaunter != 0) {
            $("#txtPerihal").val("WANG PANJAR");
            $("#txtNoRekup").prop('disabled', false);
        }
        else {
            $("#txtPerihal").val("");
            $("#txtNoRekup").prop('disabled', true);
        }

    });

    // onchange no Rujukan end

    //empty cart
    function EmptyCart() {
        $.ajax({
            type: "POST",
            //url: "/AkPV/JsonEmptyCart",
            url: '@Url.Action("JsonEmptyCart", "AkPV")',
            dataType: "json",
            success: function (msg) {
                $("table tbody#tbodyObjek").empty();
                $("table tbody#tbodyInbois").empty();
                $("#jumlahObjek").val("0.00");
                $("#jumlahInbois").val("0.00");
                $("#txtKodAkaun option").prop('disabled', false);
                $("#txtKodAkaun option:selected").prop('disabled', true);
            },
            error: function (req, status, error) {
                alert(error);
            }
        });
    };
    //empty cart end

    // check if jumlahObjek is equal to jumlahInbois
    function checkJumlah() {
        var jumlahObjek = $("#jumlahObjek").val();
        var jumlahInbois = $("#jumlahInbois").val();

        if (jumlahObjek == 0.00 && jumlahInbois == 0.00) {
            $("#btnSave").show();
        } else {
            if (jumlahObjek == jumlahInbois) {
                $("#btnSave").show();
            }
            else {
                $("#btnSave").hide();
            }
        }
    }
    // check end

    // onchange kod pembekal
    $("body").on('change', "#ddlKodPembekal", function () {
        var kodPembekal = $("#ddlKodPembekal").val();
        var card = $("#cardInbois");
        if (kodPembekal != 0) {
            card.removeAttr('hidden');
            JsonKodPembekal(kodPembekal);
            $("#Nama").prop('required', false);
        } else {
            //enable field
            $("#txtNoKP").prop('disabled', false);
            $("#Nama").prop('disabled', false);
            $("#txtAlamat1").prop('disabled', false);
            $("#txtAlamat2").prop('disabled', false);
            $("#txtAlamat3").prop('disabled', false);
            $("#txtNoAkaunBank").prop('disabled', false);
            $("#txtTelefon").prop('disabled', false);
            $("#txtEmel").prop('disabled', false);
            $("#ddlKodPekerja").prop('disabled', false);

            //empty field
            $("#txtNoKP").val('');
            $("#Nama").val('');
            $("#txtAlamat1").val('');
            $("#txtAlamat2").val('');
            $("#txtAlamat3").val('');
            $("#txtNoAkaunBank").val('');
            $("#txtTelefon").val('');
            $("#txtEmel").val('');

            $("#btnSave").show();
            card.prop('hidden', true);
            EmptyCart();
        }

    });

    function JsonKodPembekal(id) {
        if (id != null) {
            $.ajax({
                type: "POST",
                //url: "/AkPV/JsonGetPembekal",
                url: '@Url.Action("JsonGetPembekal", "AkPV")',
                data: { data: id },
                dataType: "json",
                success: function (msg) {
                    $("#Nama").val(msg.record.namaSykt);
                    $("#txtAlamat1").val(msg.record.alamat1);
                    $("#txtAlamat2").val(msg.record.alamat2);
                    $("#txtAlamat3").val(msg.record.alamat3);
                    $("#txtNoAkaunBank").val(msg.record.noAkaunBank);
                    $("#txtTelefon").val(msg.record.telefon);
                    $("#txtEmel").val(msg.record.emel);
                    // disable fields
                    $("#txtNoKP").prop('disabled', true);
                    $("#Nama").prop('disabled', true);
                    $("#txtAlamat1").prop('disabled', true);
                    $("#txtAlamat2").prop('disabled', true);
                    $("#txtAlamat3").prop('disabled', true);
                    $("#txtNoAkaunBank").prop('disabled', true);
                    $("#txtTelefon").prop('disabled', true);
                    $("#txtEmel").prop('disabled', true);
                    $("#ddlKodPekerja").prop('disabled', true);
                    $("#ddlKodPekerja").val(0);
                },
                error: function (req, status, error) {
                    alert(error);
                }
            });
        }
    }
    //on change Kod Pembekal end

    // onchange Cara Bayaran
