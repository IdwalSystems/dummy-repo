                                    "<button class='btn btn-primary btn-sm' type='button' id='btnUpdate2' data-toggle='modal' data-target='#modalInbois' onclick='Update2(this)'><i class='fa fa-edit' ></i></button>" +
                                    "</td><td>" +
                                    "<button class='btn btn-danger btn-sm' type='button' id='btnRemove2' onclick='Remove2(this)'><i class='fas fa-trash' ></i></button>" +
                                    "</td><tr>";
                                $("table tbody#tbodyInbois").append(str);
                                sum += item1.amaun;
                            }
                        }
                        jumlah.val(sum.toFixed(2));
                    }
                });
            }
        });
    };
    //update tbl Inbois end
</script>
