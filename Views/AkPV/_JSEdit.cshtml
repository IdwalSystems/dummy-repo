    //remove tbl objek end

    //update tbl objek
    function Update1(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var akPVId = $('#Id').val();
        var akCartaId = $("TD", row).eq(0).html();


        var AkPV1 = {
            AkPVId: akPVId,
            AkCartaId: akCartaId
        }
        if (name != null) {
            $.ajax({
                type: "POST",
                url: "/AkPV/UpdateAkPV1",
                data: AkPV1,
                dataType: "json",
                success: function (r) {
                    //insert data in modal objek
                    $("#moId1").val(r.record.id);
                    $("#moKodAkaun").val(r.record.akCartaId);
                    $("#moAmaun1").val(r.record.amaun);

                    //show modal objek
                    $("#modalObjek").modal({ backdrop: 'static', keyboard: false });

                }
            });
        }
    };

    function modalUpdate1() {
        var id = $("#moId1").val();
        var amaun = $("#moAmaun1").val();
        var akPVId = $("#Id").val();
        var jumlah = $("#jumlahObjek");

        var AkPV1 = {
            Id: id,
            AkPVId: akPVId,
            Amaun: amaun
        }
        $.ajax({
            type: "POST",
            url: "/AkPV/SaveUpdateAkPV1",
            data: AkPV1,
            dataType: "json",
            success: function (r) {
                //insert notification here

                $.ajax({
                    type: "POST",
                    url: "/AkPV/GetAkPV1",
                    data: AkPV1,
                    dataType: "json",
                    success: function (r) {

                        //refresh updated table objek
                        $("table tbody#tbodyObjek").empty();
                        var sum = 0;
                        if (r.data.akPV1.length > 0) {
                            for (var i = 0; i < r.data.akPV1.length; i++) {
                                var item1 = r.data.akPV1[i];
                                var str = "<tr><td id='akCartaId' hidden>" + item1.akCartaId +
                                    "</td><td>" + item1.akCarta.kod + " - " + item1.akCarta.perihal +
                                    "</td><td class='text-right'>" + (item1.amaun).toFixed(2) +
                                    "</td><td>" +
                                    "<button class='btn btn-primary btn-sm' type='button' id='btnUpdate1' data-toggle='modal' data-target='#modalObjek' onclick='Update1(this)'><i class='fa fa-edit' ></i></button>" +
                                    "</td><td>" +
                                    "<button class='btn btn-danger btn-sm' type='button' id='btnRemove1' onclick='Remove1(this)'><i class='fas fa-trash' ></i></button>" +
                                    "</td><tr>";
                                $("table tbody#tbodyObjek").append(str);
                                sum += item1.amaun;
                            }
                        }

                        jumlah.val(sum.toFixed(2));
                    }
                });
            }
        });
    };
    //update tbl objek end

    //add tbl inbois
    $("body").on("click", "#btnAdd2", function () {
        //Reference the Name and Country TextBoxes.
        var txtAkBelian = $("#txtAkBelian");
        GetAkBelian(txtAkBelian.val());
    });

    function GetAkBelian(id) {
