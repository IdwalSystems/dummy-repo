                    }
                    $.ajax({
                        type: "POST",
                        url: "/AkPV/InsertUpdateAkPV2",
                        data: AkPV2,
                        dataType: "json",
                        success: function (r) {
                            //Clear the TextBoxes.
                            ddlAkBelian.val("").trigger('change');
                            txtTarInbois.val("");
                            txtAmaun.val("0.00");
                            txtNoPO.val("");
                            txtTarPO.val("");
                            txtAmaunPO.val("0.00");
                        }
                    });
                    $("#txtAkBelian option[value=" + ddlAkBelian.val() + "]").prop('disabled', true);
                }
