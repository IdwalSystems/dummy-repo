<script type="text/javascript">
    var columnSearchVar;
    $(document).ready(function () {

        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            tableSub.columns.adjust();
        });

        var tableSub = $('.tableSub').DataTable({
            "paging": false,
            rowReorder: false,
            columnDefs: [
                { orderable: false, targets: '_all' }
            ],
            "scrollY": "40vh",
            "scrollX": true,
            "scrollCollapse": true,
            "paging": false,
            dom: 'lrtip',
            "language": {
                "info": "_TOTAL_ entri yang dipamerkan",
                "infoEmpty": "Tiada data untuk dipamerkan",
                "infoFiltered": " - ditapis daripada _MAX_ jumlah keseluruhan rekod"
            }
        });

        tableSub.columns.adjust();

        $('#columnSearch').change(function () {
            columnSearchVar = $(this).val();
            // refresh table
            tableSub.destroy();

            tableSub = $('.tableSub').DataTable({
                "paging": false,
                rowReorder: false,
                columnDefs: [
                    { orderable: false, targets: '_all' }
                ],
                "scrollY": "40vh",
                "scrollX": true,
                "scrollCollapse": true,
                "paging": false,
                dom: 'lrtip',
                "language": {
                    "info": "_TOTAL_ entri yang dipamerkan",
                    "infoEmpty": "Tiada data untuk dipamerkan",
                    "infoFiltered": " - ditapis daripada _MAX_ jumlah keseluruhan rekod"
                }
            });

            // refresh table end
        });

    });
</script>

@if (Model.Sublejar.Count > 0)
{
    <div class="card box-shadow">

        <div class="card-body">
            <div class="table-responsive table-sm">
                <table class="table tableSub table-bordered table-hover display compact nowrap" width="100%">
                    <thead>
                        <tr>
                            <th hidden>Id</th>
                            <th width="5%">Tarikh</th>
                            <th width="40%">Rujukan</th>
                            <th width="5%">
                                Bayaran RM
                            </th>
                            <th width="5%">
                                Hutang RM
                            </th>
                            <th width="5%">
                                Baki RM
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Sublejar)
                        {

                            <tr class="text-uppercase ">
                                <td hidden>@item.Id</td>
                                <td width="5%" data-sort='YYYYMMDD'>
                                    @item.Tarikh.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @item.Rujukan
                                </td>
                                <td class="text-right">
                                    @Convert.ToDecimal(item.Bayaran).ToString("#,##0.00")
                                </td>
                                <td class="text-right">
                                    @Convert.ToDecimal(item.Hutang).ToString("#,##0.00")
                                </td>
                                <td class="text-right">
                                    @Convert.ToDecimal(item.Baki).ToString("#,##0.00")
                                </td>
                            </tr>
                        }

                    </tbody>
                    <tfoot>
                        <tr class="text-uppercase font-weight-bold">
                            <td colspan="2" class="text-right">JUMLAH RM</td>
                            <td class="text-right">
                                @Convert.ToDecimal(Model.JumBayaran).ToString("#,##0.00")
                            </td>
                            <td class="text-right">
                                @Convert.ToDecimal(Model.JumHutang).ToString("#,##0.00")
                            </td>
                            <td class="text-right">
                                @Convert.ToDecimal(Model.JumBayaran - Model.JumHutang).ToString("#,##0.00")
                            </td>

                        </tr>
                    </tfoot>
                </table>
            </div>


        </div>
    </div>
}
else
{

}